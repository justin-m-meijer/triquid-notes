            "state": "translated",
            "value": "Partagez une note depuis son panneau de détails pour la voir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे यहाँ देखने के लिए विवरण पैनल से किसी नोट को साझा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha itt szeretne látni egy jegyzetet, ossza meg a részletek panelről."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi una nota dal suo pannello dei dettagli per vederla qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel een notitie vanuit het detailpaneel om hem hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij notatkę z panelu szczegółów, aby zobaczyć ją tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь заметкой из панели сведений, чтобы она появилась здесь."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделете бележка от панела с подробности, за да я видите тук."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del en note fra dens detaljepanel for at se den her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοινοποιήστε μια σημείωση από το πλαίσιο λεπτομερειών της για να εμφανιστεί εδώ."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin nägemiseks jaga märget selle üksikasjade paneelilt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa muistiinpano sen tietopaneelista, niin se näkyy tässä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Comhroinn nóta óna phainéal sonraí chun é a fheiceáil anseo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podijelite bilješku s ploče detalja da biste je vidjeli ovdje."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendrinkite pastabą iš jos informacijos skydelio, kad ji būtų rodoma čia."
