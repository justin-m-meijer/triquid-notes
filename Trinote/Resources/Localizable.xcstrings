    "Copied %lld note(s) to “%@”. Open that instance to see them at the top of the tree.": {
      "comment": "Copy to instance success; count then instance name",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Notiz(en) nach „%@“ kopiert. Öffne diese Instanz, um sie oben im Baum zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Copied %1$lld note(s) to “%2$@”. Open that instance to see them at the top of the tree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld note(s) copiée(s) vers « %@ ». Ouvrez cette instance pour les voir en haut de l’arborescence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld notitie(s) gekopieerd naar ‘%@’. Open die instantie om ze bovenaan de boom te zien."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирани бележки: %lld в „%@“. Отворете тази инстанция, за да ги видите в горната част на дървото."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírované poznámky (%lld) do „%@“. Otevřete danou instanci a uvidíte je na začátku stromu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld note(r) er kopieret til “%@”. Åbn den instans for at se dem øverst i træet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφηκαν %lld σημειώσεις στο «%@». Ανοίξτε αυτό το στιγμιότυπο για να τις δείτε στην κορυφή του δέντρου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han copiado %lld notas en «%@». Abre esa instancia para verlas en la parte superior del árbol."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld märget kopeeriti instantsi „%@“. Ava see instants, et näha neid puu ülaosas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld muistiinpanoa kopioitiin instanssiin ”%@”. Avaa kyseinen instanssi nähdäksesi ne puun yläosassa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cóipeáladh %lld nóta go “%@”. Oscail an cás sin chun iad a fheiceáil ag barr an chrainn."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirano bilješki: %lld u „%@”. Otvorite tu instancu da biste ih vidjeli na vrhu stabla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jegyzet átmásolva ide: „%@”. Nyissa meg azt a példányt, hogy a fa tetején lássa őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld note copiate in “%@”. Apri quell’istanza per vederle in cima all’albero."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukopijuota pastabų (%lld) į „%@“. Atidarykite tą egzempliorių, kad jas matytumėte medžio viršuje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nokopētas piezīmes (%lld) uz „%@”. Atveriet šo instanci, lai tās redzētu koka augšdaļā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nota/noti ġew ikkupjati f’“%@”. Iftaħ dik l-istanza biex tarahom fuq nett tas-siġra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano notatki (%lld) do „%@”. Otwórz tę instancję, aby zobaczyć je na górze drzewa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nota(s) copiada(s) para «%@». Abra essa instância para as ver no topo da árvore."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-au copiat %lld notițe în „%@”. Deschideți acea instanță pentru a le vedea în partea de sus a arborelui."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírované poznámky (%lld) do „%@“. Otvorte danú inštanciu a uvidíte ich na začiatku stromu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirane beležke (%lld) v „%@“. Odprite to instanco, da jih vidite na vrhu drevesa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld anteckning(ar) kopierades till ”%@”. Öppna den instansen för att se dem högst upp i trädet."
          }
        }
      }
    },
