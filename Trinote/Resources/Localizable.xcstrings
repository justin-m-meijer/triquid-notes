    "Inbox is Trilium's inbox note, or today's journal note when there is none.": {
      "comment": "Quick capture destination footer",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingang ist die Eingangsnotiz von Trilium oder die heutige Journalnotiz, falls keine vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boîte de réception correspond à la note de réception de Trilium, ou à la note du journal du jour s’il n’y en a pas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox is de inbox-notitie van Trilium, of de dagboeknotitie van vandaag als die er niet is."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входящи е бележката за входящи в Trilium или днешната бележка в дневника, ако няма такава."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené je poznámka Doručené v Trilium, nebo dnešní deníková poznámka, pokud žádná není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indbakke er Triliums indbakkenote eller dagens dagbogsnote, hvis der ikke er en."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Εισερχόμενα είναι η σημείωση εισερχομένων του Trilium ή η σημερινή σημείωση ημερολογίου, αν δεν υπάρχει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandeja de entrada es la nota de bandeja de entrada de Trilium o, si no existe, la nota del diario de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisendkaust on Triliumi sisendkausta märge või tänane päevikumärge, kui seda pole."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saapuneet on Triliumin saapuneet-muistiinpano tai tämän päivän päiväkirjamerkintä, jos sellaista ei ole."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is é an Bosca Isteach nóta bosca isteach Trilium, nó nóta dialainne an lae inniu mura bhfuil ceann ann."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulazni pretinac je Triliumova bilješka ulaznog pretinca ili današnja bilješka dnevnika ako ona ne postoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beérkezők a Trilium beérkező jegyzete, vagy ha ilyen nincs, a mai naplójegyzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox è la nota inbox di Trilium oppure, se non c’è, la nota del diario di oggi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gautieji – tai Trilium gautųjų pastaba arba šiandienos dienoraščio pastaba, jei jos nėra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iesūtne ir Trilium iesūtnes piezīme vai šodienas dienasgrāmatas piezīme, ja tādas nav."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox hija n-nota tal-inbox ta’ Trilium, jew in-nota tal-ġurnal tal-lum jekk ma jkunx hemm waħda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrzynka odbiorcza to notatka skrzynki odbiorczej Trilium, a jeśli jej nie ma – dzisiejsza notatka dziennika."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Caixa de entrada é a nota de entrada do Trilium ou, se não existir, a nota de diário de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox este notița inbox din Trilium sau notița de jurnal de azi, dacă aceasta lipsește."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené je poznámka Doručené v Trilium alebo dnešná denníková poznámka, ak žiadna nie je."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejeto je Triliumova beležka za prejeto ali, če je ni, današnja dnevniška beležka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkorg är Triliums inkorgsanteckning, eller dagens dagboksanteckning om det inte finns någon."
          }
        }
      }
    },
