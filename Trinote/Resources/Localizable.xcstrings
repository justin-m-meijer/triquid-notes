    "Split Editor Toolbar moves insert tools (image, table, code, and similar) to a bar under the header—the same as the rightmost button on the formatting toolbar.": {
      "comment": "Settings footer: Split Editor Toolbar",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Geteilte Editorleiste“ verschiebt Einfügewerkzeuge (Bild, Tabelle, Code usw.) in eine Leiste unter der Kopfzeile – wie die Taste ganz rechts in der Formatierungsleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Barre d’outils divisée » déplace les outils d’insertion (image, tableau, code, etc.) dans une barre sous l’en-tête, comme le bouton le plus à droite de la barre de mise en forme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Gesplitste editorbalk' verplaatst invoegtools (afbeelding, tabel, code en dergelijke) naar een balk onder de koptekst—hetzelfde als de meest rechtse knop op de opmaakbalk."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Разделена лента на редактора“ премества инструментите за вмъкване (изображение, таблица, код и подобни) в лента под заглавната част – същото като най-десния бутон в лентата за форматиране."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělený panel nástrojů editoru přesune nástroje pro vkládání (obrázek, tabulka, kód a podobně) do lišty pod záhlavím – stejně jako tlačítko úplně vpravo na panelu formátování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt editorværktøjslinje flytter indsætningsværktøjer (billede, tabel, kode og lignende) til en linje under overskriften – det samme som knappen længst til højre på formateringslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Διαχωρισμένη γραμμή εργαλείων» μεταφέρει τα εργαλεία εισαγωγής (εικόνα, πίνακας, κώδικας και παρόμοια) σε μια γραμμή κάτω από την κεφαλίδα — όπως το δεξιότερο κουμπί στη γραμμή μορφοποίησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Barra de herramientas dividida» mueve las herramientas de inserción (imagen, tabla, código y similares) a una barra bajo el encabezado, igual que el botón situado más a la derecha de la barra de formato."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagatud redaktori tööriistariba teisaldab lisamistööriistad (pilt, tabel, kood jms) päise all olevale ribale – sama mis vormindusriba parempoolseim nupp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaettu editorin työkalupalkki siirtää lisäystyökalut (kuva, taulukko, koodi ja vastaavat) otsikon alla olevaan palkkiin – sama kuin muotoilupalkin oikeanpuoleisin painike."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogann “Barra Uirlisí Roinnte an Eagarthóra” uirlisí ionsáite (íomhá, tábla, cód, agus a leithéid) go barra faoin gceanntásc — mar an gcéanna leis an gcnaipe is faide ar dheis ar an mbarra uirlisí formáidithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Podijeljena alatna traka uređivača” premješta alate za umetanje (slika, tablica, kôd i slično) na traku ispod zaglavlja – isto kao krajnja desna tipka na alatnoj traci za formatiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „Osztott szerkesztő-eszközsor” a beszúrási eszközöket (kép, táblázat, kód és hasonlók) a fejléc alatti sávba helyezi – ugyanúgy, mint a formázási eszközsor jobb szélső gombja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Barra strumenti divisa” sposta gli strumenti di inserimento (immagine, tabella, codice e simili) in una barra sotto l’intestazione, come il pulsante più a destra della barra di formattazione."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padalyta redaktoriaus įrankių juosta perkelia įterpimo įrankius (vaizdą, lentelę, kodą ir panašius) į juostą po antrašte – kaip dešiniausias formatavimo įrankių juostos mygtukas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadalīta redaktora rīkjosla pārvieto ievietošanas rīkus (attēls, tabula, kods u. c.) uz joslu zem galvenes — tāpat kā formatēšanas rīkjoslas galējā labā poga."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Toolbar Maqsuma tal-Editur” tmexxi l-għodod tad-dħul (immaġni, tabella, kodiċi, u simili) għal bar taħt l-intestatura — l-istess bħall-buttuna l-aktar fuq il-lemin fit-toolbar tal-formattjar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Podzielony pasek edytora” przenosi narzędzia wstawiania (obraz, tabela, kod itp.) na pasek pod nagłówkiem — tak samo jak skrajny prawy przycisk na pasku formatowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Barra do editor dividida» move as ferramentas de inserção (imagem, tabela, código e semelhantes) para uma barra por baixo do cabeçalho — o mesmo que o botão mais à direita na barra de formatação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bară de instrumente separată” mută instrumentele de inserare (imagine, tabel, cod și altele) într-o bară sub antet — la fel ca butonul din extrema dreaptă a barei de formatare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdelený panel nástrojov editora presunie nástroje na vkladanie (obrázok, tabuľka, kód a podobne) do lišty pod hlavičkou – rovnako ako tlačidlo úplne vpravo na paneli formátovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnost Razdeljena orodna vrstica urejevalnika premakne orodja za vstavljanje (slika, tabela, koda in podobno) v vrstico pod glavo – enako kot skrajno desni gumb v orodni vrstici za oblikovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delat verktygsfält för redigerare flyttar infogningsverktyg (bild, tabell, kod och liknande) till ett fält under rubriken – samma som knappen längst till höger i formateringsfältet."
          }
        }
      }
    },
