    "Starting on this device? You can connect a Trilium server later; your notes come along.": {
      "comment": "Onboarding: local notebook hint",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du startest auf diesem Gerät? Du kannst später einen Trilium-Server verbinden; deine Notizen kommen mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous commencez sur cet appareil ? Vous pourrez connecter un serveur Trilium plus tard ; vos notes suivront."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin je op dit apparaat? Je kunt later een Trilium-server koppelen; je notities gaan mee."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започвате на това устройство? По-късно можете да свържете сървър на Trilium; бележките ви идват с вас."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začínáte na tomto zařízení? Server Trilium můžete připojit později; vaše poznámky se přenesou s vámi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter du på denne enhed? Du kan forbinde en Trilium-server senere; dine noter følger med."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινάτε σε αυτή τη συσκευή; Μπορείτε να συνδέσετε αργότερα διακομιστή Trilium· οι σημειώσεις σας θα μεταφερθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Empiezas en este dispositivo? Puedes conectar un servidor Trilium más adelante; tus notas se vendrán contigo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustad selles seadmes? Saad hiljem Triliumi serveri ühendada; sinu märkmed tulevad kaasa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitatko tällä laitteella? Voit yhdistää Trilium-palvelimen myöhemmin; muistiinpanosi tulevat mukana."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ag tosú ar an ngléas seo? Is féidir leat freastalaí Trilium a cheangal níos déanaí; tiocfaidh do nótaí leat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počinjete na ovom uređaju? Kasnije možete povezati poslužitelj Trilium; vaše bilješke idu s vama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön kezdi? Később csatlakoztathat egy Trilium-szervert, és a jegyzetei is vele mennek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizi su questo dispositivo? Potrai collegare un server Trilium in seguito; le tue note ti seguiranno."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradedate šiame įrenginyje? Vėliau galite prijungti Trilium serverį; jūsų pastabos bus perkeltos kartu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sākat šajā ierīcē? Vēlāk varat pievienot Trilium serveri; jūsu piezīmes tiks pārceltas līdzi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qed tibda fuq dan l-apparat? Tista’ tqabbad server ta’ Trilium aktar tard; in-noti tiegħek jiġu miegħek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczynasz na tym urządzeniu? Serwer Trilium możesz połączyć później — notatki zostaną przeniesione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai começar neste dispositivo? Pode ligar um servidor Trilium mais tarde; as suas notas vêm consigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți pe acest dispozitiv? Puteți conecta mai târziu un server Trilium; notițele vin cu dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začínate v tomto zariadení? Server Trilium môžete pripojiť neskôr; vaše poznámky sa prenesú s vami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začenjate v tej napravi? Strežnik Trilium lahko povežete pozneje; vaše beležke gredo z vami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar du på den här enheten? Du kan ansluta en Trilium-server senare; dina anteckningar följer med."
          }
        }
      }
    },
    "Starting. Loading, please wait.": {
      "comment": "VoiceOver launch",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البدء. يرجى الانتظار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouštění. Načítání, čekejte prosím."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gestartet. Wird geladen, bitte warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting. Loading, please wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciando. Cargando, espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage. Chargement, veuillez patienter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड हो रहा है, कृपया प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítás. Betöltés, kérjük, várjon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio in corso. Caricamento, attendi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met starten. Laden, even geduld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamianie. Wczytywanie, proszę czekać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск. Загрузка, подождите."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стартиране. Зарежда се, моля, изчакайте."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter. Indlæser, vent venligst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκίνηση. Φόρτωση, περιμένετε."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käivitamine. Laadimine, palun oota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistetään. Ladataan, odota hetki."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ag tosú. Ag lódáil, fan go fóill."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokretanje. Učitavanje, pričekajte."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleidžiama. Įkeliama, palaukite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaiž. Ielādē, lūdzu, uzgaidiet."
          }
        },
        "mt": {
          "stringUnit": {
