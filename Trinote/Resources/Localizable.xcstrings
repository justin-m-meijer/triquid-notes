    "Delete “%@”? This cannot be undone.": {
      "comment": "Attachment delete confirm message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ löschen? Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се изтрие ли „%@“? Това действие е необратимо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat „%@“? Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette “%@”? Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή του «%@»; Αυτή η ενέργεια δεν αναιρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%@»? Esta acción no se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas kustutada „%@“? Seda ei saa tagasi võtta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko ”%@”? Tätä ei voi kumota."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrios “%@”? Ní féidir é seo a chealú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati „%@”? Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli: „%@”? Ez a művelet nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare “%@”? L’operazione non può essere annullata."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinti „%@“? Šio veiksmo negalima anuliuoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēst „%@”? Šo darbību nevar atsaukt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tħassar “%@”? Dan ma jistax jitreġġa’ lura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć „%@”? Tej czynności nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar «%@»? Esta ação não pode ser desfeita."
          }
        },
        "ro": {
