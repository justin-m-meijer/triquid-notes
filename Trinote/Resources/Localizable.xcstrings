          "stringUnit": {
            "state": "translated",
            "value": "Siirto epäonnistui tiedonsiirtovirheen vuoksi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Theip ar an aistriú de bharr earráid chumarsáide."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijenos nije uspio zbog pogreške u komunikaciji."
          }
