    "Protected notes cannot be copied to another instance.": {
      "comment": "Cross-instance copy protected",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Notizen können nicht in eine andere Instanz kopiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes protégées ne peuvent pas être copiées vers une autre instance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiligde notities kunnen niet naar een andere instantie worden gekopieerd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитените бележки не могат да бъдат копирани в друга инстанция."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chráněné poznámky nelze kopírovat do jiné instance."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttede noter kan ikke kopieres til en anden instans."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προστατευμένες σημειώσεις δεν μπορούν να αντιγραφούν σε άλλο στιγμιότυπο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas protegidas no se pueden copiar a otra instancia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaitstud märkmeid ei saa teise instantsi kopeerida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattuja muistiinpanoja ei voi kopioida toiseen instanssiin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir nótaí cosanta a chóipeáil chuig cás eile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštićene bilješke ne mogu se kopirati u drugu instancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Védett jegyzetek nem másolhatók másik példányba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note protette non possono essere copiate in un’altra istanza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apsaugotų pastabų negalima kopijuoti į kitą egzempliorių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizsargātās piezīmes nevar kopēt uz citu instanci."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Noti protetti ma jistgħux jiġu kkupjati f’istanza oħra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronionych notatek nie można kopiować do innej instancji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas protegidas não podem ser copiadas para outra instância."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele protejate nu pot fi copiate în altă instanță."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chránené poznámky nie je možné kopírovať do inej inštancie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaščitenih beležk ni mogoče kopirati v drugo instanco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyddade anteckningar kan inte kopieras till en annan instans."
          }
        }
      }
    },
    "Protected notes cannot be shared locally.": {
      "comment": "Local transfer blocked for protected note\nLocal transfer protected",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Notizen können nicht lokal geteilt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes protégées ne peuvent pas être partagées localement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiligde notities kunnen niet lokaal worden gedeeld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитените бележки не могат да бъдат споделяни локално."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chráněné poznámky nelze sdílet lokálně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttede noter kan ikke deles lokalt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προστατευμένες σημειώσεις δεν μπορούν να κοινοποιηθούν τοπικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas protegidas no se pueden compartir localmente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaitstud märkmeid ei saa kohalikult jagada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattuja muistiinpanoja ei voi jakaa paikallisesti."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir nótaí cosanta a chomhroinnt go háitiúil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštićene bilješke ne mogu se dijeliti lokalno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Védett jegyzetek nem oszthatók meg helyben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note protette non possono essere condivise in locale."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apsaugotų pastabų negalima bendrinti vietoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizsargātās piezīmes nevar kopīgot lokāli."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Noti protetti ma jistgħux jinqasmu lokalment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronionych notatek nie można udostępniać lokalnie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas protegidas não podem ser partilhadas localmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele protejate nu pot fi partajate local."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chránené poznámky nie je možné zdieľať lokálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaščitenih beležk ni mogoče deliti lokalno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyddade anteckningar kan inte delas lokalt."
          }
        }
      }
    },
