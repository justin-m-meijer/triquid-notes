    "Server didn’t respond — showing results from this device": {
      "comment": "Offline search banner: server timed out or unreachable",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب الخادم — تُعرض نتائج من هذا الجهاز"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server neodpověděl – zobrazují se výsledky z tohoto zařízení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server hat nicht geantwortet – Ergebnisse von diesem Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server didn’t respond — showing results from this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha respondido: resultados de este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas répondu — résultats de cet appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने जवाब नहीं दिया — इस डिवाइस के परिणाम दिखाए जा रहे हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem válaszolt – az eszközön lévő találatok láthatók"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha risposto: risultati da questo dispositivo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server reageerde niet — resultaten van dit apparaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie odpowiedział — wyniki z tego urządzenia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не ответил — показаны результаты с этого устройства"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сървърът не отговори – показват се резултати от това устройство"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarede ikke – viser resultater fra denne enhed"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν απάντησε — εμφανίζονται αποτελέσματα από αυτή τη συσκευή"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ei vastanud – kuvatakse selle seadme tulemused"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei vastannut – näytetään tämän laitteen tulokset"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor fhreagair an freastalaí — torthaí ón ngléas seo á dtaispeáint"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj nije odgovorio – prikazuju se rezultati s ovog uređaja"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris neatsakė – rodomi šio įrenginio rezultatai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris neatbildēja — tiek rādīti rezultāti no šīs ierīces"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-server ma weġibx — qed jintwerew riżultati minn dan l-apparat"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não respondeu — a mostrar resultados deste dispositivo"
