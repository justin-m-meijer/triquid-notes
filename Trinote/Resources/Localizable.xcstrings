          "stringUnit": {
            "state": "translated",
            "value": "Vælg først, hvor noten skal placeres."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πρώτα πού θα τοποθετηθεί η σημείωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero dónde colocar la nota."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali esmalt, kuhu märge paigutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ensin muistiinpanon sijainti."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh ar dtús cá gcuirfear an nóta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije odaberite gdje smjestiti bilješku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először válassza ki, hová kerüljön a jegyzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima dove mettere la nota."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia pasirinkite, kur dėti pastabą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms izvēlieties, kur novietot piezīmi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ewwel agħżel fejn titqiegħed in-nota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wybierz, gdzie umieścić notatkę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha primeiro onde colocar a nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți mai întâi unde să plasați notița."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv zvoľte, kam poznámku umiestniť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej izberite, kam naj se postavi beležka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj först var anteckningen ska placeras."
          }
        }
      }
    },
    "Choose where to save the note. Use the tree to open folders, then tap a note to select it.": {
      "comment": "Quick capture: parent picker instruction",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo die Notiz gesichert wird. Öffne Ordner im Baum und tippe dann auf eine Notiz, um sie auszuwählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où enregistrer la note. Utilisez l’arborescence pour ouvrir les dossiers, puis touchez une note pour la sélectionner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar je de notitie wilt bewaren. Open mappen in de boom en tik op een notitie om die te kiezen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете къде да запазите бележката. Използвайте дървото, за да отваряте папки, след това докоснете бележка, за да я изберете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, kam poznámku uložit. Pomocí stromu otevřete složky a klepnutím na poznámku ji vyberte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor noten skal gemmes. Brug træet til at åbne mapper, og tryk på en note for at vælge den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πού θα αποθηκευτεί η σημείωση. Ανοίξτε φακέλους στο δέντρο και αγγίξτε μια σημείωση για να την επιλέξετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde guardar la nota. Usa el árbol para abrir carpetas y toca una nota para seleccionarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, kuhu märge salvestada. Ava puu abil kaustu ja puuduta märget, et see valida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mihin muistiinpano tallennetaan. Avaa kansioita puussa ja valitse muistiinpano napauttamalla sitä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh cá sábhálfar an nóta. Úsáid an crann chun fillteáin a oscailt, ansin tapáil nóta chun é a roghnú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite gdje spremiti bilješku. Pomoću stabla otvarajte mape, zatim dodirnite bilješku da biste je odabrali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, hová mentse a jegyzetet. A fában nyissa meg a mappákat, majd koppintson egy jegyzetre a kiválasztásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove salvare la nota. Usa l’albero per aprire le cartelle, poi tocca una nota per selezionarla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite, kur išsaugoti pastabą. Naudodami medį atidarykite aplankus, tada bakstelėkite pastabą, kad ją pasirinktumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties, kur saglabāt piezīmi. Izmantojiet koku, lai atvērtu mapes, un pieskarieties piezīmei, lai to atlasītu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel fejn tiġi salvata n-nota. Uża s-siġra biex tiftaħ il-folders, imbagħad agħfas nota biex tagħżilha."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie zachować notatkę. Otwieraj foldery w drzewie, a następnie stuknij notatkę, aby ją wybrać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde guardar a nota. Use a árvore para abrir pastas e toque numa nota para a selecionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți unde să salvați notița. Deschideți dosarele din arbore, apoi apăsați o notiță pentru a o selecta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte, kam poznámku uložiť. Pomocou stromu otvorte priečinky a klepnutím na poznámku ju vyberte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, kam naj se shrani beležka. Z drevesom odprite mape, nato tapnite beležko, da jo izberete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj var anteckningen ska sparas. Använd trädet för att öppna mappar och tryck på en anteckning för att välja den."
          }
        }
      }
    },
    "Choose which signed-in instance to use. Notes, tabs, and sync belong to that instance.": {
      "comment": "Switch user sheet explanation",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche angemeldete Instanz du verwenden möchtest. Notizen, Tabs und Synchronisierung gehören zu dieser Instanz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’instance connectée à utiliser. Les notes, les onglets et la synchronisation appartiennent à cette instance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke ingelogde instantie je wilt gebruiken. Notities, tabbladen en synchronisatie horen bij die instantie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете коя вписана инстанция да използвате. Бележките, разделите и синхронизацията принадлежат на тази инстанция."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, kterou přihlášenou instanci použít. Poznámky, panely a synchronizace patří k dané instanci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilken instans du er logget ind på, der skal bruges. Noter, faner og synkronisering hører til den instans."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ποιο συνδεδεμένο στιγμιότυπο θα χρησιμοποιηθεί. Οι σημειώσεις, οι καρτέλες και ο συγχρονισμός ανήκουν σε αυτό το στιγμιότυπο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué instancia con sesión iniciada usar. Las notas, las pestañas y la sincronización pertenecen a esa instancia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, millist sisselogitud instantsi kasutada. Märkmed, vahekaardid ja sünkroonimine kuuluvad sellele instantsile."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä kirjautunutta instanssia käytetään. Muistiinpanot, välilehdet ja synkronointi kuuluvat kyseiselle instanssille."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh cén cás sínithe isteach atá le húsáid. Baineann nótaí, cluaisíní agus sioncrónú leis an gcás sin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koju prijavljenu instancu upotrebljavati. Bilješke, kartice i sinkronizacija pripadaju toj instanci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, melyik bejelentkezett példányt használja. A jegyzetek, lapok és a szinkronizálás az adott példányhoz tartoznak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale istanza connessa usare. Note, pannelli e sincronizzazione appartengono a quell’istanza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite, kurį prisijungtą egzempliorių naudoti. Pastabos, kortelės ir sinchronizavimas priklauso tam egzemplioriui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties, kuru pierakstīto instanci izmantot. Piezīmes, cilnes un sinhronizācija pieder šai instancei."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel liema istanza illoggjata tuża. In-noti, it-tabs u s-sinkronizzazzjoni jappartjenu għal dik l-istanza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zalogowaną instancję, której chcesz używać. Notatki, karty i synchronizacja należą do tej instancji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha que instância com sessão iniciada pretende usar. As notas, os separadores e a sincronização pertencem a essa instância."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ce instanță conectată să folosiți. Notițele, filele și sincronizarea aparțin acelei instanțe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte, ktorú prihlásenú inštanciu použiť. Poznámky, panely a synchronizácia patria k danej inštancii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, katero prijavljeno instanco želite uporabljati. Beležke, zavihki in sinhronizacija pripadajo tej instanci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilken inloggad instans som ska användas. Anteckningar, flikar och synkronisering hör till den instansen."
          }
        }
      }
    },
