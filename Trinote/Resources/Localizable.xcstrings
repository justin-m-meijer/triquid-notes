    "Your password is never shared; sign in once on this device.": {
      "comment": "Login: iCloud server list footnote",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort wird nie geteilt; melde dich einmal auf diesem Gerät an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe n’est jamais partagé ; connectez-vous une fois sur cet appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord wordt nooit gedeeld; log één keer in op dit apparaat."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата ви никога не се споделя; влезте веднъж на това устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše heslo se nikdy nesdílí; na tomto zařízení se přihlaste jednou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din adgangskode deles aldrig; log ind én gang på denne enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό σας δεν κοινοποιείται ποτέ· συνδεθείτε μία φορά σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña nunca se comparte; inicia sesión una vez en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu parooli ei jagata kunagi; logi selles seadmes üks kord sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaasi ei koskaan jaeta; kirjaudu tällä laitteella kerran."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní chomhroinntear do phasfhocal riamh; sínigh isteach uair amháin ar an ngléas seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša se lozinka nikad ne dijeli; prijavite se jednom na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszava soha nem kerül megosztásra; ezen az eszközön egyszer kell bejelentkeznie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password non viene mai condivisa; accedi una volta su questo dispositivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų slaptažodis niekada nebendrinamas; prisijunkite vieną kartą šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu parole nekad netiek kopīgota; pierakstieties vienreiz šajā ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-password tiegħek qatt ma tinqasam; idħol darba fuq dan l-apparat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło nigdy nie jest udostępniane; zaloguj się raz na tym urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua palavra-passe nunca é partilhada; inicie sessão uma vez neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola nu este partajată niciodată; autentificați-vă o dată pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše heslo sa nikdy nezdieľa; v tomto zariadení sa prihláste raz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše geslo se nikoli ne deli; v tej napravi se prijavite enkrat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt lösenord delas aldrig; logga in en gång på den här enheten."
          }
        }
      }
    },
    "Your saved servers and their notes stay on this device; nothing is deleted. Switch back from Settings or under Instances.": {
      "comment": "Sign-in: what starting the local notebook does when servers are saved",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Server und ihre Notizen bleiben auf diesem Gerät; nichts wird gelöscht. Wechsle zurück über die Einstellungen oder unter Instanzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos serveurs enregistrés et leurs notes restent sur cet appareil ; rien n’est supprimé. Revenez-y depuis les Réglages ou sous Instances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bewaarde servers en hun notities blijven op dit apparaat; er wordt niets verwijderd. Schakel terug via Instellingen of onder Instanties."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазените ви сървъри и бележките им остават на това устройство; нищо не се изтрива. Можете да се върнете от Настройки или от Инстанции."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené servery a jejich poznámky zůstanou na tomto zařízení; nic se nesmaže. Zpět se přepnete v Nastavení nebo v sekci Instance."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine gemte servere og deres noter forbliver på denne enhed; intet slettes. Skift tilbage fra Indstillinger eller under Instanser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αποθηκευμένοι διακομιστές σας και οι σημειώσεις τους μένουν σε αυτή τη συσκευή· τίποτα δεν διαγράφεται. Επιστρέψτε από τις Ρυθμίσεις ή από τα Στιγμιότυπα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus servidores guardados y sus notas se quedan en este dispositivo; no se elimina nada. Puedes volver desde Ajustes o en Instancias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu salvestatud serverid ja nende märkmed jäävad sellesse seadmesse; midagi ei kustutata. Tagasi saad lülituda Seadetest või jaotisest Instantsid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetut palvelimesi ja niiden muistiinpanot jäävät tähän laitteeseen; mitään ei poisteta. Voit vaihtaa takaisin Asetuksista tai kohdasta Instanssit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanann do fhreastalaithe sábháilte agus a nótaí ar an ngléas seo; ní scriostar aon rud. Athraigh ar ais ó Socruithe nó faoi Chásanna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši spremljeni poslužitelji i njihove bilješke ostaju na ovom uređaju; ništa se ne briše. Natrag se možete prebaciti u Postavkama ili u Instancama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett szerverek és jegyzeteik ezen az eszközön maradnak; semmi sem törlődik. Visszaváltani a Beállításokban vagy a Példányok alatt lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I server salvati e le loro note restano su questo dispositivo; non viene eliminato nulla. Puoi tornare indietro da Impostazioni o in Istanze."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų išsaugoti serveriai ir jų pastabos lieka šiame įrenginyje; niekas neištrinama. Grįžti galite nustatymuose arba skiltyje „Egzemplioriai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu saglabātie serveri un to piezīmes paliek šajā ierīcē; nekas netiek dzēsts. Atgriezieties no iestatījumiem vai sadaļā Instances."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-servers salvati tiegħek u n-noti tagħhom jibqgħu fuq dan l-apparat; xejn ma jitħassar. Erġa’ aqleb mis-Settings jew taħt Istanzi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowane serwery i ich notatki pozostają na tym urządzeniu; nic nie zostanie usunięte. Wrócić możesz w Ustawieniach lub w sekcji Instancje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus servidores guardados e as respetivas notas ficam neste dispositivo; nada é apagado. Pode voltar a partir das Definições ou em Instâncias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverele salvate și notițele lor rămân pe acest dispozitiv; nimic nu este șters. Reveniți din Configurări sau din Instanțe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené servery a ich poznámky zostanú v tomto zariadení; nič sa nevymaže. Späť sa prepnete v Nastaveniach alebo v sekcii Inštancie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeni strežniki in njihove beležke ostanejo v tej napravi; nič se ne izbriše. Nazaj lahko preklopite v Nastavitvah ali v razdelku Instance."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sparade servrar och deras anteckningar stannar på den här enheten; inget raderas. Byt tillbaka från Inställningar eller under Instanser."
          }
        }
      }
    },
    "Your Trilium notes on iPhone and iPad, also offline. Connect to your Trilium server to get started.": {
      "comment": "Login welcome message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Trilium-Notizen auf iPhone und iPad, auch offline. Verbinde dich mit deinem Trilium-Server, um loszulegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes Trilium sur iPhone et iPad, même hors ligne. Connectez-vous à votre serveur Trilium pour commencer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Trilium-notities op iPhone en iPad, ook offline. Maak verbinding met je Trilium-server om te beginnen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките ви от Trilium на iPhone и iPad, и офлайн. Свържете се със сървъра си Trilium, за да започнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poznámky z Trilium na iPhonu a iPadu, i offline. Začněte připojením k serveru Trilium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine Trilium-noter på iPhone og iPad, også offline. Opret forbindelse til din Trilium-server for at komme i gang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σας στο Trilium σε iPhone και iPad, και εκτός σύνδεσης. Συνδεθείτε στον διακομιστή Trilium σας για να ξεκινήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas de Trilium en iPhone y iPad, también sin conexión. Conéctate a tu servidor Trilium para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu Triliumi märkmed iPhone’is ja iPadis, ka võrguühenduseta. Alustamiseks ühenda oma Triliumi serveriga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium-muistiinpanosi iPhonessa ja iPadissa, myös offline-tilassa. Aloita yhdistämällä Trilium-palvelimeesi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Do nótaí Trilium ar iPhone agus iPad, as líne freisin. Ceangail le do fhreastalaí Trilium chun tosú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše bilješke iz Triliuma na iPhoneu i iPadu, i izvan mreže. Povežite se sa svojim poslužiteljem Trilium za početak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium-jegyzetei iPhone-on és iPaden, offline is. A kezdéshez csatlakozzon a Trilium-szerveréhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue note di Trilium su iPhone e iPad, anche offline. Connettiti al tuo server Trilium per iniziare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Trilium pastabos iPhone ir iPad, taip pat neprisijungus. Norėdami pradėti, prisijunkite prie savo Trilium serverio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Trilium piezīmes iPhone un iPad ierīcē, arī bezsaistē. Lai sāktu, izveidojiet savienojumu ar savu Trilium serveri."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti Trilium tiegħek fuq iPhone u iPad, anke offline. Qabbad mas-server Trilium tiegħek biex tibda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki Trilium na iPhonie i iPadzie, także offline. Połącz się z serwerem Trilium, aby zacząć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas notas do Trilium no iPhone e iPad, também offline. Ligue-se ao seu servidor Trilium para começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele Trilium pe iPhone și iPad, și offline. Conectați-vă la serverul Trilium pentru a începe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poznámky z Trilium v iPhone a iPade, aj offline. Začnite pripojením k serveru Trilium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše beležke Trilium v iPhonu in iPadu, tudi brez povezave. Za začetek se povežite s svojim strežnikom Trilium."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina Trilium-anteckningar på iPhone och iPad, även offline. Anslut till din Trilium-server för att komma igång."
          }
        }
      }
    },
    "Your Trilium server has no SSO handoff note yet. In Trilium, create a JS Backend note, add #customRequestHandler=trinote-sso-handoff, paste the handler script, then try again.": {
      "comment": "SSO custom handler missing",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Trilium-Server hat noch keine SSO-Übergabenotiz. Erstelle in Trilium eine JS Backend-Notiz, füge #customRequestHandler=trinote-sso-handoff hinzu, füge das Handler-Skript ein und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur Trilium n’a pas encore de note de transfert SSO. Dans Trilium, créez une note JS Backend, ajoutez #customRequestHandler=trinote-sso-handoff, collez le script du gestionnaire, puis réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Trilium-server heeft nog geen SSO-overdrachtsnotitie. Maak in Trilium een JS Backend-notitie aan, voeg #customRequestHandler=trinote-sso-handoff toe, plak het handlerscript en probeer het opnieuw."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сървърът ви Trilium още няма бележка за SSO предаване. В Trilium създайте JS Backend бележка, добавете #customRequestHandler=trinote-sso-handoff, поставете скрипта на обработчика, след това опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš server Trilium zatím nemá poznámku pro předání SSO. V Trilium vytvořte poznámku JS Backend, přidejte #customRequestHandler=trinote-sso-handoff, vložte skript handleru a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Trilium-server har endnu ingen SSO-overdragelsesnote. Opret en JS Backend-note i Trilium, tilføj #customRequestHandler=trinote-sso-handoff, indsæt handlerscriptet, og prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής Trilium σας δεν έχει ακόμα σημείωση μεταβίβασης SSO. Στο Trilium, δημιουργήστε μια σημείωση JS Backend, προσθέστε #customRequestHandler=trinote-sso-handoff, επικολλήστε το σενάριο χειριστή και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor Trilium aún no tiene una nota de traspaso SSO. En Trilium, crea una nota JS Backend, añade #customRequestHandler=trinote-sso-handoff, pega el script del controlador e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu Triliumi serveris pole veel SSO üleandmise märget. Loo Triliumis JS Backendi märge, lisa #customRequestHandler=trinote-sso-handoff, kleebi töötleja skript ja proovi siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium-palvelimellasi ei ole vielä SSO-luovutusmuistiinpanoa. Luo Triliumissa JS Backend ‑muistiinpano, lisää #customRequestHandler=trinote-sso-handoff, liitä käsittelijäskripti ja yritä sitten uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl nóta aistrithe SSO ar do fhreastalaí Trilium fós. In Trilium, cruthaigh nóta JS Backend, cuir #customRequestHandler=trinote-sso-handoff leis, greamaigh script an láimhseálaí, ansin bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš poslužitelj Trilium još nema bilješku za SSO prijenos. U Triliumu stvorite JS Backend bilješku, dodajte #customRequestHandler=trinote-sso-handoff, zalijepite skriptu rukovatelja, zatim pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Trilium-szerveren még nincs SSO-átadási jegyzet. A Triliumban hozzon létre egy JS Backend-jegyzetet, adja hozzá a #customRequestHandler=trinote-sso-handoff címkét, illessze be a kezelőszkriptet, majd próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server Trilium non ha ancora una nota di passaggio SSO. In Trilium, crea una nota JS Backend, aggiungi #customRequestHandler=trinote-sso-handoff, incolla lo script dell’handler, poi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Trilium serveryje dar nėra SSO perdavimo pastabos. Trilium sukurkite JS Backend pastabą, pridėkite #customRequestHandler=trinote-sso-handoff, įklijuokite doroklės scenarijų ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Trilium serverī vēl nav SSO nodošanas piezīmes. Trilium izveidojiet JS Backend piezīmi, pievienojiet #customRequestHandler=trinote-sso-handoff, ielīmējiet apdarinātāja skriptu un mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-server Trilium tiegħek għad m’għandux nota tal-handoff SSO. Fi Trilium, oħloq nota JS Backend, żid #customRequestHandler=trinote-sso-handoff, waħħal l-iskript tal-handler, imbagħad erġa’ pprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na serwerze Trilium nie ma jeszcze notatki przekazania SSO. W Trilium utwórz notatkę JS Backend, dodaj #customRequestHandler=trinote-sso-handoff, wklej skrypt handlera i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu servidor Trilium ainda não tem uma nota de transferência SSO. No Trilium, crie uma nota JS Backend, adicione #customRequestHandler=trinote-sso-handoff, cole o script do handler e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul Trilium nu are încă o notiță de transfer SSO. În Trilium, creați o notiță JS Backend, adăugați #customRequestHandler=trinote-sso-handoff, lipiți scriptul handlerului, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš server Trilium zatiaľ nemá poznámku na odovzdanie SSO. V Trilium vytvorte poznámku JS Backend, pridajte #customRequestHandler=trinote-sso-handoff, vložte skript handlera a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš strežnik Trilium še nima beležke za predajo SSO. V Triliumu ustvarite beležko JS Backend, dodajte #customRequestHandler=trinote-sso-handoff, prilepite skript za obravnavo in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Trilium-server har ingen SSO-överlämningsanteckning ännu. Skapa en JS Backend-anteckning i Trilium, lägg till #customRequestHandler=trinote-sso-handoff, klistra in hanterarskriptet och försök igen."
          }
        }
      }
    },
    "Reordering needs a connection to your server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herschikken kan alleen met verbinding met je server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réorganisation nécessite une connexion à votre serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umordnen ist eine Verbindung zu deinem Server nötig."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пренареждането изисква връзка със сървъра ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna pořadí vyžaduje připojení k serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af rækkefølgen kræver en forbindelse til din server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναδιάταξη απαιτεί σύνδεση στον διακομιστή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para reordenar se necesita conexión con tu servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ümberjärjestamiseks on vaja ühendust serveriga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestäminen vaatii yhteyden palvelimeen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn ceangal le do fhreastalaí chun athordú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za promjenu redoslijeda potrebna je veza s poslužiteljem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átrendezéshez kapcsolat szükséges a szerverrel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per riordinare serve una connessione al server."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norint pertvarkyti, reikia ryšio su serveriu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Secības maiņai nepieciešams savienojums ar serveri."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biex terġa’ tordna trid konnessjoni mas-server tiegħek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana kolejności wymaga połączenia z serwerem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordenar requer ligação ao servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordonarea necesită o conexiune la server."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena poradia vyžaduje pripojenie k serveru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za razvrščanje potrebujete povezavo s strežnikom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ändra ordningen kräver en anslutning till din server."
          }
        }
      }
    },
