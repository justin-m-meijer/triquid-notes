    "Connecting. Loading, please wait.": {
      "comment": "VoiceOver connecting",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال. يرجى الانتظار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojování. Načítání, čekejte prosím."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden. Wird geladen, bitte warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting. Loading, please wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando. Cargando, espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion. Chargement, veuillez patienter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट हो रहा है, कृपया प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozás. Betöltés, kérjük, várjon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione in corso. Caricamento, attendi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden. Laden, even geduld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie. Wczytywanie, proszę czekać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение. Загрузка, подождите."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свързване. Зарежда се, моля, изчакайте."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter forbindelse. Indlæser, vent venligst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνεται σύνδεση. Φόρτωση, περιμένετε."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendamine. Laadimine, palun oota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään. Ladataan, odota hetki."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ag ceangal. Ag lódáil, fan go fóill."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje. Učitavanje, pričekajte."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jungiamasi. Įkeliama, palaukite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiek savienošana. Ielādē, lūdzu, uzgaidiet."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qed jikkonnettja. Qed jitgħabba, stenna ftit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligar. A carregar, aguarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conectează. Se încarcă, așteptați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripája sa. Načítava sa, čakajte, prosím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezovanje. Nalaganje, počakajte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter. Läser in, vänta."
          }
        }
      }
    },
