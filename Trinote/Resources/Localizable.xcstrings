            "state": "translated",
            "value": "Apăsați Editează pentru a deschide editorul complet Univer Sheets, cu formule, formatare și text îmbogățit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na Upraviť otvoríte plný editor Univer Sheets so vzorcami, formátovaním a formátovaným textom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
