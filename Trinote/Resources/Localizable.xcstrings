          "stringUnit": {
            "state": "translated",
            "value": "Можете да изключите това и по-късно в Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Později to můžete vypnout také v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også slå dette fra senere i Indstillinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε επίσης να το απενεργοποιήσετε αργότερα στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes desactivarlo más adelante en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saad selle hiljem ka Seadetes välja lülitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös poistaa tämän käytöstä myöhemmin Asetuksissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir leat é seo a chasadh as níos déanaí i Socruithe freisin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo možete isključiti i kasnije u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt később a Beállításokban is kikapcsolhatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi disattivarlo anche in seguito in Impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėliau tai galite išjungti nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "To vēlāk var izslēgt arī iestatījumos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ titfi dan aktar tard fis-Settings ukoll."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to też wyłączyć później w Ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode desativar isto mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți dezactiva și mai târziu din Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neskôr to môžete vypnúť aj v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lahko pozneje izklopite tudi v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan även stänga av detta senare i Inställningar."
          }
        }
      }
    },
    "You can sign in to at most %lld instances. Sign out from one to add another.": {
      "comment": "Settings footer when instance limit reached; %lld is max count",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich bei höchstens %lld Instanzen anmelden. Melde dich bei einer ab, um eine weitere hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous connecter à %lld instances au maximum. Déconnectez-vous de l’une d’elles pour en ajouter une autre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt op maximaal %lld instanties inloggen. Log bij een ervan uit om een andere toe te voegen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да влезете в най-много %lld инстанции. Излезте от една, за да добавите друга."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlásit se můžete nejvýše k %lld instancím. Chcete-li přidat další, z jedné se odhlaste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan højst være logget ind på %lld instanser. Log ud af en for at tilføje en anden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνδεθείτε σε έως %lld στιγμιότυπα. Αποσυνδεθείτε από ένα για να προσθέσετε άλλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes iniciar sesión en %lld instancias como máximo. Cierra la sesión en una para añadir otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saad sisse logida kuni %lld instantsi. Uue lisamiseks logi ühest välja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kirjautua enintään %lld instanssiin. Kirjaudu ulos yhdestä lisätäksesi toisen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir leat síniú isteach i %lld cás ar a mhéad. Sínigh amach as ceann acu chun ceann eile a chur leis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete se prijaviti na najviše %lld instanci. Odjavite se s jedne da biste dodali drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %lld példányba jelentkezhet be. Egy újabb hozzáadásához jelentkezzen ki az egyikből."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi accedere al massimo a %lld istanze. Esci da una per aggiungerne un’altra."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Galite prisijungti daugiausia prie %lld egzempliorių. Norėdami pridėti kitą, atsijunkite nuo vieno."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varat pierakstīties ne vairāk kā %lld instancēs. Lai pievienotu citu, izrakstieties no kādas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ tidħol f’massimu ta’ %lld istanzi. Oħroġ minn waħda biex iżżid oħra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zalogować się maksymalnie do tylu instancji: %lld. Wyloguj się z jednej, aby dodać kolejną."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode iniciar sessão em %lld instâncias, no máximo. Termine sessão numa para adicionar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă puteți autentifica în cel mult %lld instanțe. Deconectați una pentru a adăuga alta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásiť sa môžete najviac do %lld inštancií. Ak chcete pridať ďalšiu, z jednej sa odhláste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se lahko v največ %lld instanc. Za dodajanje nove se odjavite iz ene od obstoječih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan vara inloggad på högst %lld instanser. Logga ut från en för att lägga till en annan."
          }
        }
      }
    },
