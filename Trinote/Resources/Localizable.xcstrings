    "Nearby Triquid Notes users can send you a note. Turn this off from ⋯ when you are done.": {
      "comment": "Tree banner local receive help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triquid Notes-Benutzer:innen in der Nähe können dir eine Notiz senden. Schalte dies über ⋯ aus, wenn du fertig bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs de Triquid Notes à proximité peuvent vous envoyer une note. Désactivez cette option depuis ⋯ une fois terminé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Triquid Notes-gebruikers in de buurt kunnen je een notitie sturen. Zet dit uit via ⋯ als je klaar bent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребители на Triquid Notes наблизо могат да ви изпратят бележка. Изключете това от ⋯, когато приключите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatelé Triquid Notes v okolí vám mohou poslat poznámku. Až skončíte, vypněte to v nabídce ⋯."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Triquid Notes-brugere i nærheden kan sende dig en note. Slå dette fra via ⋯, når du er færdig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοντινοί χρήστες του Triquid Notes μπορούν να σας στείλουν μια σημείωση. Απενεργοποιήστε το από το ⋯ όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios de Triquid Notes cercanos pueden enviarte una nota. Desactívalo desde ⋯ cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähedal olevad Triquid Notesi kasutajad saavad sulle märkme saata. Kui oled lõpetanud, lülita see menüüst ⋯ välja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähellä olevat Triquid Notes ‑käyttäjät voivat lähettää sinulle muistiinpanon. Laita tämä pois päältä ⋯-valikosta, kun olet valmis."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir le húsáideoirí Triquid Notes in aice láimhe nóta a sheoladh chugat. Cas é seo as ó ⋯ nuair a bheidh tú críochnaithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korisnici aplikacije Triquid Notes u blizini mogu vam poslati bilješku. Isključite ovo putem ⋯ kad završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közelben lévő Triquid Notes-felhasználók küldhetnek Önnek jegyzetet. Ha végzett, kapcsolja ki a ⋯ menüben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti di Triquid Notes nelle vicinanze possono inviarti una nota. Disattiva questa opzione da ⋯ quando hai finito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Netoliese esantys Triquid Notes naudotojai gali jums atsiųsti pastabą. Baigę išjunkite tai meniu ⋯."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvumā esošie Triquid Notes lietotāji var jums nosūtīt piezīmi. Kad esat pabeidzis, izslēdziet to izvēlnē ⋯."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenti ta’ Triquid Notes fil-qrib jistgħu jibagħtulek nota. Itfi dan minn ⋯ meta tlesti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownicy Triquid Notes w pobliżu mogą wysłać Ci notatkę. Wyłącz to w menu ⋯, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os utilizadores da Triquid Notes próximos podem enviar-lhe uma nota. Desative esta opção em ⋯ quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizatorii Triquid Notes din apropiere vă pot trimite o notiță. Dezactivați opțiunea din ⋯ când ați terminat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používatelia Triquid Notes v okolí vám môžu poslať poznámku. Keď skončíte, vypnite to v ponuke ⋯."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bližnji uporabniki aplikacije Triquid Notes vam lahko pošljejo beležko. Ko končate, to izklopite v meniju ⋯."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Triquid Notes-användare i närheten kan skicka en anteckning till dig. Stäng av detta via ⋯ när du är klar."
          }
        }
      }
    },
