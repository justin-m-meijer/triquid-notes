    "Long-Press to Edit hides the floating edit button. Press and hold the note for 1.5 seconds to start editing.": {
      "comment": "Settings footer: Long-Press to Edit",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zum Bearbeiten lange drücken“ blendet die schwebende Bearbeiten-Taste aus. Halte die Notiz 1,5 Sekunden lang gedrückt, um mit dem Bearbeiten zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Toucher longuement pour modifier » masque le bouton de modification flottant. Maintenez le doigt sur la note pendant 1,5 seconde pour commencer à la modifier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt om te wijzigen verbergt de zwevende wijzigknop. Houd de notitie 1,5 seconde ingedrukt om te beginnen met wijzigen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Задържане за редактиране“ скрива плаващия бутон за редактиране. Задръжте бележката за 1,5 секунди, за да започнете да редактирате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úpravy podržením skryjí plovoucí tlačítko úprav. Úpravy zahájíte podržením prstu na poznámce po dobu 1,5 sekundy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede for at redigere skjuler den flydende redigeringsknap. Hold fingeren på noten i 1,5 sekund for at begynde at redigere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Παρατεταμένο πάτημα για επεξεργασία» αποκρύπτει το αιωρούμενο κουμπί επεξεργασίας. Πατήστε παρατεταμένα τη σημείωση για 1,5 δευτερόλεπτο για να ξεκινήσετε την επεξεργασία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mantener pulsado para editar» oculta el botón flotante de edición. Mantén pulsada la nota 1,5 segundos para empezar a editarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikk vajutus muutmiseks peidab hõljuva muutmisnupu. Muutmise alustamiseks vajuta märkmele ja hoia 1,5 sekundit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa pitkällä painalluksella piilottaa kelluvan muokkauspainikkeen. Aloita muokkaus painamalla muistiinpanoa 1,5 sekunnin ajan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Folaíonn “Brú Fada chun Eagarthóireacht” an cnaipe eagarthóireachta snámhach. Coinnigh do mhéar ar an nóta ar feadh 1.5 soicind chun tosú ag eagarthóireacht."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dugi pritisak za uređivanje” skriva plutajuću tipku za uređivanje. Pritisnite i držite bilješku 1,5 sekundi da biste počeli uređivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Szerkesztés hosszú nyomással” elrejti a lebegő szerkesztés gombot. A szerkesztés megkezdéséhez tartsa lenyomva a jegyzetet 1,5 másodpercig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tieni premuto per modificare” nasconde il pulsante Modifica mobile. Tieni premuta la nota per 1,5 secondi per iniziare a modificarla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus šią parinktį, slankusis redagavimo mygtukas paslepiamas. Norėdami pradėti redaguoti, palaikykite paspaudę pastabą 1,5 sekundės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja ieslēgta ilga nospiešana rediģēšanai, peldošā rediģēšanas poga tiek paslēpta. Lai sāktu rediģēt, turiet nospiestu piezīmi 1,5 sekundes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Agħfas fit-Tul biex Teditja” taħbi l-buttuna tal-editjar f’wiċċ l-iskrin. Agħfas u żomm fuq in-nota għal 1.5 sekondi biex tibda teditja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Przytrzymaj, aby edytować” ukrywa pływający przycisk edycji. Przytrzymaj notatkę przez 1,5 sekundy, aby rozpocząć edycję."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Manter premido para editar» oculta o botão flutuante de edição. Mantenha a nota premida durante 1,5 segundos para começar a editar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Apăsare lungă pentru editare” ascunde butonul flotant de editare. Țineți apăsat pe notiță 1,5 secunde pentru a începe editarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úpravy podržaním skryjú plávajúce tlačidlo úprav. Úpravy začnete podržaním prsta na poznámke 1,5 sekundy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnost Pridržite za urejanje skrije plavajoči gumb za urejanje. Za začetek urejanja pridržite beležko 1,5 sekunde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned för att redigera gömmer den flytande redigeringsknappen. Håll ned på anteckningen i 1,5 sekunder för att börja redigera."
          }
        }
      }
    },
