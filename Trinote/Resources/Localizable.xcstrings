    "Deleted notes go to Trash and can be restored in Trilium.": {
      "comment": "Note delete confirmation when permanent erase is off",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Notizen landen im Papierkorb und können in Trilium wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes supprimées vont dans la corbeille et peuvent être restaurées dans Trilium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde notities gaan naar de prullenmand en kunnen in Trilium worden hersteld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтритите бележки отиват в Кошчето и могат да бъдат възстановени в Trilium."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazané poznámky se přesunou do koše a lze je obnovit v Trilium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede noter flyttes til papirkurven og kan gendannes i Trilium."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαγραμμένες σημειώσεις μεταφέρονται στον Κάδο και μπορούν να ανακτηθούν στο Trilium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas eliminadas van a la papelera y se pueden recuperar en Trilium."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatud märkmed liiguvad prügikasti ja neid saab Triliumis taastada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetut muistiinpanot siirtyvät roskakoriin, ja ne voi palauttaa Triliumissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Téann nótaí scriosta go dtí an Bruscar agus is féidir iad a athchóiriú in Trilium."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisane bilješke premještaju se u Smeće i mogu se vratiti u Triliumu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölt jegyzetek a Kukába kerülnek, és a Triliumban visszaállíthatók."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note eliminate finiscono nel Cestino e possono essere ripristinate in Trilium."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrintos pastabos perkeliamos į šiukšlinę, jas galima atkurti Trilium."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēstās piezīmes tiek pārvietotas uz Atkritnēm, un tās var atjaunot Trilium."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti mħassra jmorru fl-Iskart u jistgħu jiġu rrestawrati fi Trilium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte notatki trafiają do kosza i można je przywrócić w Trilium."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas apagadas vão para o Lixo e podem ser recuperadas no Trilium."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele șterse ajung în Coș și pot fi restaurate în Trilium."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazané poznámky sa presunú do koša a dajú sa obnoviť v Trilium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisane beležke se premaknejo v Smeti in jih je mogoče obnoviti v Triliumu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderade anteckningar flyttas till papperskorgen och kan återställas i Trilium."
          }
        }
      }
    },
