        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeánann sé Achoimrigh, Aimsigh Tascanna agus Mol Teideal"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje Sažmi, Pronađi zadatke i Predloži naslov"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti az Összefoglalás, a Teendők keresése és a Cím javasolása lehetőséget"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Riassumi, Trova cose da fare e Suggerisci titolo"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodo „Apibendrinti“, „Rasti užduotis“ ir „Siūlyti pavadinimą“"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rāda Apkopot, Atrast uzdevumus un Ieteikt virsrakstu"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Turi Agħmel sommarju, Sib Affarijiet x’Tagħmel u Issuġġerixxi Titlu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje Podsumuj, Znajdź zadania i Zaproponuj tytuł"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Resumir, Encontrar tarefas e Sugerir título"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează Rezumă, Găsește sarcini și Sugerează titlu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí Zhrnúť, Nájsť úlohy a Navrhnúť názov"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže Povzemi, Poišči opravila in Predlagaj naslov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar Sammanfatta, Hitta uppgifter och Föreslå titel"
          }
        }
      }
    },
    "Quick notes and things you share to the app collect in an inbox. Create one, or label a note #inbox in Trilium.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجمع الملاحظات السريعة وما تشاركه مع التطبيق في صندوق الوارد. أنشئ واحدًا، أو ضع الوسم #inbox على ملاحظة في Trilium."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бързите бележки и нещата, които споделяте с приложението, се събират във Входящи. Създайте ги или добавете етикет #inbox на бележка в Trilium."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlé poznámky a věci sdílené do aplikace se shromažďují v Doručených. Vytvořte je nebo označte poznámku štítkem #inbox v Trilium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtige noter og ting, du deler med appen, samles i en indbakke. Opret en, eller giv en note etiketten #inbox i Trilium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellnotizen und Inhalte, die du mit der App teilst, sammeln sich in einem Eingang. Erstelle einen oder versieh eine Notiz in Trilium mit dem Label #inbox."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γρήγορες σημειώσεις και ό,τι κοινοποιείτε στην εφαρμογή συγκεντρώνονται στα Εισερχόμενα. Δημιουργήστε τα ή βάλτε σε μια σημείωση την ετικέτα #inbox στο Trilium."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick notes and things you share to the app collect in an inbox. Create one, or label a note #inbox in Trilium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas rápidas y lo que compartes con la app se reúnen en una bandeja de entrada. Crea una o etiqueta una nota como #inbox en Trilium."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirmärkmed ja rakendusse jagatud asjad koonduvad sisendkausta. Loo see või märgi märge Triliumis sildiga #inbox."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikamuistiinpanot ja sovellukseen jakamasi asiat kerätään saapuneisiin. Luo ne tai merkitse muistiinpano tunnisteella #inbox Triliumissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes rapides et les éléments que vous partagez avec l’app sont rassemblés dans une boîte de réception. Créez-en une, ou étiquetez une note #inbox dans Trilium."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bailítear nótaí tapa agus rudaí a roinneann tú leis an aip sa Bhosca Isteach. Cruthaigh ceann, nó clib #inbox a chur ar nóta i Trilium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित नोट और ऐप के साथ साझा की गई चीज़ें इनबॉक्स में जमा होती हैं। एक बनाएँ, या Trilium में किसी नोट को #inbox लेबल दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brze bilješke i stvari koje dijeliš s aplikacijom skupljaju se u ulaznom pretincu. Stvori ga ili označi bilješku oznakom #inbox u Trilium."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyorsjegyzetek és az appnak megosztott dolgok a Beérkezőkben gyűlnek. Hozd létre, vagy címkézz meg egy jegyzetet #inbox címkével a Triliumban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note rapide e ciò che condividi con l’app si raccolgono in Inbox. Creala, oppure etichetta una nota #inbox in Trilium."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Greitieji užrašai ir tai, kuo dalijatės su programa, kaupiami gautuosiuose. Sukurkite juos arba pažymėkite užrašą žyma #inbox programoje Trilium."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ātrās piezīmes un tas, ko kopīgojat lietotnei, tiek krātas iesūtnē. Izveidojiet to vai piešķiriet piezīmei etiķeti #inbox programmā Trilium."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti malajr u dak li taqsam mal-app jinġabru fl-Inbox. Oħloq waħda, jew tikkettja nota #inbox f’Trilium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle notities en dingen die je met de app deelt, komen in een inbox terecht. Maak er een aan, of geef een notitie in Trilium het label #inbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie notatki i rzeczy udostępnione aplikacji trafiają do skrzynki odbiorczej. Utwórz ją albo oznacz notatkę etykietą #inbox w Trilium."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas rápidas e o que partilha com a app ficam reunidas numa caixa de entrada. Crie uma ou etiquete uma nota com #inbox no Trilium."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notele rapide și lucrurile pe care le trimiți aplicației se adună în Inbox. Creează-l sau etichetează o notă cu #inbox în Trilium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые заметки и то, чем вы делитесь с приложением, собираются во входящих. Создайте их или добавьте заметке метку #inbox в Trilium."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchle poznámky a veci zdieľané do aplikácie sa zhromažďujú v Doručených. Vytvorte ich alebo označte poznámku štítkom #inbox v Trilium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitre beležke in stvari, ki jih deliš z aplikacijo, se zbirajo v mapi Prejeto. Ustvari jo ali označi beležko z oznako #inbox v Trilium."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbanteckningar och sådant du delar till appen samlas i en inkorg. Skapa en, eller etikettera en anteckning #inbox i Trilium."
          }
        }
      }
    },
    "Couldn't Create the Inbox": {
      "localizations": {
        "ar": {
