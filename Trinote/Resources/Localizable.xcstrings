    "Remove %lld note(s) from Favorites? They will not be deleted from the server.": {
      "comment": "Favorites bulk remove",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %lld ملاحظة من المفضلة؟ لن تُحذف من الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit poznámky (%lld) z oblíbených? Ze serveru nebudou smazány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Notiz(en) aus Favoriten entfernen? Sie werden nicht vom Server gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %lld note(s) from Favorites? They will not be deleted from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %lld notas de favoritos? No se eliminarán del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %lld note(s) des favoris ? Elles ne seront pas supprimées du serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld नोट पसंदीदा से हटाएँ? सर्वर से नहीं हटेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolít %lld jegyzetet a kedvencek közül? A szerverről nem törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %lld note dai preferiti? Non verranno eliminate dal server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld notitie(s) uit Favorieten verwijderen? Ze worden niet van de server verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć notatki (%lld) z ulubionych? Nie zostaną usunięte z serwera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать %lld заметок из избранного? На сервере они не удаляются."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се премахнат ли %lld бележки от Любими? Те няма да бъдат изтрити от сървъра."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne %lld note(r) fra Favoritter? De slettes ikke fra serveren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση %lld σημειώσεων από τα Αγαπημένα; Δεν θα διαγραφούν από τον διακομιστή."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas eemaldada %lld märget lemmikutest? Neid ei kustutata serverist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %lld muistiinpanoa suosikeista? Niitä ei poisteta palvelimelta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bain %lld nóta ó na Ceanáin? Ní scriosfar iad ón bhfreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti bilješke (%lld) iz Omiljenog? Neće se obrisati s poslužitelja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašalinti pastabas (%lld) iš mėgstamiausių? Jos nebus ištrintos iš serverio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noņemt piezīmes (%lld) no izlases? Tās netiks dzēstas no servera."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tneħħi %lld nota/noti mill-Favoriti? Mhux se jitħassru mis-server."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %lld nota(s) dos Favoritos? Não serão apagadas do servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați %lld notițe din Favorite? Nu vor fi șterse de pe server."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť poznámky (%lld) z obľúbených? Zo servera sa nevymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
