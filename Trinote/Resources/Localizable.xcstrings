            "value": "Počet karet zčervená, když sloupec obsahuje více karet, než je jeho limit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartenanzahl wird rot, wenn die Spalte mehr Karten enthält als ihr Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card count turns red when the column holds more cards than its limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de tarjetas se vuelve rojo cuando la columna tiene más tarjetas que su límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de cartes devient rouge lorsque la colonne contient plus de cartes que sa limite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कॉलम में सीमा से अधिक कार्ड हों, तो कार्ड की गिनती लाल हो जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyák száma pirosra vált, ha az oszlopban több kártya van, mint a korlát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di schede diventa rosso quando la colonna contiene più schede del limite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aantal kaarten wordt rood als de kolom meer kaarten bevat dan de limiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba kart zmienia kolor na czerwony, gdy kolumna zawiera więcej kart niż wynosi limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчик карточек становится красным, когда в столбце больше карточек, чем позволяет лимит."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Броят карти става червен, когато колоната съдържа повече карти от лимита си."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af kort bliver rødt, når kolonnen indeholder flere kort end grænsen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός καρτών γίνεται κόκκινος όταν η στήλη περιέχει περισσότερες κάρτες από το όριό της."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaartide arv muutub punaseks, kui veerus on rohkem kaarte kui piirang lubab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korttien määrä muuttuu punaiseksi, kun sarakkeessa on enemmän kortteja kuin sen raja sallii."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Éiríonn líon na gcártaí dearg nuair a bhíonn níos mó cártaí sa cholún ná a theorainn."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kartica postaje crven kad stupac sadrži više kartica od svog ograničenja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortelių skaičius tampa raudonas, kai stulpelyje yra daugiau kortelių nei leidžia riba."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāršu skaits kļūst sarkans, kad kolonnā ir vairāk kāršu, nekā atļauj ierobežojums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-għadd tal-kards isir aħmar meta l-kolonna jkollha aktar kards mil-limitu tagħha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número de cartões fica vermelho quando a coluna tem mais cartões do que o limite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de carduri devine roșu când coloana conține mai multe carduri decât limita."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet kariet sčervenie, keď stĺpec obsahuje viac kariet, ako je jeho limit."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število kartic se obarva rdeče, ko je v stolpcu več kartic, kot dovoljuje omejitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
