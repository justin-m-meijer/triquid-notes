    "Only empty columns can be deleted.": {
      "comment": "Kanban delete column message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur leere Spalten können gelöscht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les colonnes vides peuvent être supprimées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen lege kolommen kunnen worden verwijderd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само празни колони могат да бъдат изтрити."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat lze pouze prázdné sloupce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tomme kolonner kan slettes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο κενές στήλες μπορούν να διαγραφούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden eliminar las columnas vacías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutada saab ainult tühje veerge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tyhjiä sarakkeita voi poistaa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir ach colúin fholmha a scriosadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu se obrisati samo prazni stupci."
          }
        },
        "hu": {
