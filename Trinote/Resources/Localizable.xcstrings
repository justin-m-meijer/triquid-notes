    "Ask the other person to open Notes, tap ⋯, and turn on “Receive note locally”. Their device will appear below when ready.": {
      "comment": "Share locally instructions",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte die andere Person, Notizen zu öffnen, auf ⋯ zu tippen und „Notiz lokal empfangen“ zu aktivieren. Ihr Gerät erscheint unten, sobald es bereit ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l’autre personne d’ouvrir Notes, de toucher ⋯ et d’activer « Recevoir la note localement ». Son appareil apparaîtra ci-dessous lorsqu’il sera prêt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag de ander om Notities te openen, op ⋯ te tikken en “Ontvang notitie lokaal” aan te zetten. Hun apparaat verschijnt hieronder zodra het klaar is."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Помолете другия човек да отвори Бележки, да докосне ⋯ и да включи „Получаване на бележка локално“. Устройството му ще се появи по-долу, когато е готово."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádejte druhou osobu, aby otevřela Poznámky, klepla na ⋯ a zapnula „Přijímat poznámky lokálně“. Její zařízení se zobrazí níže, až bude připraveno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed den anden person om at åbne Noter, trykke på ⋯ og slå “Modtag note lokalt” til. Vedkommendes enhed vises nedenfor, når den er klar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητήστε από το άλλο άτομο να ανοίξει τις Σημειώσεις, να αγγίξει το ⋯ και να ενεργοποιήσει τη «Λήψη σημείωσης τοπικά». Η συσκευή του θα εμφανιστεί παρακάτω όταν είναι έτοιμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a la otra persona que abra Notas, toque ⋯ y active «Recibir nota localmente». Su dispositivo aparecerá abajo cuando esté listo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Palu teisel inimesel avada Märkmed, puudutada ⋯ ja lülitada sisse „Võta märge vastu kohalikult“. Tema seade ilmub allpool, kui see on valmis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä toista henkilöä avaamaan muistiinpanot, napauttamaan ⋯ ja laittamaan päälle ”Vastaanota muistiinpano paikallisesti”. Hänen laitteensa näkyy alla, kun se on valmis."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Iarr ar an duine eile Notes a oscailt, ⋯ a thapáil, agus “Faigh nóta go háitiúil” a chasadh air. Taispeánfar a ngléas thíos nuair a bheidh sé réidh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamolite drugu osobu da otvori Bilješke, dodirne ⋯ i uključi „Primi bilješku lokalno”. Njezin će se uređaj pojaviti ispod kad bude spreman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérje meg a másik felet, hogy nyissa meg a Jegyzeteket, koppintson a ⋯ gombra, és kapcsolja be a „Jegyzet fogadása helyben” lehetőséget. Az eszköze lent jelenik meg, amikor készen áll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi all’altra persona di aprire Note, toccare ⋯ e attivare “Ricevi nota in locale”. Il suo dispositivo apparirà qui sotto quando sarà pronto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paprašykite kito asmens atidaryti Pastabas, bakstelėti ⋯ ir įjungti „Gauti pastabą vietoje“. Kai bus pasiruošta, jo įrenginys pasirodys žemiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Palūdziet otrai personai atvērt Piezīmes, pieskarties ⋯ un ieslēgt „Saņemt piezīmi lokāli”. Kad tā būs gatava, viņa ierīce parādīsies zemāk."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Itlob lill-persuna l-oħra tiftaħ Notes, tagħfas ⋯, u tixgħel “Irċievi nota lokalment”. L-apparat tagħha jidher hawn taħt meta jkun lest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś drugą osobę, aby otworzyła Notatki, stuknęła ⋯ i włączyła „Odbieraj notatkę lokalnie”. Jej urządzenie pojawi się poniżej, gdy będzie gotowe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça à outra pessoa para abrir as Notas, tocar em ⋯ e ativar «Receber nota localmente». O dispositivo dela aparecerá abaixo quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rugați cealaltă persoană să deschidă Notițe, să apese ⋯ și să activeze „Primește notița local”. Dispozitivul său va apărea mai jos când este gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadajte druhú osobu, aby otvorila Poznámky, klepla na ⋯ a zapla „Prijímať poznámky lokálne“. Jej zariadenie sa zobrazí nižšie, keď bude pripravené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosite drugo osebo, naj odpre Beležke, tapne ⋯ in vklopi „Prejmi beležko lokalno“. Ko bo njena naprava pripravljena, se bo prikazala spodaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be den andra personen att öppna Anteckningar, trycka på ⋯ och slå på ”Ta emot anteckning lokalt”. Deras enhet visas nedan när den är redo."
          }
        }
      }
    },
    "Attaching a file needs a connection.": {
      "comment": "Quick capture: shared file while offline",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anhängen einer Datei ist eine Verbindung erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joindre un fichier nécessite une connexion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bijvoegen van een bestand is een verbinding nodig."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За прикачване на файл е нужна връзка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení souboru vyžaduje připojení k síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kræver en forbindelse at vedhæfte en fil."
