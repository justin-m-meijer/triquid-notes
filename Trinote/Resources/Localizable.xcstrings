    "The copy will appear at the top of the destination instance’s note tree. You will stay on this instance.": {
      "comment": "Copy to instance explanation",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie erscheint oben im Notizbaum der Zielinstanz. Du bleibst auf dieser Instanz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie apparaîtra en haut de l’arborescence des notes de l’instance de destination. Vous resterez sur cette instance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie verschijnt bovenaan de notitieboom van de doelinstantie. Je blijft op deze instantie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Копието ще се появи в горната част на дървото с бележки на целевата инстанция. Вие оставате в тази инстанция."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie se zobrazí na začátku stromu poznámek cílové instance. Zůstanete v této instanci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien vises øverst i destinationsinstansens notetræ. Du forbliver på denne instans."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αντίγραφο θα εμφανιστεί στην κορυφή του δέντρου σημειώσεων του στιγμιότυπου προορισμού. Θα παραμείνετε σε αυτό το στιγμιότυπο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia aparecerá en la parte superior del árbol de notas de la instancia de destino. Seguirás en esta instancia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koopia kuvatakse sihtinstantsi märkmepuu ülaosas. Sina jääd sellesse instantsi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopio näkyy kohdeinstanssin muistiinpanopuun yläosassa. Pysyt tässä instanssissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeánfar an chóip ag barr chrann nótaí an cháis cinn scríbe. Fanfaidh tú ar an gcás seo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopija će se pojaviti na vrhu stabla bilješki odredišne instance. Ostat ćete na ovoj instanci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolat a célpéldány jegyzetfájának tetején jelenik meg. Ön ezen a példányon marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia apparirà in cima all’albero delle note dell’istanza di destinazione. Resterai su questa istanza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopija atsiras paskirties egzemplioriaus pastabų medžio viršuje. Liksite šiame egzemplioriuje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopija parādīsies mērķa instances piezīmju koka augšdaļā. Jūs paliksiet šajā instancē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kopja tidher fuq nett tas-siġra tan-noti tal-istanza tad-destinazzjoni. Int tibqa’ fuq din l-istanza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia pojawi się na górze drzewa notatek docelowej instancji. Pozostaniesz w tej instancji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia aparecerá no topo da árvore de notas da instância de destino. Vai continuar nesta instância."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia va apărea în partea de sus a arborelui de notițe al instanței de destinație. Veți rămâne în această instanță."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kópia sa zobrazí na začiatku stromu poznámok cieľovej inštancie. Zostanete v tejto inštancii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopija se bo prikazala na vrhu drevesa beležk ciljne instance. Ostali boste v tej instanci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopian visas högst upp i målinstansens anteckningsträd. Du stannar kvar på den här instansen."
          }
        }
      }
    },
    "The following notes and their subnotes will be deleted.": {
      "comment": "Tree bulk delete sheet header when erase is off",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Notizen und ihre Unternotizen werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes suivantes et leurs sous-notes seront supprimées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende notities en hun subnotities worden verwijderd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следните бележки и техните подбележки ще бъдат изтрити."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Následující poznámky a jejich podřízené poznámky budou smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følgende noter og deres undernoter slettes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παρακάτω σημειώσεις και οι υποσημειώσεις τους θα διαγραφούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán las siguientes notas y sus subnotas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järgmised märkmed ja nende alammärkmed kustutatakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavat muistiinpanot ja niiden alamuistiinpanot poistetaan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scriosfar na nótaí seo a leanas agus a bhfo-nótaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sljedeće bilješke i njihove podbilješke bit će obrisane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő jegyzetek és aljegyzeteik törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le seguenti note e le loro sottonote verranno eliminate."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toliau nurodytos pastabos ir jų antrinės pastabos bus ištrintos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tālāk norādītās piezīmes un to apakšpiezīmes tiks dzēstas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti li ġejjin u s-sottonoti tagħhom se jitħassru."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następujące notatki wraz z notatkami podrzędnymi zostaną usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas seguintes e as respetivas subnotas serão apagadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următoarele notițe și subnotițele lor vor fi șterse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasledujúce poznámky a ich podradené poznámky sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslednje beležke in njihove podbeležke bodo izbrisane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följande anteckningar och deras underanteckningar raderas."
          }
        }
      }
    },
    "The following notes and their subnotes will be permanently erased. This cannot be undone.": {
      "comment": "Tree bulk delete sheet header when erase is on",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Notizen und ihre Unternotizen werden endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes suivantes et leurs sous-notes seront définitivement effacées. Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende notities en hun subnotities worden definitief gewist. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следните бележки и техните подбележки ще бъдат изтрити окончателно. Това действие е необратимо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Následující poznámky a jejich podřízené poznámky budou trvale vymazány. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følgende noter og deres undernoter slettes permanent. Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παρακάτω σημειώσεις και οι υποσημειώσεις τους θα διαγραφούν οριστικά. Αυτή η ενέργεια δεν αναιρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las siguientes notas y sus subnotas se borrarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järgmised märkmed ja nende alammärkmed kustutatakse jäädavalt. Seda ei saa tagasi võtta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavat muistiinpanot ja niiden alamuistiinpanot poistetaan pysyvästi. Tätä ei voi kumota."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léirscriosfar go buan na nótaí seo a leanas agus a bhfo-nótaí. Ní féidir é seo a chealú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sljedeće bilješke i njihove podbilješke bit će trajno izbrisane. Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő jegyzetek és aljegyzeteik véglegesen törlődnek. Ez a művelet nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le seguenti note e le loro sottonote verranno cancellate definitivamente. L’operazione non può essere annullata."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toliau nurodytos pastabos ir jų antrinės pastabos bus ištrintos visam laikui. Šio veiksmo negalima anuliuoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tālāk norādītās piezīmes un to apakšpiezīmes tiks neatgriezeniski izdzēstas. Šo darbību nevar atsaukt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti li ġejjin u s-sottonoti tagħhom se jitħassru għal kollox. Dan ma jistax jitreġġa’ lura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następujące notatki wraz z notatkami podrzędnymi zostaną trwale wymazane. Tej czynności nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas seguintes e as respetivas subnotas serão apagadas permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următoarele notițe și subnotițele lor vor fi șterse definitiv. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasledujúce poznámky a ich podradené poznámky sa natrvalo vymažú. Túto akciu nie je možné vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslednje beležke in njihove podbeležke bodo trajno izbrisane. Tega ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följande anteckningar och deras underanteckningar raderas permanent. Detta kan inte ångras."
          }
        }
      }
    },
    "The image format is not supported for preview.": {
