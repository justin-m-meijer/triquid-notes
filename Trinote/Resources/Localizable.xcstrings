    "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected.": {
      "comment": "Clear cache message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الملاحظات والفروع والسمات المخبأة محليًا. بيانات الخادم لا تتأثر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto odstraníte všechny místně uložené poznámky, větve a atributy tohoto serveru. Vaše data na serveru nejsou dotčena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle lokal zwischengespeicherten Notizen, Zweige und Attribute für diesen Server entfernt. Deine Daten auf dem Server sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove all locally cached notes, branches, and attributes for this server. Your data on the server is not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las notas, ramas y atributos guardados localmente en caché de este servidor. Tus datos del servidor no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera toutes les notes, branches et attributs mis en cache localement pour ce serveur. Vos données sur le serveur ne sont pas affectées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर के लिए स्थानीय कैश नोट, शाखाएँ और विशेषताएँ हटा देगा। सर्वर डेटा सुरक्षित है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja a szerverhez tartozó összes helyileg gyorsítótárazott jegyzetet, ágat és attribútumot. A szerveren lévő adatait ez nem érinti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimossi tutti le note, i rami e gli attributi in cache locale per questo server. I tuoi dati sul server non vengono toccati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle lokaal bewaarde notities, takken en attributen voor deze server verwijderd. Je gegevens op de server worden niet aangetast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich lokalnie przechowywanych notatek, gałęzi i atrybutów tego serwera. Nie wpłynie to na Twoje dane na serwerze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит локально кэшированные заметки, ветки и атрибуты. Данные на сервере не затрагиваются."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще премахне всички локално кеширани бележки, клонове и атрибути за този сървър. Данните ви на сървъра не се засягат."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle lokalt cachelagrede noter, grene og attributter for denne server. Dine data på serveren påvirkes ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα αφαιρεθούν όλες οι τοπικά αποθηκευμένες σημειώσεις, κλάδοι και χαρακτηριστικά για αυτόν τον διακομιστή. Τα δεδομένα σας στον διακομιστή δεν επηρεάζονται."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab kõik selle serveri kohalikult vahemällu salvestatud märkmed, harud ja atribuudid. Serveris olevaid andmeid see ei mõjuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki tämän palvelimen paikallisesti välimuistiin tallennetut muistiinpanot, haarat ja attribuutit. Palvelimella oleviin tietoihisi tämä ei vaikuta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bainfidh sé seo gach nóta, craobh agus tréith sa taisce áitiúil don fhreastalaí seo. Ní dhéantar difear do do shonraí ar an bhfreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time će se ukloniti sve lokalno predmemorirane bilješke, grane i atributi za ovaj poslužitelj. Vaši podaci na poslužitelju nisu zahvaćeni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus pašalintos visos šio serverio talpykloje esančios pastabos, šakos ir atributai. Jūsų duomenims serveryje tai neturi įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks noņemtas visas šī servera lokāli kešotās piezīmes, zari un atribūti. Jūsu dati serverī netiek ietekmēti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan se jneħħi n-noti, il-fergħat u l-attributi kollha fil-cache lokali għal dan is-server. Id-data tiegħek fuq is-server ma tintmessx."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá remover todas as notas, ramos e atributos em cache local deste servidor. Os seus dados no servidor não são afetados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor elimina toate notițele, ramurile și atributele din cache-ul local pentru acest server. Datele de pe server nu sunt afectate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto odstránite všetky lokálne uložené poznámky, vetvy a atribúty tohto servera. Vaše dáta na serveri nie sú dotknuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste odstranili vse lokalno predpomnjene beležke, veje in atribute za ta strežnik. Vaši podatki na strežniku ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort alla lokalt cachelagrade anteckningar, grenar och attribut för den här servern. Din data på servern påverkas inte."
          }
        }
      }
    },
    "This will remove the server profile and sign out. Your notes on the server will not be affected.": {
      "comment": "Remove profile message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
