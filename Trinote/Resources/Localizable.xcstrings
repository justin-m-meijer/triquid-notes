    "“%@” is also cloned elsewhere in the tree. Removing it from the board keeps those clones.": {
      "comment": "Kanban remove cloned card message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» منسوخة أيضًا في مكان آخر من الشجرة. إزالتها من اللوحة تُبقي تلك النسخ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je naklonována i jinde ve stromu. Odebráním z tabule zůstanou tyto klony zachovány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist auch an anderer Stelle im Baum geklont. Beim Entfernen vom Board bleiben diese Klone erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is also cloned elsewhere in the tree. Removing it from the board keeps those clones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» también está clonada en otras partes del árbol. Al quitarla del tablero se conservan esos clones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est aussi cloné ailleurs dans l’arborescence. Le retirer du tableau conserve ces clones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ट्री में कहीं और भी क्लोन है। इसे बोर्ड से हटाने पर वे क्लोन बने रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” a fa más részein is klónozva van. Ha eltávolítja a tábláról, ezek a klónok megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è clonata anche altrove nell’albero. Rimuovendola dalla bacheca, quei cloni restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is ook elders in de boom gekloond. Als je hem van het bord verwijdert, blijven die klonen behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” jest sklonowana także w innym miejscu drzewa. Usunięcie jej z tablicy zachowa te klony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» также клонирована в другие места дерева. Если убрать её с доски, эти клоны останутся."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е клониран и на други места в дървото. Премахването от таблото запазва тези клонинги."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er også klonet andre steder i træet. Hvis du fjerner den fra tavlen, bevares disse kloner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι επίσης κλωνοποιημένο αλλού στο δέντρο. Η αφαίρεσή του από τον πίνακα διατηρεί αυτούς τους κλώνους."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ on kloonitud ka mujale puus. Tahvlilt eemaldamisel jäävad need kloonid alles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on kloonattu myös muualle puuhun. Taululta poistaminen säilyttää nämä kloonit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá “%@” clónáilte in áit eile sa chrann freisin. Má bhaintear den chlár é, fanfaidh na clóin sin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je kloniran i na drugim mjestima u stablu. Uklanjanjem s ploče ti klonovi ostaju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ klonuota ir kitur medyje. Pašalinus ją iš lentos, tie klonai išliks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” ir klonēta arī citur kokā. Noņemot to no tāfeles, šie kloni tiek saglabāti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” huwa kklonat ukoll x’imkien ieħor fis-siġra. Jekk tneħħih mill-bord, dawk il-kloni jibqgħu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota «%@» também está clonada noutro local da árvore. Ao removê-la do quadro, esses clones mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” este clonată și în alte locuri din arbore. Eliminarea de pe panou păstrează acele clone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je naklonovaná aj inde v strome. Odstránením z tabule zostanú tieto klony zachované."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležka „%@“ je klonirana tudi drugje v drevesu. Če jo odstranite s table, ti kloni ostanejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är även klonad på andra ställen i trädet. Om du tar bort den från tavlan behålls de klonerna."
          }
        }
      }
    },
