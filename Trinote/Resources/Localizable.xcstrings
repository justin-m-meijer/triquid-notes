    "Choose where to move the note. Open folders, then tap a note to select it as the new parent.": {
      "comment": "Instructions for move note parent picker\nInstructions for move-note parent picker",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان نقل الملاحظة. افتح المجلدات، ثم انقر ملاحظة لاختيارها كأب جديد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, kam poznámku přesunout. Otevřete složky a klepnutím na poznámku ji vyberte jako novou nadřazenou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wohin die Notiz verschoben wird. Öffne Ordner und tippe dann auf eine Notiz, um sie als neue übergeordnete Notiz auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to move the note. Open folders, then tap a note to select it as the new parent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige adónde mover la nota. Abre las carpetas y toca una nota para seleccionarla como nueva nota superior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où déplacer la note. Ouvrez les dossiers, puis touchez une note pour la sélectionner comme nouveau parent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट कहाँ ले जाना है चुनें। फ़ोल्डर खोलें, फिर नए मूल के रूप में चुनने के लिए किसी नोट पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, hová helyezze át a jegyzetet. Nyissa meg a mappákat, majd koppintson egy jegyzetre, hogy kiválassza új szülőként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove spostare la nota. Apri le cartelle, poi tocca una nota per selezionarla come nuova nota principale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar je de notitie naartoe wilt verplaatsen. Open mappen en tik op een notitie om die als nieuwe bovenliggende notitie te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie przenieść notatkę. Otwieraj foldery, a następnie stuknij notatkę, aby wybrać ją jako nowy element nadrzędny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, куда переместить заметку. Откройте папки и нажмите заметку, чтобы сделать её новым родителем."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете къде да преместите бележката. Отваряйте папките, след това докоснете бележка, за да я изберете за нов родител."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor noten skal flyttes hen. Åbn mapper, og tryk på en note for at vælge den som ny overordnet note."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πού θα μετακινηθεί η σημείωση. Ανοίξτε φακέλους και αγγίξτε μια σημείωση για να την επιλέξετε ως νέα γονική."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, kuhu märge teisaldada. Ava kaustu ja puuduta märget, et valida see uueks ülemmärkmeks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mihin muistiinpano siirretään. Avaa kansioita ja valitse uusi ylämuistiinpano napauttamalla sitä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh cá mbogfar an nóta. Oscail fillteáin, ansin tapáil nóta chun é a roghnú mar an tuismitheoir nua."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite kamo premjestiti bilješku. Otvarajte mape, zatim dodirnite bilješku da biste je odabrali kao novu nadređenu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite, kur perkelti pastabą. Atidarykite aplankus, tada bakstelėkite pastabą, kad ją pasirinktumėte kaip naują tėvinę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties, kur pārvietot piezīmi. Atveriet mapes un pieskarieties piezīmei, lai to atlasītu kā jauno vecākpiezīmi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel fejn timxi n-nota. Iftaħ il-folders, imbagħad agħfas nota biex tagħżilha bħala l-ġenitur il-ġdid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha para onde mover a nota. Abra as pastas e toque numa nota para a selecionar como nova nota principal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți unde să mutați notița. Deschideți dosarele, apoi apăsați o notiță pentru a o selecta ca părinte nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte, kam poznámku presunúť. Otvorte priečinky a klepnutím na poznámku ju vyberte ako novú nadradenú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, kam naj se beležka premakne. Odprite mape, nato tapnite beležko, da jo izberete kot novo nadrejeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vart anteckningen ska flyttas. Öppna mappar och tryck på en anteckning för att välja den som ny överordnad anteckning."
          }
        }
      }
    },
