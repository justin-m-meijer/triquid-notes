    "Spreadsheet notes require Trilium %1$@ or newer on the receiver’s server (their server is %2$@).": {
      "comment": "Local transfer spreadsheet blocked. %1$@ min version, %2$@ receiver version.",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabellennotizen erfordern Trilium %1$@ oder neuer auf dem Server des Empfängers (dessen Server hat %2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de feuille de calcul nécessitent Trilium %1$@ ou version ultérieure sur le serveur du destinataire (son serveur est en %2$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekenbladnotities vereisen Trilium %1$@ of nieuwer op de server van de ontvanger (hun server is %2$@)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките с таблици изискват Trilium %1$@ или по-нов на сървъра на получателя (неговият сървър е %2$@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulkové poznámky vyžadují na serveru příjemce Trilium %1$@ nebo novější (jeho server má verzi %2$@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regnearksnoter kræver Trilium %1$@ eller nyere på modtagerens server (deres server er %2$@)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις υπολογιστικών φύλλων απαιτούν Trilium %1$@ ή νεότερο στον διακομιστή του παραλήπτη (ο διακομιστής του είναι %2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de hoja de cálculo requieren Trilium %1$@ o posterior en el servidor del receptor (su servidor tiene %2$@)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutustabeli märkmed nõuavad vastuvõtja serveris Triliumi versiooni %1$@ või uuemat (tema server on %2$@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskentataulukkomuistiinpanot vaativat vastaanottajan palvelimelle Triliumin version %1$@ tai uudemman (hänen palvelimensa on %2$@)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn Trilium %1$@ nó níos nuaí ar fhreastalaí an ghlacadóra do nótaí scarbhileoige (is é %2$@ a fhreastalaí)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke s proračunskim tablicama zahtijevaju Trilium %1$@ ili noviji na primateljevu poslužitelju (njegov je poslužitelj %2$@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A táblázatjegyzetekhez Trilium %1$@ vagy újabb szükséges a fogadó szerverén (az ő szervere: %2$@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
