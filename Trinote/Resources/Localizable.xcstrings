    "Note content is not available offline. Open the note while connected, then try again.": {
      "comment": "Cross-instance copy needs content\nLocal transfer needs cached content",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Notizinhalt ist offline nicht verfügbar. Öffne die Notiz, während du verbunden bist, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de la note n’est pas disponible hors ligne. Ouvrez la note lorsque vous êtes connecté, puis réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inhoud van de notitie is niet offline beschikbaar. Open de notitie terwijl je verbonden bent en probeer het opnieuw."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съдържанието на бележката не е налично офлайн. Отворете бележката, докато сте свързани, след това опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah poznámky není k dispozici offline. Otevřete poznámku, když jste připojeni, a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notens indhold er ikke tilgængeligt offline. Åbn noten, mens du har forbindelse, og prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο της σημείωσης δεν είναι διαθέσιμο εκτός σύνδεσης. Ανοίξτε τη σημείωση ενώ είστε συνδεδεμένοι και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la nota no está disponible sin conexión. Abre la nota mientras tengas conexión e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkme sisu pole võrguühenduseta saadaval. Ava märge ühenduse olemasolul ja proovi siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanon sisältö ei ole saatavilla offline-tilassa. Avaa muistiinpano, kun yhteys on käytössä, ja yritä sitten uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl ábhar an nóta ar fáil as líne. Oscail an nóta agus tú ceangailte, ansin bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadržaj bilješke nije dostupan izvan mreže. Otvorite bilješku dok ste povezani, zatim pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzet tartalma offline nem érhető el. Nyissa meg a jegyzetet kapcsolat mellett, majd próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto della nota non è disponibile offline. Apri la nota mentre sei connesso, poi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastabos turinys nepasiekiamas neprisijungus. Atidarykite pastabą prisijungę ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmes saturs nav pieejams bezsaistē. Atveriet piezīmi, kamēr ir savienojums, un mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kontenut tan-nota mhux disponibbli offline. Iftaħ in-nota waqt li tkun konness, imbagħad erġa’ pprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość notatki nie jest dostępna offline. Otwórz notatkę z połączeniem, a następnie spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo da nota não está disponível offline. Abra a nota com ligação e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul notiței nu este disponibil offline. Deschideți notița cât sunteți conectat, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah poznámky nie je k dispozícii offline. Otvorte poznámku, keď ste pripojení, a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebina beležke ni na voljo brez povezave. Odprite beležko, ko ste povezani, in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningens innehåll är inte tillgängligt offline. Öppna anteckningen när du är ansluten och försök igen."
          }
        }
      }
    },
