    "Used for headings, lists and the text of your notes.": {
      "comment": "Appearance: typeface footer",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für Überschriften, Listen und den Text deiner Notizen verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée pour les titres, les listes et le texte de vos notes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor koppen, lijsten en de tekst van je notities."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва се за заглавия, списъци и текста на бележките ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá se pro nadpisy, seznamy a text vašich poznámek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til overskrifter, lister og teksten i dine noter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται για επικεφαλίδες, λίστες και το κείμενο των σημειώσεών σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa en los encabezados, las listas y el texto de tus notas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutatakse pealkirjade, loendite ja märkmete teksti jaoks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään otsikoissa, luetteloissa ja muistiinpanojesi tekstissä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsáidtear é do cheannteidil, liostaí agus téacs do nótaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrebljava se za naslove, popise i tekst vaših bilješki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címsorokhoz, a listákhoz és a jegyzetek szövegéhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per titoli, elenchi e il testo delle note."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudojamas antraštėms, sąrašams ir jūsų pastabų tekstui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek izmantots virsrakstiem, sarakstiem un jūsu piezīmju tekstam."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jintuża għall-intestaturi, il-listi u t-test tan-noti tiegħek."
          }
        },
        "pl": {
