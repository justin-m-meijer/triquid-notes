          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtige noter, scanninger med søgbar tekst, eller del en PDF fra en hvilken som helst app."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γρήγορες σημειώσεις, σαρώσεις με κείμενο με δυνατότητα αναζήτησης ή κοινοποίηση PDF από οποιαδήποτε εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas rápidas, escaneos con texto buscable o comparte un PDF desde cualquier app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirmärkmed, otsitava tekstiga skannid või jaga PDF-i mis tahes rakendusest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikamuistiinpanot, skannaukset haettavalla tekstillä tai PDF:n jakaminen mistä tahansa sovelluksesta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Nótaí tapa, scananna le téacs inchuardaithe, nó comhroinn PDF ó aon aip."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brze bilješke, skenovi s pretraživim tekstom ili dijeljenje PDF-a iz bilo koje aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors jegyzetek, kereshető szövegű szkennelések, vagy ossza meg egy PDF-et bármely alkalmazásból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note rapide, scansioni con testo ricercabile o condividi un PDF da qualsiasi app."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparčios pastabos, nuskaitymai su ieškomu tekstu arba PDF bendrinimas iš bet kurios programos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ātras piezīmes, skenējumi ar meklējamu tekstu vai PDF kopīgošana no jebkuras lietotnes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
