    },
    "These photos couldn't be read from your library. They may still be downloading from iCloud.": {
      "comment": "Photo insert failure message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fotos konnten nicht aus deiner Mediathek gelesen werden. Möglicherweise werden sie noch von iCloud geladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces photos n’ont pas pu être lues depuis votre photothèque. Elles sont peut-être encore en cours de téléchargement depuis iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto's kunnen niet uit je bibliotheek worden gelezen. Mogelijk worden ze nog gedownload van iCloud."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тези снимки не можаха да бъдат прочетени от библиотеката ви. Възможно е още да се изтеглят от iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto fotky nelze z knihovny načíst. Možná se stále stahují z iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse fotos kunne ikke læses fra dit bibliotek. De er muligvis stadig ved at blive hentet fra iCloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση αυτών των φωτογραφιών από τη βιβλιοθήκη σας. Ίσως γίνεται ακόμα λήψη τους από το iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer estas fotos de tu fototeca. Puede que aún se estén descargando de iCloud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Neid fotosid ei õnnestunud sinu kogust lugeda. Need võivad alles iCloudist alla laadida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näitä kuvia ei voitu lukea kirjastostasi. Niiden lataus iCloudista voi olla vielä kesken."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir na grianghraif seo a léamh ó do leabharlann. D’fhéadfadh siad a bheith fós á n-íoslódáil ó iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove fotografije nije moguće pročitati iz medijateke. Možda se još preuzimaju s iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a fotókat nem sikerült beolvasni a fotókönyvtárból. Lehet, hogy még töltődnek le az iCloudból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere queste foto dalla libreria. Potrebbero essere ancora in download da iCloud."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šių nuotraukų nepavyko perskaityti iš jūsų bibliotekos. Gali būti, kad jos dar atsisiunčiamos iš iCloud."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šos fotoattēlus nevarēja nolasīt no jūsu bibliotēkas. Iespējams, tie vēl tiek lejupielādēti no iCloud."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawn ir-ritratti ma setgħux jinqraw mil-librerija tiegħek. Jista’ jkun li għadhom qed jitniżżlu minn iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać tych zdjęć z biblioteki. Mogą być jeszcze pobierane z iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler estas fotografias da fototeca. Podem ainda estar a ser descarregadas do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste poze nu au putut fi citite din bibliotecă. Este posibil să se descarce încă din iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto fotky sa nepodarilo načítať z knižnice. Možno sa stále sťahujú z iCloudu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teh fotografij ni bilo mogoče prebrati iz knjižnice. Morda se še prenašajo iz iClouda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här bilderna kunde inte läsas från ditt bibliotek. De kanske fortfarande hämtas från iCloud."
          }
        }
      }
    },
    "They download again when you open them. Keep them to only stop new downloads.": {
      "comment": "Offline cache: remove cached media message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُنزَّل مرة أخرى عند فتحها. احتفظ بها لإيقاف التنزيلات الجديدة فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při otevření se znovu stáhnou. Chcete-li jen zastavit nová stahování, ponechte je."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden beim Öffnen erneut geladen. Behalte sie, um nur neue Downloads zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They download again when you open them. Keep them to only stop new downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverán a descargar al abrirlos. Consérvalos para detener solo las descargas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils seront de nouveau téléchargés à leur ouverture. Conservez-les pour arrêter uniquement les nouveaux téléchargements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलने पर वे फिर से डाउनलोड होंगी। केवल नए डाउनलोड रोकने के लिए उन्हें रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitáskor újra letöltődnek. A megtartással csak az új letöltések állnak le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno scaricati di nuovo quando li apri. Conservali per bloccare solo i nuovi download."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze worden opnieuw gedownload als je ze opent. Bewaar ze om alleen nieuwe downloads te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną ponownie pobrane po otwarciu. Wybierz Zachowaj, aby tylko wstrzymać nowe pobieranie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они снова загрузятся, когда вы их откроете. Оставьте их, чтобы только прекратить новые загрузки."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Те се изтеглят отново, когато ги отворите. Изберете Запази, за да спрете само новите изтегляния."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De hentes igen, når du åbner dem. Behold dem for kun at stoppe nye overførsler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα γίνει ξανά λήψη τους όταν τα ανοίξετε. Διατηρήστε τα για να σταματήσουν μόνο οι νέες λήψεις."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need laaditakse avamisel uuesti alla. Kui soovid ainult uued allalaadimised peatada, vali Säilita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ladataan uudelleen, kun avaat ne. Valitse Säilytä, jos haluat vain lopettaa uudet lataukset."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Íoslódáiltear arís iad nuair a osclaíonn tú iad. Coinnigh iad chun íoslódálacha nua amháin a stopadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno se preuzimaju kad ih otvorite. Zadržite ih da biste samo zaustavili nova preuzimanja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie vėl atsisiunčiami, kai juos atidarote. Palikite juos, jei norite tik sustabdyti naujus atsisiuntimus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie tiks lejupielādēti atkārtoti, kad tos atvērsiet. Paturiet tos, lai tikai pārtrauktu jaunas lejupielādes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerġgħu jitniżżlu meta tiftaħhom. Żommhom biex twaqqaf biss it-tniżżil ta’ oħrajn ġodda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São descarregados novamente quando os abrir. Mantenha-os para apenas parar novas transferências."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarcă din nou când le deschideți. Păstrați-le pentru a opri doar descărcările noi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri otvorení sa znova stiahnu. Ak chcete len zastaviť nové sťahovania, ponechajte ich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko jih odprete, se znova prenesejo. Če jih ohranite, se ustavijo le novi prenosi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De hämtas igen när du öppnar dem. Behåll dem för att bara stoppa nya hämtningar."
          }
        }
      }
    },
