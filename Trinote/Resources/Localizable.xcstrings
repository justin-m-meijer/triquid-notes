    "These optional headers let Triquid Notes reach a Trilium server protected by Cloudflare Access / Zero Trust.": {
      "comment": "Cloudflare Access settings intro",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesen optionalen Headern kann Triquid Notes einen Trilium-Server erreichen, der durch Cloudflare Access / Zero Trust geschützt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces en-têtes facultatifs permettent à Triquid Notes d’atteindre un serveur Trilium protégé par Cloudflare Access / Zero Trust."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze optionele headers kan Triquid Notes een Trilium-server bereiken die is beveiligd met Cloudflare Access / Zero Trust."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тези незадължителни заглавки позволяват на Triquid Notes да достигне сървър на Trilium, защитен с Cloudflare Access / Zero Trust."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto volitelné hlavičky umožňují Triquid Notes připojit se k serveru Trilium chráněnému pomocí Cloudflare Access / Zero Trust."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med disse valgfrie headere kan Triquid Notes nå en Trilium-server, der er beskyttet af Cloudflare Access / Zero Trust."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι προαιρετικές κεφαλίδες επιτρέπουν στο Triquid Notes να φτάνει σε διακομιστή Trilium που προστατεύεται από Cloudflare Access / Zero Trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cabeceras opcionales permiten que Triquid Notes acceda a un servidor Trilium protegido por Cloudflare Access / Zero Trust."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need valikulised päised võimaldavad Triquid Notesil jõuda Cloudflare Accessi / Zero Trustiga kaitstud Triliumi serverini."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden valinnaisten otsakkeiden avulla Triquid Notes saa yhteyden Cloudflare Accessilla / Zero Trustilla suojattuun Trilium-palvelimeen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligeann na ceanntásca roghnacha seo do Triquid Notes freastalaí Trilium atá cosanta ag Cloudflare Access / Zero Trust a bhaint amach."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova neobavezna zaglavlja omogućuju aplikaciji Triquid Notes pristup poslužitelju Trilium zaštićenom uslugom Cloudflare Access / Zero Trust."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezekkel a nem kötelező fejlécekkel a Triquid Notes elérheti a Cloudflare Access / Zero Trust által védett Trilium-szervert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste intestazioni facoltative consentono a Triquid Notes di raggiungere un server Trilium protetto da Cloudflare Access / Zero Trust."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šios neprivalomos antraštės leidžia Triquid Notes pasiekti Trilium serverį, apsaugotą Cloudflare Access / Zero Trust."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šīs neobligātās galvenes ļauj Triquid Notes piekļūt Trilium serverim, kas aizsargāts ar Cloudflare Access / Zero Trust."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawn il-headers mhux obbligatorji jħallu lil Triquid Notes jilħaq server ta’ Trilium protett minn Cloudflare Access / Zero Trust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te opcjonalne nagłówki pozwalają Triquid Notes łączyć się z serwerem Trilium chronionym przez Cloudflare Access / Zero Trust."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes cabeçalhos opcionais permitem que a Triquid Notes aceda a um servidor Trilium protegido pelo Cloudflare Access / Zero Trust."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste antete opționale permit aplicației Triquid Notes să acceseze un server Trilium protejat de Cloudflare Access / Zero Trust."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto voliteľné hlavičky umožňujú Triquid Notes pripojiť sa k serveru Trilium chránenému pomocou Cloudflare Access / Zero Trust."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
