    "Reconnect to “%@” in Settings, then try again.": {
      "comment": "Copy to instance dest session expired; %@ instance name",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich in den Einstellungen erneut mit „%@“ und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous à « %@ » dans Réglages, puis réessayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak opnieuw verbinding met ‘%@’ in Instellingen en probeer het opnieuw."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете се отново с „%@“ в Настройки, след това опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu se připojte k „%@“ v Nastavení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til “%@” igen i Indstillinger, og prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε ξανά στο «%@» από τις Ρυθμίσεις και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte a «%@» en Ajustes e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo Seadetes uuesti ühendus instantsiga „%@“ ja proovi siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä uudelleen kohteeseen ”%@” Asetuksissa ja yritä sitten uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athcheangail le “%@” i Socruithe, ansin bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno se povežite s „%@” u Postavkama, zatim pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozzon újra ehhez: „%@” a Beállításokban, majd próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti a “%@” in Impostazioni, poi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatymuose iš naujo prisijunkite prie „%@“ ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestatījumos atkārtoti izveidojiet savienojumu ar „%@” un mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erġa’ qabbad ma’ “%@” fis-Settings, imbagħad erġa’ pprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się ponownie z „%@” w Ustawieniach, a następnie spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a ligar-se a «%@» nas Definições e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectați-vă la „%@” din Configurări, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova sa pripojte k „%@“ v Nastaveniach a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavitvah se znova povežite z „%@“ in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till ”%@” igen i Inställningar och försök igen."
          }
        }
      }
    },
