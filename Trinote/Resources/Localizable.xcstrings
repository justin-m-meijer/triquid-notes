    "This canvas note doesn't have a preview yet. Open it in the Trilium web or desktop app to generate one.": {
      "comment": "A description of the error message displayed when a canvas note has no preview.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Canvas-Notiz hat noch keine Vorschau. Öffne sie in der Trilium-Web- oder Desktop-App, um eine zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note canevas n’a pas encore d’aperçu. Ouvrez-la dans l’app web ou de bureau Trilium pour en générer un."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze canvasnotitie heeft nog geen voorvertoning. Open hem in de Trilium-web- of desktopapp om er een te genereren."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази бележка-платно все още няма преглед. Отворете я в уеб или настолното приложение на Trilium, за да се генерира."
