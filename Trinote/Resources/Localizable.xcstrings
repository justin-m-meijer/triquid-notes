    "Enter the same document password you use in Trilium for protected notes. It stays active until you sign out or the server ends the session.": {
      "comment": "Protected note gate",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل نفس كلمة مرور المستند كما في Trilium. تبقى نشطة حتى تسجيل الخروج أو انتهاء الجلسة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte stejné heslo dokumentu, jaké v Trilium používáte pro chráněné poznámky. Zůstane aktivní, dokud se neodhlásíte nebo server relaci neukončí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dasselbe Dokumentpasswort ein, das du in Trilium für geschützte Notizen verwendest. Es bleibt aktiv, bis du dich abmeldest oder der Server die Sitzung beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the same document password you use in Trilium for protected notes. It stays active until you sign out or the server ends the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la misma contraseña de documento que usas en Trilium para las notas protegidas. Seguirá activa hasta que cierres sesión o el servidor finalice la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe de document que vous utilisez dans Trilium pour les notes protégées. Il reste actif jusqu’à ce que vous vous déconnectiez ou que le serveur mette fin à la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium में जैसा दस्तावेज़ पासवर्ड वही दर्ज करें। साइन आउट या सत्र समाप्ति तक सक्रिय।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg ugyanazt a dokumentumjelszót, amelyet a Triliumban a védett jegyzetekhez használ. Kijelentkezésig vagy addig marad érvényben, amíg a szerver le nem zárja a munkamenetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la stessa password del documento che usi in Trilium per le note protette. Resta attiva finché non esci o il server termina la sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer hetzelfde documentwachtwoord in dat je in Trilium voor beveiligde notities gebruikt. Het blijft actief tot je uitlogt of de server de sessie beëindigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź to samo hasło dokumentu, którego używasz w Trilium dla chronionych notatek. Pozostaje aktywne do wylogowania lub zakończenia sesji przez serwer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите тот же пароль документа, что в Trilium. Действует до выхода или завершения сессии."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете същата парола за документи, която използвате в Trilium за защитени бележки. Тя остава активна, докато не излезете или сървърът не прекрати сесията."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den samme dokumentadgangskode, som du bruger i Trilium til beskyttede noter. Den forbliver aktiv, indtil du logger ud, eller serveren afslutter sessionen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε το ίδιο συνθηματικό εγγράφου που χρησιμοποιείτε στο Trilium για προστατευμένες σημειώσεις. Παραμένει ενεργό μέχρι να αποσυνδεθείτε ή να λήξει η συνεδρία από τον διακομιστή."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta sama dokumendi parool, mida kasutad Triliumis kaitstud märkmete jaoks. See jääb aktiivseks, kuni logid välja või server seansi lõpetab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä sama asiakirjan salasana, jota käytät Triliumissa suojattuihin muistiinpanoihin. Se pysyy voimassa, kunnes kirjaudut ulos tai palvelin päättää istunnon."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuir isteach an pasfhocal cáipéise céanna a úsáideann tú in Trilium do nótaí cosanta. Fanann sé gníomhach go dtí go sínítear amach thú nó go gcríochnaíonn an freastalaí an seisiún."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite istu lozinku dokumenta koju u Triliumu upotrebljavate za zaštićene bilješke. Ostaje aktivna dok se ne odjavite ili poslužitelj ne završi sesiju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite tą patį dokumento slaptažodį, kurį naudojate Trilium apsaugotoms pastaboms. Jis galioja, kol atsijungsite arba serveris užbaigs seansą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet to pašu dokumenta paroli, ko izmantojat Trilium aizsargātajām piezīmēm. Tā paliek aktīva, līdz izrakstāties vai serveris beidz sesiju."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daħħal l-istess password tad-dokument li tuża fi Trilium għan-noti protetti. Jibqa’ attiv sakemm toħroġ jew is-server itemm is-sessjoni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a mesma palavra-passe de documento que usa no Trilium para notas protegidas. Mantém-se ativa até terminar sessão ou até o servidor terminar a sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți aceeași parolă de document pe care o folosiți în Trilium pentru notițele protejate. Rămâne activă până vă deconectați sau serverul încheie sesiunea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte rovnaké heslo dokumentu, aké v Trilium používate pre chránené poznámky. Zostane aktívne, kým sa neodhlásite alebo server reláciu neukončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite isto geslo dokumenta, ki ga v Triliumu uporabljate za zaščitene beležke. Ostane aktivno, dokler se ne odjavite ali strežnik ne konča seje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange samma dokumentlösenord som du använder i Trilium för skyddade anteckningar. Det förblir aktivt tills du loggar ut eller servern avslutar sessionen."
          }
        }
      }
    },
