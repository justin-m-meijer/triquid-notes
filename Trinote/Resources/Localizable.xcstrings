        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time će se ukloniti profil poslužitelja i odjavit ćete se. Vaše bilješke na poslužitelju neće biti zahvaćene."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverio profilis bus pašalintas ir būsite atjungti. Jūsų pastaboms serveryje tai neturės įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks noņemts servera profils, un jūs tiksiet izrakstīts. Jūsu piezīmes serverī netiks ietekmētas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan se jneħħi l-profil tas-server u joħroġ. In-noti tiegħek fuq is-server mhux se jintmessu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá remover o perfil do servidor e terminar a sessão. As suas notas no servidor não serão afetadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilul serverului va fi eliminat și veți fi deconectat. Notițele de pe server nu vor fi afectate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto odstránite profil servera a odhlásite sa. Vaše poznámky na serveri nebudú dotknuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste odstranili profil strežnika in se odjavili. Vaše beležke na strežniku ostanejo nespremenjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort serverprofilen och loggar ut. Dina anteckningar på servern påverkas inte."
          }
        }
      }
    },
