    "You are already signed in to this server. Switch to it under Settings → Instances, or sign it out there before adding it again.": {
      "comment": "Error when Add Instance URL matches an existing profile",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereits bei diesem Server angemeldet. Wechsle unter „Einstellungen“ → „Instanzen“ zu ihm oder melde ihn dort ab, bevor du ihn erneut hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déjà connecté à ce serveur. Basculez vers celui-ci dans Réglages → Instances, ou déconnectez-le avant de l’ajouter à nouveau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent al ingelogd op deze server. Schakel ernaar over via Instellingen → Instanties, of log daar uit voordat je hem opnieuw toevoegt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече сте влезли в този сървър. Превключете към него от Настройки → Инстанции или излезте от него там, преди да го добавите отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto serveru jste již přihlášeni. Přepněte se na něj v Nastavení → Instance, nebo se z něj tam odhlaste, než ho přidáte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede logget ind på denne server. Skift til den under Indstillinger → Instanser, eller log ud af den der, før du tilføjer den igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε ήδη συνδεδεμένοι σε αυτόν τον διακομιστή. Μεταβείτε σε αυτόν από τις Ρυθμίσεις → Στιγμιότυπα ή αποσυνδεθείτε από εκεί πριν τον προσθέσετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has iniciado sesión en este servidor. Cambia a él en Ajustes → Instancias, o cierra allí la sesión antes de volver a añadirlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oled sellesse serverisse juba sisse logitud. Lülitu sellele jaotises Seaded → Instantsid või logi sealt välja, enne kui selle uuesti lisad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo kirjautunut tälle palvelimelle. Vaihda siihen kohdassa Asetukset → Instanssit tai kirjaudu siellä ulos ennen kuin lisäät sen uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá tú sínithe isteach sa fhreastalaí seo cheana. Athraigh chuige faoi Socruithe → Cásanna, nó sínigh amach ansin sula gcuireann tú leis arís é."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već ste prijavljeni na ovaj poslužitelj. Prebacite se na njega u Postavke → Instance ili se ondje odjavite prije ponovnog dodavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a szerverre már be van jelentkezve. Váltson rá a Beállítások → Példányok menüben, vagy ott jelentkezzen ki belőle, mielőtt újra hozzáadná."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già effettuato l’accesso a questo server. Passa a quel server in Impostazioni → Istanze, oppure esci da lì prima di aggiungerlo di nuovo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jau esate prisijungę prie šio serverio. Perjunkite į jį skiltyje Nustatymai → Egzemplioriai arba ten atsijunkite, prieš pridėdami jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs jau esat pierakstījies šajā serverī. Pārslēdzieties uz to sadaļā Iestatījumi → Instances vai izrakstieties tur, pirms to pievienojat vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diġà dħalt f’dan is-server. Aqleb għalih taħt Settings → Istanzi, jew oħroġ minnu hemmhekk qabel iżżidu mill-ġdid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już zalogowaną sesję na tym serwerze. Przełącz się na niego w Ustawienia → Instancje lub wyloguj się z niego tam, zanim dodasz go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já tem sessão iniciada neste servidor. Mude para ele em Definições → Instâncias, ou termine aí a sessão antes de o adicionar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți deja autentificat pe acest server. Comutați la el din Configurări → Instanțe sau deconectați-l de acolo înainte de a-l adăuga din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tento server ste už prihlásení. Prepnite sa naň v Nastaveniach → Inštancie alebo sa z neho tam odhláste, skôr ako ho pridáte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V ta strežnik ste že prijavljeni. Preklopite nanj v Nastavitve → Instance ali se tam odjavite, preden ga znova dodate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är redan inloggad på den här servern. Byt till den under Inställningar → Instanser, eller logga ut från den där innan du lägger till den igen."
          }
        }
      }
    },
    "You can also enter a recovery code.": {
      "comment": "TOTP recovery hint",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch einen Wiederherstellungscode eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également saisir un code de récupération."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook een herstelcode invoeren."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете също да въведете код за възстановяване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete také zadat obnovovací kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også indtaste en gendannelseskode."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε επίσης να εισαγάγετε έναν κωδικό ανάκτησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes introducir un código de recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võid sisestada ka taastekoodi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös syöttää palautuskoodin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir leat cód athshlánaithe a chur isteach freisin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete unijeti i kôd za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyreállítási kódot is megadhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche inserire un codice di recupero."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip pat galite įvesti atkūrimo kodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varat ievadīt arī atkopšanas kodu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ ddaħħal ukoll kodiċi ta’ rkupru."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też wprowadzić kod odzyskiwania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode introduzir um código de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți introduce și un cod de recuperare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete zadať aj obnovovací kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
