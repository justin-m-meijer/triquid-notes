    "Stop caching %lld notebook(s) and remove their local data.": {
      "comment": "Cache exclusion confirm exclude",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching für %lld Notizbuch/Notizbücher beenden und lokale Daten entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la mise en cache de %lld carnet(s) et supprimer leurs données locales."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met cachen van %lld notitieboek(en) en verwijder de lokale gegevens."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спиране на кеширането на %lld бележника и премахване на локалните им данни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončit ukládání sešitů (%lld) do mezipaměti a odstranit jejich místní data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop med at gemme %lld notesbog(bøger) i cachen, og fjern deres lokale data."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακοπή αποθήκευσης %lld σημειωματαρίων στην κρυφή μνήμη και αφαίρεση των τοπικών δεδομένων τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de guardar en caché %lld cuadernos y eliminar sus datos locales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõpeta %lld märkmiku vahemällu salvestamine ja eemalda nende kohalikud andmed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopeta %lld muistikirjan tallentaminen välimuistiin ja poista niiden paikalliset tiedot."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop %lld leabhar nótaí a chur i dtaisce agus bain a sonraí áitiúla."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestanak predmemoriranja bilježnica (%lld) i uklanjanje njihovih lokalnih podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jegyzetfüzet gyorsítótárazásának leállítása és helyi adataik eltávolítása."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi la cache di %lld taccuini e rimuovi i loro dati locali."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebelaikyti užrašų knygų (%lld) talpykloje ir pašalinti jų vietinius duomenis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārtraukt kešot piezīmju grāmatas (%lld) un noņemt to lokālos datus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibqax iżżomm %lld notebook(s) fil-cache u neħħi d-data lokali tagħhom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj przechowywanie notesów (%lld) w pamięci podręcznej i usuń ich dane lokalne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar de guardar em cache %lld caderno(s) e remover os respetivos dados locais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește punerea în cache a %lld carnete și elimină datele lor locale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončiť ukladanie zošitov (%lld) do vyrovnávacej pamäte a odstrániť ich lokálne dáta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenehaj predpomniti zvezke (%lld) in odstrani njihove lokalne podatke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluta cachelagra %lld anteckningsbok/-böcker och ta bort deras lokala data."
