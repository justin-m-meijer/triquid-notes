            "value": "Σημειώστε μια σημείωση ως αγαπημένη για να την κρατήσετε εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una nota como favorita para tenerla aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgi märge lemmikuks, et seda siin hoida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse muistiinpano suosikiksi, niin se pysyy tässä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcáil nóta mar cheanán chun é a choinneáil anseo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite bilješku kao omiljenu da biste je čuvali ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelöljön meg egy jegyzetet kedvencként, hogy itt tartsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna una nota come preferita per tenerla qui."
          }
        },
        "lt": {
