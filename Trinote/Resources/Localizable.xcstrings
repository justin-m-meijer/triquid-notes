    "The JS Backend handler is missing on Trilium. Create that note, add the label below, paste the script, then tap Continue.": {
      "comment": "SSO waiting troubleshooting body",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der JS Backend-Handler fehlt in Trilium. Erstelle diese Notiz, füge das Label unten hinzu, füge das Skript ein und tippe dann auf „Fortfahren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gestionnaire JS Backend est absent de Trilium. Créez cette note, ajoutez l’étiquette ci-dessous, collez le script, puis touchez Continuer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De JS Backend-handler ontbreekt in Trilium. Maak die notitie aan, voeg het onderstaande label toe, plak het script en tik vervolgens op “Ga door”."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backend обработчикът липсва в Trilium. Създайте тази бележка, добавете етикета по-долу, поставете скрипта, след това докоснете Продължи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Trilium chybí handler JS Backend. Vytvořte tuto poznámku, přidejte níže uvedený štítek, vložte skript a klepněte na Pokračovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backend-handleren mangler i Trilium. Opret den note, tilføj etiketten nedenfor, indsæt scriptet, og tryk derefter på Fortsæt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χειριστής JS Backend λείπει από το Trilium. Δημιουργήστε αυτή τη σημείωση, προσθέστε την παρακάτω ετικέτα, επικολλήστε το σενάριο και αγγίξτε «Συνέχεια»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el controlador JS Backend en Trilium. Crea esa nota, añade la etiqueta de abajo, pega el script y toca Continuar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backendi töötleja puudub Triliumis. Loo see märge, lisa allolev silt, kleebi skript ja puuduta seejärel Jätka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backend ‑käsittelijä puuttuu Triliumista. Luo kyseinen muistiinpano, lisää alla oleva tunniste, liitä skripti ja napauta sitten Jatka."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an láimhseálaí JS Backend ar iarraidh ar Trilium. Cruthaigh an nóta sin, cuir an lipéad thíos leis, greamaigh an script, ansin tapáil Lean ar aghaidh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backend rukovatelj nedostaje u Triliumu. Stvorite tu bilješku, dodajte oznaku ispod, zalijepite skriptu, zatim dodirnite Nastavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A JS Backend-kezelő hiányzik a Triliumból. Hozza létre azt a jegyzetet, adja hozzá az alábbi címkét, illessze be a szkriptet, majd koppintson a Folytatás gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Trilium manca l’handler JS Backend. Crea quella nota, aggiungi l’etichetta qui sotto, incolla lo script, poi tocca Continua."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium trūksta JS Backend doroklės. Sukurkite tą pastabą, pridėkite toliau nurodytą etiketę, įklijuokite scenarijų ir bakstelėkite „Tęsti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium trūkst JS Backend apdarinātāja. Izveidojiet šo piezīmi, pievienojiet zemāk redzamo etiķeti, ielīmējiet skriptu un pieskarieties Turpināt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-handler JS Backend nieqes fuq Trilium. Oħloq dik in-nota, żid it-tikketta t’hawn taħt, waħħal l-iskript, imbagħad agħfas Kompli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje handlera JS Backend w Trilium. Utwórz tę notatkę, dodaj poniższą etykietę, wklej skrypt, a następnie stuknij Dalej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O handler JS Backend não existe no Trilium. Crie essa nota, adicione a etiqueta abaixo, cole o script e toque em Continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlerul JS Backend lipsește din Trilium. Creați acea notiță, adăugați eticheta de mai jos, lipiți scriptul, apoi apăsați Continuă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Trilium chýba handler JS Backend. Vytvorte túto poznámku, pridajte nižšie uvedený štítok, vložte skript a klepnite na Pokračovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Triliumu manjka obravnava JS Backend. Ustvarite to beležko, dodajte spodnjo oznako, prilepite skript in tapnite Nadaljuj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "JS Backend-hanteraren saknas i Trilium. Skapa den anteckningen, lägg till etiketten nedan, klistra in skriptet och tryck sedan på Fortsätt."
          }
        }
      }
    },
    "The note could not be added to the board.": {
      "comment": "Kanban add existing note refused by server",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
