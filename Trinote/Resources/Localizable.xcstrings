        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota de lienzo aún no tiene previsualización. Ábrela en la app web o de escritorio de Trilium para generarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel lõuendimärkmel pole veel eelvaadet. Selle loomiseks ava märge Triliumi veebi- või töölauarakenduses."
