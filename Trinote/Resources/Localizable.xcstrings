    "Sign out from \"%@\"? This removes the instance, cached notes, and saved session from this device. Data on the server is not deleted.": {
      "comment": "Confirm sign out instance; %@ is server display name",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von „%@“ abmelden? Dadurch werden die Instanz, gecachte Notizen und die gesicherte Sitzung von diesem Gerät entfernt. Daten auf dem Server werden nicht gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter de « %@ » ? Cela supprime l’instance, les notes en cache et la session enregistrée de cet appareil. Les données du serveur ne sont pas supprimées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitloggen bij \"%@\"? Hiermee worden de instantie, notities in de cache en de bewaarde sessie van dit apparaat verwijderd. Gegevens op de server worden niet verwijderd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се излезе ли от „%@“? Това премахва инстанцията, кешираните бележки и запазената сесия от това устройство. Данните на сървъра не се изтриват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásit se z „%@“? Tím se z tohoto zařízení odstraní instance, poznámky v mezipaměti a uložená relace. Data na serveru se nesmažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du logge ud af “%@”? Dette fjerner instansen, noter i cache og den gemte session fra denne enhed. Data på serveren slettes ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσύνδεση από το «%@»; Αυτό αφαιρεί το στιγμιότυπο, τις σημειώσεις της κρυφής μνήμης και την αποθηκευμένη συνεδρία από αυτή τη συσκευή. Τα δεδομένα στον διακομιστή δεν διαγράφονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar sesión en «%@»? Se eliminarán de este dispositivo la instancia, las notas en caché y la sesión guardada. Los datos del servidor no se eliminan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas logida välja instantsist „%@“? See eemaldab sellest seadmest instantsi, vahemälus olevad märkmed ja salvestatud seansi. Serveris olevaid andmeid ei kustutata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudutaanko ulos kohteesta ”%@”? Tämä poistaa instanssin, välimuistin muistiinpanot ja tallennetun istunnon tästä laitteesta. Palvelimella olevia tietoja ei poisteta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sínigh amach ó “%@”? Baintear an cás, na nótaí sa taisce agus an seisiún sábháilte den ghléas seo. Ní scriostar sonraí ar an bhfreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjaviti se s „%@”? Time se s ovog uređaja uklanjaju instanca, predmemorirane bilješke i spremljena sesija. Podaci na poslužitelju ne brišu se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkezik innen: „%@”? Ezzel a példány, a gyorsítótárazott jegyzetek és a mentett munkamenet törlődik erről az eszközről. A szerveren lévő adatok nem törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire da “%@”? Verranno rimossi da questo dispositivo l’istanza, le note in cache e la sessione salvata. I dati sul server non vengono eliminati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijungti nuo „%@“? Iš šio įrenginio bus pašalintas egzempliorius, talpykloje esančios pastabos ir išsaugotas seansas. Serveryje esantys duomenys neištrinami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai izrakstīties no „%@”? Tādējādi no šīs ierīces tiek noņemta instance, kešotās piezīmes un saglabātā sesija. Dati serverī netiek dzēsti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toħroġ minn “%@”? Dan ineħħi l-istanza, in-noti fil-cache u s-sessjoni salvata minn dan l-apparat. Id-data fuq is-server ma titħassarx."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogować się z „%@”? Spowoduje to usunięcie instancji, notatek w pamięci podręcznej i zachowanej sesji z tego urządzenia. Dane na serwerze nie zostaną usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar sessão em «%@»? Isto remove a instância, as notas em cache e a sessão guardada deste dispositivo. Os dados no servidor não são apagados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă deconectați de la „%@”? Instanța, notițele din cache și sesiunea salvată vor fi eliminate de pe acest dispozitiv. Datele de pe server nu sunt șterse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásiť sa z „%@“? Tým sa z tohto zariadenia odstráni inštancia, poznámky vo vyrovnávacej pamäti a uložená relácia. Dáta na serveri sa nevymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se želite odjaviti iz „%@“? S tem iz te naprave odstranite instanco, predpomnjene beležke in shranjeno sejo. Podatki na strežniku ne bodo izbrisani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du logga ut från ”%@”? Detta tar bort instansen, cachelagrade anteckningar och den sparade sessionen från den här enheten. Data på servern raderas inte."
          }
        }
      }
    },
