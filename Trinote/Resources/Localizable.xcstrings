    "Locked. Confirm your identity to unlock.": {
      "comment": "VoiceOver lock placeholder",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesperrt. Bestätige deine Identität zum Entsperren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
