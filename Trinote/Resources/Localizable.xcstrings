    "This removes locally cached notes, branches, and attributes for every signed-in instance. Profiles and sessions stay signed in. Server data is not affected.": {
      "comment": "Message for clear cache all instances",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden lokal zwischengespeicherte Notizen, Zweige und Attribute für jede angemeldete Instanz entfernt. Profile und Sitzungen bleiben angemeldet. Daten auf dem Server sind nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime les notes, branches et attributs mis en cache localement pour chaque instance connectée. Les profils et sessions restent connectés. Les données du serveur ne sont pas affectées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden lokaal bewaarde notities, takken en attributen verwijderd voor elke ingelogde instantie. Profielen en sessies blijven ingelogd. Gegevens op de server worden niet aangetast."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това премахва локално кешираните бележки, клонове и атрибути за всяка вписана инстанция. Профилите и сесиите остават вписани. Данните на сървъра не се засягат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto odstraníte místně uložené poznámky, větve a atributy všech přihlášených instancí. Profily a relace zůstanou přihlášeny. Data na serveru nejsou dotčena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner lokalt cachelagrede noter, grene og attributter for alle instanser, du er logget ind på. Profiler og sessioner forbliver logget ind. Data på serveren påvirkes ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί τις τοπικά αποθηκευμένες σημειώσεις, κλάδους και χαρακτηριστικά για κάθε συνδεδεμένο στιγμιότυπο. Τα προφίλ και οι συνεδρίες παραμένουν συνδεδεμένα. Τα δεδομένα του διακομιστή δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán las notas, ramas y atributos guardados localmente en caché de todas las instancias con sesión iniciada. Los perfiles y sesiones siguen con la sesión iniciada. Los datos del servidor no se ven afectados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab kõigi sisselogitud instantside kohalikult vahemällu salvestatud märkmed, harud ja atribuudid. Profiilid ja seansid jäävad sisselogituks. Serveri andmeid see ei mõjuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikkien kirjautuneiden instanssien paikallisesti välimuistiin tallennetut muistiinpanot, haarat ja attribuutit. Profiilit ja istunnot pysyvät kirjautuneina. Palvelimen tietoihin tämä ei vaikuta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Baineann sé seo nótaí, craobhacha agus tréithe sa taisce áitiúil do gach cás sínithe isteach. Fanann próifílí agus seisiúin sínithe isteach. Ní dhéantar difear do shonraí an fhreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se uklanjaju lokalno predmemorirane bilješke, grane i atributi za svaku prijavljenu instancu. Profili i sesije ostaju prijavljeni. Podaci na poslužitelju nisu zahvaćeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja a helyileg gyorsítótárazott jegyzeteket, ágakat és attribútumokat minden bejelentkezett példány esetén. A profilok és munkamenetek bejelentkezve maradnak. A szerveren lévő adatokat ez nem érinti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono rimossi le note, i rami e gli attributi in cache locale per ogni istanza connessa. Profili e sessioni restano connessi. I dati sul server non vengono toccati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašalinamos visų prisijungtų egzempliorių talpykloje esančios pastabos, šakos ir atributai. Profiliai ir seansai lieka prisijungę. Serverio duomenims tai neturi įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek noņemtas lokāli kešotās piezīmes, zari un atribūti visām pierakstītajām instancēm. Profili un sesijas paliek pierakstīti. Servera dati netiek ietekmēti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan ineħħi n-noti, il-fergħat u l-attributi fil-cache lokali għal kull istanza illoggjata. Il-profili u s-sessjonijiet jibqgħu illoggjati. Id-data tas-server ma tintmessx."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie lokalnie przechowywanych notatek, gałęzi i atrybutów dla każdej zalogowanej instancji. Profile i sesje pozostaną zalogowane. Nie wpłynie to na dane na serwerze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove as notas, ramos e atributos em cache local de todas as instâncias com sessão iniciada. Os perfis e as sessões mantêm-se iniciados. Os dados do servidor não são afetados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină notițele, ramurile și atributele din cache-ul local pentru fiecare instanță conectată. Profilurile și sesiunile rămân conectate. Datele de pe server nu sunt afectate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto odstránite lokálne uložené poznámky, vetvy a atribúty všetkých prihlásených inštancií. Profily a relácie zostanú prihlásené. Dáta na serveri nie sú dotknuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem odstranite lokalno predpomnjene beležke, veje in atribute za vse prijavljene instance. Profili in seje ostanejo prijavljeni. Podatki na strežniku ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort lokalt cachelagrade anteckningar, grenar och attribut för alla inloggade instanser. Profiler och sessioner förblir inloggade. Data på servern påverkas inte."
          }
        }
      }
    },
    "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value.": {
      "comment": "Reset colors alert",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد السمة الافتراضية ويلغي الألوان المخصصة ويعيد كل لون إلى افتراضه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto obnovíte výchozí motiv zvýraznění, vypnete vlastní barvy aplikace a stromu a všechny vlastní barvy nastavíte na výchozí hodnoty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Standard-Akzentdesign wiederhergestellt, eigene App- und Baumfarben werden deaktiviert und jede eigene Farbe wird auf ihren Standardwert zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores the default accent theme, turns off custom app and tree colors, and resets every custom color to its default value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restaurará el tema de realce predeterminado, se desactivarán los colores personalizados de la app y del árbol, y cada color personalizado volverá a su valor predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action rétablit le thème d’accent par défaut, désactive les couleurs personnalisées de l’app et de l’arborescence, et réinitialise chaque couleur personnalisée à sa valeur par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट एक्सेंट थीम पुनर्स्थापित करता है, कस्टम रंग बंद करता है और सभी रंग रीसेट करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez visszaállítja az alapértelmezett kiemelőtémát, kikapcsolja az egyéni alkalmazás- és faszíneket, és minden egyéni színt alapértelmezett értékére állít vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene ripristinato il tema di contrasto predefinito, vengono disattivati i colori personalizzati di app e albero e ogni colore personalizzato torna al valore predefinito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt het standaardaccentthema hersteld, worden aangepaste app- en boomkleuren uitgeschakeld en wordt elke aangepaste kleur teruggezet naar de standaardwaarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to przywrócenie domyślnego motywu akcentu, wyłączenie własnych kolorów aplikacji i drzewa oraz zresetowanie każdego własnego koloru do wartości domyślnej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает тему акцента по умолчанию, отключает пользовательские цвета и сбрасывает все цвета."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това възстановява стандартната тема за акцент, изключва персонализираните цветове на приложението и дървото и връща всеки персонализиран цвят към стандартната му стойност."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gendanner standardaccenttemaet, slår tilpassede app- og træfarver fra og nulstiller alle tilpassede farver til deres standardværdi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το προεπιλεγμένο θέμα έμφασης, απενεργοποιεί τα προσαρμοσμένα χρώματα εφαρμογής και δέντρου και επαναφέρει κάθε προσαρμοσμένο χρώμα στην προεπιλεγμένη τιμή του."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See taastab vaikimisi rõhuvärvi teema, lülitab välja kohandatud rakenduse ja puu värvid ning lähtestab kõik kohandatud värvid vaikeväärtustele."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palauttaa oletuskorostusvärin, poistaa mukautetut sovelluksen ja puun värit käytöstä ja palauttaa kaikki mukautetut värit oletusarvoihin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athchóiríonn sé seo an téama aiceanta réamhshocraithe, casann sé as dathanna saincheaptha na haipe agus an chrainn, agus athshocraíonn sé gach dath saincheaptha go dtí a luach réamhshocraithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se vraća zadana tema isticanja, isključuju prilagođene boje aplikacije i stabla te se svaka prilagođena boja vraća na zadanu vrijednost."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkuriama numatytoji akcento tema, išjungiamos pasirinktinės programos ir medžio spalvos, o kiekviena pasirinktinė spalva atkuriama į numatytąją reikšmę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek atjaunots noklusējuma akcenta motīvs, izslēgtas pielāgotās lietotnes un koka krāsas un katra pielāgotā krāsa atiestatīta uz noklusējuma vērtību."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan jirrestawra t-tema ta’ enfasi default, jitfi l-kuluri personalizzati tal-app u tas-siġra, u jirrisettja kull kulur personalizzat għall-valur default tiegħu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto restaura o tema de destaque predefinido, desativa as cores personalizadas da app e da árvore e repõe todas as cores personalizadas no valor predefinido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește tema de accent implicită, dezactivează culorile personalizate ale aplicației și arborelui și resetează fiecare culoare personalizată la valoarea implicită."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto obnovíte predvolenú tému zvýraznenia, vypnete vlastné farby aplikácie a stromu a všetky vlastné farby nastavíte na predvolené hodnoty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem obnovite privzeto temo poudarka, izklopite barve aplikacije in drevesa po meri ter vse barve po meri ponastavite na privzete vrednosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta återställer standardaccenttemat, stänger av anpassade app- och trädfärger och återställer alla anpassade färger till standardvärdet."
          }
        }
      }
    },
    "This restores the default text, background, and selected-note colors for the tree. Custom Tree Colors stays on.": {
      "comment": "Settings alert: reset custom tree colors",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Standardfarben für Text, Hintergrund und ausgewählte Notiz im Baum wiederhergestellt. „Eigene Baumfarben“ bleibt aktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action rétablit les couleurs par défaut du texte, de l’arrière-plan et de la note sélectionnée dans l’arborescence. L’option « Couleurs personnalisées de l’arborescence » reste activée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de standaardkleuren voor tekst, achtergrond en geselecteerde notitie in de boom hersteld. “Aangepaste boomkleuren” blijft aan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това възстановява стандартните цветове на текста, фона и избраната бележка в дървото. „Персонализирани цветове на дървото“ остава включено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto obnovíte výchozí barvy textu, pozadí a vybrané poznámky ve stromu. Vlastní barvy stromu zůstanou zapnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gendanner standardfarverne for tekst, baggrund og valgt note i træet. Tilpassede træfarver forbliver slået til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει τα προεπιλεγμένα χρώματα κειμένου, φόντου και επιλεγμένης σημείωσης για το δέντρο. Τα «Προσαρμοσμένα χρώματα δέντρου» παραμένουν ενεργά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restaurarán los colores predeterminados de texto, fondo y nota seleccionada del árbol. «Colores del árbol personalizados» sigue activado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See taastab puu vaikimisi teksti-, tausta- ja valitud märkme värvid. Kohandatud puu värvid jäävad sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palauttaa puun oletusarvoiset teksti-, tausta- ja valitun muistiinpanon värit. Mukautetut puun värit ‑asetus pysyy päällä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athchóiríonn sé seo na dathanna réamhshocraithe téacs, cúlra agus nóta roghnaithe don chrann. Fanann Dathanna Saincheaptha Crainn air."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se vraćaju zadane boje teksta, pozadine i odabrane bilješke u stablu. „Prilagođene boje stabla” ostaju uključene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez visszaállítja a fa alapértelmezett szöveg-, háttér- és kijelöltjegyzet-színeit. Az „Egyéni faszínek” beállítás bekapcsolva marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono ripristinati i colori predefiniti di testo, sfondo e nota selezionata nell’albero. “Colori albero personalizzati” resta attivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkuriamos numatytosios medžio teksto, fono ir pasirinktos pastabos spalvos. Pasirinktinės medžio spalvos lieka įjungtos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek atjaunotas koka noklusējuma teksta, fona un atlasītās piezīmes krāsas. Pielāgotās koka krāsas paliek ieslēgtas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan jirrestawra l-kuluri default tat-test, tal-isfond u tan-nota magħżula għas-siġra. Kuluri Personalizzati tas-Siġra jibqa’ mixgħul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to przywrócenie domyślnych kolorów tekstu, tła i zaznaczonej notatki w drzewie. Opcja Własne kolory drzewa pozostanie włączona."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto restaura as cores predefinidas de texto, fundo e nota selecionada da árvore. «Cores da árvore personalizadas» mantém-se ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește culorile implicite de text, fundal și notiță selectată pentru arbore. „Culori de arbore personalizate” rămâne activat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto obnovíte predvolené farby textu, pozadia a vybranej poznámky v strome. Vlastné farby stromu zostanú zapnuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem obnovite privzete barve besedila, ozadja in izbrane beležke v drevesu. Možnost Barve drevesa po meri ostane vklopljena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta återställer standardfärgerna för text, bakgrund och markerad anteckning i trädet. Anpassade trädfärger förblir på."
          }
        }
      }
    },
    "This server does not support OCR. Trilium 0.103 or later is required.": {
      "comment": "OCR API missing (pre-0.103)",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server unterstützt keine OCR. Trilium 0.103 oder neuer ist erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge l’OCR. Trilium 0.103 ou ultérieur est requis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server ondersteunt geen OCR. Trilium 0.103 of nieuwer is vereist."
          }
        },
        "bg": {
          "stringUnit": {
