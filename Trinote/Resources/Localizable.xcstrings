          "stringUnit": {
            "state": "translated",
            "value": "लोड किए गए पाठ में कोई मिलान पंक्ति नहीं (पूर्वावलोकन सादा पाठ उपयोग करते हैं; बहुत लंबे नोट पृष्ठ-में खोज से थोड़ा भिन्न हो सकते हैं)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs egyező sor a betöltött szövegben (az előnézetek egyszerű szöveget használnak; nagyon hosszú jegyzeteknél kissé eltérhet az oldalon belüli kereséstől)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna riga corrispondente nel testo caricato (le anteprime usano testo semplice; le note molto lunghe possono differire leggermente dalla ricerca nella pagina)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen overeenkomende regels in de geladen tekst (voorvertoningen gebruiken platte tekst; erg lange notities kunnen iets afwijken van zoeken op de pagina)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pasujących wierszy we wczytanym tekście (podglądy używają zwykłego tekstu; w bardzo długich notatkach wyniki mogą się nieco różnić od wyszukiwania na stronie)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет совпадений в загруженном тексте (предпросмотры используют обычный текст; для очень длинных заметок возможны небольшие отличия от поиска на странице)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма съвпадащи редове в заредения текст (прегледите използват обикновен текст; много дълги бележки може леко да се различават от търсенето в страницата)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen matchende linjer i den indlæste tekst (forhåndsvisninger bruger ren tekst; meget lange noter kan afvige en smule fra søgning på siden)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία αντίστοιχη γραμμή στο φορτωμένο κείμενο (οι προεπισκοπήσεις χρησιμοποιούν απλό κείμενο· σε πολύ μεγάλες σημειώσεις μπορεί να διαφέρουν ελαφρώς από την εύρεση στη σελίδα)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laaditud tekstis pole sobivaid ridu (eelvaated kasutavad lihtteksti; väga pikkade märkmete puhul võib tulemus lehelt otsingust veidi erineda)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladatussa tekstissä ei ole vastaavia rivejä (esikatselut käyttävät pelkkää tekstiä; hyvin pitkissä muistiinpanoissa tulos voi poiketa hieman sivulta hausta)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon línte meaitseála sa téacs lódáilte (úsáideann réamhamhairc gnáth-théacs; d’fhéadfadh nótaí an-fhada a bheith beagán difriúil ón aimsiú ar an leathanach)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema podudarnih redaka u učitanom tekstu (pregledi koriste običan tekst; vrlo duge bilješke mogu se malo razlikovati od traženja na stranici)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įkeltame tekste atitinkančių eilučių nėra (peržiūrose naudojamas paprastas tekstas; labai ilgose pastabose rezultatai gali šiek tiek skirtis nuo paieškos puslapyje)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielādētajā tekstā nav atbilstošu rindu (priekšskatījumos izmanto vienkāršu tekstu; ļoti garām piezīmēm rezultāts var nedaudz atšķirties no meklēšanas lapā)."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ebda linja ma taqbel fit-test mgħobbi (il-previżjonijiet jużaw test sempliċi; noti twal ħafna jistgħu jvarjaw ftit mit-tiftix fil-paġna)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma linha correspondente no texto carregado (as pré-visualizações usam texto simples; notas muito longas podem diferir ligeiramente da pesquisa na página)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio linie potrivită în textul încărcat (previzualizările folosesc text simplu; la notițele foarte lungi pot diferi puțin de căutarea în pagină)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V načítanom texte nie sú žiadne zodpovedajúce riadky (náhľady používajú obyčajný text; pri veľmi dlhých poznámkach sa môžu mierne líšiť od hľadania na stránke)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V naloženem besedilu ni ujemajočih se vrstic (predogledi uporabljajo navadno besedilo; zelo dolge beležke se lahko nekoliko razlikujejo od iskanja na strani)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga matchande rader i den inlästa texten (förhandsvisningar använder oformaterad text; mycket långa anteckningar kan skilja sig något från sökning på sidan)."
          }
        }
      }
    },
