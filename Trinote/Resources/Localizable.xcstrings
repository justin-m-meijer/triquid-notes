    "Cards are put in a column per value of this label. Start with ~ to group by a relation.": {
      "comment": "Kanban group by typed label explanation",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توضع البطاقات في عمود لكل قيمة من قيم هذه التسمية. ابدأ بـ ~ للتجميع حسب علاقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty se rozdělí do sloupců podle hodnoty tohoto štítku. Začněte znakem ~ pro seskupení podle relace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten werden pro Wert dieses Labels in eine Spalte gelegt. Beginne mit ~, um nach einer Relation zu gruppieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards are put in a column per value of this label. Start with ~ to group by a relation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas se colocan en una columna por cada valor de esta etiqueta. Empieza con ~ para agrupar por una relación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes sont placées dans une colonne par valeur de cette étiquette. Commencez par ~ pour regrouper par relation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लेबल के हर मान के लिए कार्ड अलग कॉलम में रखे जाते हैं। किसी संबंध के अनुसार समूहित करने के लिए ~ से शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyák a címke minden értékéhez külön oszlopba kerülnek. Kapcsolat szerinti csoportosításhoz kezdje ~ jellel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede vengono messe in una colonna per ogni valore di questa etichetta. Inizia con ~ per raggruppare per relazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten worden in een kolom per waarde van dit label geplaatst. Begin met ~ om op een relatie te groeperen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty są umieszczane w osobnej kolumnie dla każdej wartości tej etykiety. Zacznij od ~, aby grupować według relacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки распределяются по столбцам по значениям этой метки. Начните с ~, чтобы группировать по связи."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Картите се поставят в колона според стойността на този етикет. Започнете с ~, за да групирате по релация."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort placeres i en kolonne pr. værdi af denne etiket. Start med ~ for at gruppere efter en relation."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κάρτες τοποθετούνται σε μια στήλη ανά τιμή αυτής της ετικέτας. Ξεκινήστε με ~ για ομαδοποίηση κατά σχέση."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaardid paigutatakse veergudesse selle sildi väärtuste järgi. Seose järgi rühmitamiseks alusta märgiga ~."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortit sijoitetaan sarakkeisiin tämän tunnisteen arvon mukaan. Ryhmittele relaation mukaan aloittamalla merkillä ~."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuirtear cártaí i gcolún do gach luach den lipéad seo. Tosaigh le ~ chun grúpáil de réir gaoil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice se smještaju u stupac prema vrijednosti ove oznake. Počnite s ~ da biste grupirali prema relaciji."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortelės dedamos į stulpelius pagal šios etiketės reikšmę. Pradėkite ~, kad grupuotumėte pagal ryšį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kārtis tiek izvietotas pa kolonnām pēc šīs etiķetes vērtības. Sāciet ar ~, lai grupētu pēc relācijas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kards jitqiegħdu f’kolonna għal kull valur ta’ din it-tikketta. Ibda b’~ biex tiġbor skont relazzjoni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões são colocados numa coluna por cada valor desta etiqueta. Comece com ~ para agrupar por uma relação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardurile sunt puse într-o coloană pentru fiecare valoare a acestei etichete. Începeți cu ~ pentru a grupa după o relație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty sa rozdelia do stĺpcov podľa hodnoty tohto štítku. Začnite znakom ~ na zoskupenie podľa relácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice se razvrstijo v stolpce po vrednostih te oznake. Za združevanje po relaciji začnite z ~."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort placeras i en kolumn per värde för den här etiketten. Börja med ~ för att gruppera efter en relation."
          }
        }
      }
    },
    "Cards that are also elsewhere in the tree are only taken off this board. The others are deleted with their subnotes.": {
      "comment": "Kanban delete selected cards explanation",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات الموجودة أيضًا في مكان آخر من الشجرة تُزال من هذه اللوحة فقط. أما البقية فتُحذف مع ملاحظاتها الفرعية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, které jsou i jinde ve stromu, se pouze odeberou z této tabule. Ostatní se smažou i s podřízenými poznámkami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten, die auch an anderer Stelle im Baum sind, werden nur von diesem Board entfernt. Die anderen werden mit ihren Unternotizen gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards that are also elsewhere in the tree are only taken off this board. The others are deleted with their subnotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas que también están en otras partes del árbol solo se quitan de este tablero. Las demás se eliminan junto con sus subnotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes présentes ailleurs dans l’arborescence sont uniquement retirées de ce tableau. Les autres sont supprimées avec leurs sous-notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कार्ड ट्री में कहीं और भी हैं, वे केवल इस बोर्ड से हटाए जाते हैं। बाकी अपने उप-नोट्स के साथ हटा दिए जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fa más részein is szereplő kártyák csak erről a tábláról kerülnek le. A többi az aljegyzeteivel együtt törlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede presenti anche altrove nell’albero vengono solo tolte da questa bacheca. Le altre vengono eliminate con le loro sottonote."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten die ook elders in de boom staan, worden alleen van dit bord gehaald. De andere worden met hun subnotities verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, które znajdują się także w innym miejscu drzewa, zostaną tylko zdjęte z tej tablicy. Pozostałe zostaną usunięte wraz z notatkami podrzędnymi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки, которые есть и в других местах дерева, только убираются с этой доски. Остальные удаляются вместе с подзаметками."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Картите, които са и на други места в дървото, само се премахват от това табло. Останалите се изтриват заедно с подбележките си."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort, der også findes andre steder i træet, fjernes kun fra denne tavle. De øvrige slettes sammen med deres undernoter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κάρτες που υπάρχουν και αλλού στο δέντρο αφαιρούνται μόνο από αυτόν τον πίνακα. Οι υπόλοιπες διαγράφονται μαζί με τις υποσημειώσεις τους."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaardid, mis on puus ka mujal, eemaldatakse ainult sellelt tahvlilt. Ülejäänud kustutatakse koos alammärkmetega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortit, jotka ovat myös muualla puussa, poistetaan vain tältä taululta. Muut poistetaan alamuistiinpanoineen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní bhaintear de chártaí atá in áit eile sa chrann ach an clár seo. Scriostar na cinn eile mar aon lena bhfo-nótaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice koje se nalaze i drugdje u stablu samo se uklanjaju s ove ploče. Ostale se brišu zajedno sa svojim podbilješkama."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortelės, esančios ir kitur medyje, tik pašalinamos iš šios lentos. Kitos ištrinamos kartu su antrinėmis pastabomis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kārtis, kas atrodas arī citur kokā, tiek tikai noņemtas no šīs tāfeles. Pārējās tiek dzēstas kopā ar apakšpiezīmēm."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kards li jinsabu wkoll x’imkien ieħor fis-siġra jitneħħew biss minn dan il-bord. L-oħrajn jitħassru flimkien mas-sottonoti tagħhom."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões que também estão noutro local da árvore são apenas retirados deste quadro. Os restantes são apagados juntamente com as subnotas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardurile care se află și în alte locuri din arbore sunt doar scoase de pe acest panou. Celelalte sunt șterse împreună cu subnotițele lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, ktoré sú aj inde v strome, sa len odstránia z tejto tabule. Ostatné sa vymažú aj s podradenými poznámkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice, ki so tudi drugje v drevesu, se le odstranijo s te table. Ostale se izbrišejo skupaj s podbeležkami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort som även finns på andra ställen i trädet tas bara bort från den här tavlan. De övriga raderas tillsammans med sina underanteckningar."
          }
        }
      }
    },
