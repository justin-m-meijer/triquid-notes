    "Notes are stored on this device only.": {
      "comment": "Settings: local notebook status",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen werden nur auf diesem Gerät gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sont stockées uniquement sur cet appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities worden alleen op dit apparaat bewaard."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките се съхраняват само на това устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky jsou uloženy pouze na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter gemmes kun på denne enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις αποθηκεύονται μόνο σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas se guardan solo en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkmed salvestatakse ainult sellesse seadmesse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot tallennetaan vain tähän laitteeseen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Stóráiltear nótaí ar an ngléas seo amháin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke se spremaju samo na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetek csak ezen az eszközön tárolódnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note sono salvate solo su questo dispositivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastabos saugomos tik šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmes tiek glabātas tikai šajā ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti huma maħżuna fuq dan l-apparat biss."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki są przechowywane tylko na tym urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas são guardadas apenas neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele sunt stocate doar pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky sú uložené len v tomto zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležke so shranjene samo v tej napravi."
          }
        },
        "sv": {
          "stringUnit": {
