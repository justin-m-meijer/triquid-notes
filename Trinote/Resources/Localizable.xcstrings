            "value": "لم تصل أحدث تغييراتك إلى الخادم بعد، لذا لن يتضمنها التصدير. حاول مرة أخرى بعد مزامنتها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poslední změny se ještě nedostaly na server, takže by v exportu chyběly. Zkuste to znovu po jejich synchronizaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzten Änderungen haben den Server noch nicht erreicht, daher würden sie im Export fehlen. Versuche es erneut, sobald sie synchronisiert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest changes haven't reached the server yet, so the export would miss them. Try again once they've synced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus últimos cambios aún no han llegado al servidor, así que la exportación no los incluiría. Inténtalo de nuevo cuando se hayan sincronizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dernières modifications n’ont pas encore atteint le serveur ; l’export ne les inclurait pas. Réessayez une fois qu’elles seront synchronisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हाल के बदलाव अभी सर्वर तक नहीं पहुँचे हैं, इसलिए निर्यात में वे नहीं आएँगे। सिंक होने के बाद फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi módosításai még nem érték el a szervert, így az exportból kimaradnának. Próbálja újra, miután szinkronizálódtak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime modifiche non hanno ancora raggiunto il server, quindi l’esportazione non le includerebbe. Riprova quando saranno sincronizzate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste wijzigingen staan nog niet op de server, dus de export zou ze missen. Probeer het opnieuw zodra ze zijn gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie zmiany nie dotarły jeszcze do serwera, więc eksport by ich nie zawierał. Spróbuj ponownie po ich synchronizacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние изменения ещё не дошли до сервера, поэтому экспорт их не учтёт. Повторите попытку после синхронизации."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Последните ви промени още не са достигнали сървъра, така че експортът няма да ги съдържа. Опитайте отново, след като се синхронизират."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine seneste ændringer er endnu ikke nået frem til serveren, så eksporten ville mangle dem. Prøv igen, når de er synkroniseret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τελευταίες σας αλλαγές δεν έχουν φτάσει ακόμα στον διακομιστή, οπότε η εξαγωγή δεν θα τις περιλάμβανε. Δοκιμάστε ξανά μόλις συγχρονιστούν."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu viimased muudatused pole veel serverisse jõudnud, seega jääksid need ekspordist välja. Proovi uuesti, kui need on sünkroonitud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisimmät muutoksesi eivät ole vielä palvelimella, joten ne puuttuisivat viennistä. Yritä uudelleen, kun ne on synkronoitu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor shroich d’athruithe is déanaí an freastalaí fós, mar sin d’fhágfadh an easpórtáil ar lár iad. Bain triail eile as nuair a bheidh siad sioncrónaithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše najnovije promjene još nisu stigle na poslužitelj pa ih izvoz ne bi sadržavao. Pokušajte ponovno kad se sinkroniziraju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų naujausi pakeitimai dar nepasiekė serverio, todėl eksportuojant jų trūktų. Bandykite dar kartą, kai jie bus sinchronizuoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu jaunākās izmaiņas vēl nav sasniegušas serveri, tāpēc eksportā tās nebūtu iekļautas. Mēģiniet vēlreiz, kad tās būs sinhronizētas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-aħħar bidliet tiegħek għadhom ma waslux fis-server, għalhekk l-esportazzjoni ma tinkludihomx. Erġa’ pprova ladarba jiġu sinkronizzati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas alterações mais recentes ainda não chegaram ao servidor, por isso a exportação não as incluiria. Tente novamente quando estiverem sincronizadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimele modificări nu au ajuns încă pe server, deci exportul nu le-ar include. Încercați din nou după ce se sincronizează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše posledné zmeny sa ešte nedostali na server, takže by v exporte chýbali. Skúste to znova po ich synchronizácii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zadnje spremembe še niso dosegle strežnika, zato jih izvoz ne bi vključeval. Poskusite znova, ko bodo sinhronizirane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina senaste ändringar har inte nått servern ännu, så exporten skulle sakna dem. Försök igen när de har synkroniserats."
          }
        }
      }
    },
    "Your location couldn't be found right now. Try again in a moment.": {
      "comment": "Geo map locate: no fix",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر العثور على موقعك الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši polohu teď nelze zjistit. Zkuste to znovu za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort konnte gerade nicht ermittelt werden. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location couldn't be found right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido encontrar tu ubicación ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver votre position pour le moment. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपका स्थान नहीं मिल सका। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyzete most nem határozható meg. Próbálja újra egy kis idő múlva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la tua posizione in questo momento. Riprova tra poco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie kan op dit moment niet worden gevonden. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz ustalić Twojej lokalizacji. Spróbuj ponownie za chwilę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить ваше местоположение. Повторите попытку чуть позже."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположението ви не може да бъде открито в момента. Опитайте отново след малко."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din lokalitet kunne ikke findes lige nu. Prøv igen om et øjeblik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο εντοπισμός της τοποθεσίας σας αυτή τη στιγμή. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu asukohta ei õnnestunud praegu leida. Proovi hetke pärast uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintiasi ei löydetty juuri nyt. Yritä hetken kuluttua uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir do shuíomh a aimsiú faoi láthair. Bain triail eile as i gceann nóiméid."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vašu lokaciju trenutačno nije moguće pronaći. Pokušajte ponovno za trenutak."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu nepavyko nustatyti jūsų buvimo vietos. Netrukus bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašlaik nevarēja noteikt jūsu atrašanās vietu. Pēc brīža mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-post tiegħek ma setax jinstab bħalissa. Erġa’ pprova ftit wara."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar a sua localização neste momento. Tente novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizarea nu a putut fi determinată acum. Încercați din nou peste puțin timp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vašu polohu teraz nie je možné zistiť. Skúste to znova o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše lokacije trenutno ni mogoče določiti. Poskusite znova čez trenutek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plats kunde inte hittas just nu. Försök igen om en stund."
          }
        }
      }
    },
    "Your notes are uploaded into a new folder on the server, next to what is already there. Nothing on the server is changed or overwritten.": {
      "comment": "Settings: what connecting a local notebook does",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen werden in einen neuen Ordner auf dem Server hochgeladen, neben dem bereits Vorhandenen. Auf dem Server wird nichts geändert oder überschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes sont téléversées dans un nouveau dossier sur le serveur, à côté de ce qui s’y trouve déjà. Rien n’est modifié ni écrasé sur le serveur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notities worden geüpload naar een nieuwe map op de server, naast wat er al staat. Er wordt niets op de server gewijzigd of overschreven."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките ви се качват в нова папка на сървъра, до вече съществуващото там. Нищо на сървъра не се променя или презаписва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poznámky se nahrají do nové složky na serveru vedle stávajícího obsahu. Na serveru se nic nezmění ani nepřepíše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine noter uploades til en ny mappe på serveren ved siden af det, der allerede er der. Intet på serveren ændres eller overskrives."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σας μεταφορτώνονται σε νέο φάκελο στον διακομιστή, δίπλα σε όσα υπάρχουν ήδη. Τίποτα στον διακομιστή δεν αλλάζει ούτε αντικαθίσταται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas se suben a una carpeta nueva en el servidor, junto a lo que ya hay. No se cambia ni se sobrescribe nada del servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu märkmed laaditakse serverisse uude kausta, olemasoleva sisu kõrvale. Serveris midagi ei muudeta ega kirjutata üle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi ladataan palvelimelle uuteen kansioon olemassa olevan sisällön rinnalle. Palvelimella mitään ei muuteta eikä korvata."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaslódáiltear do nótaí isteach i bhfillteán nua ar an bhfreastalaí, in aice leis an méid atá ann cheana. Ní athraítear ná ní fhorscríobhtar aon rud ar an bhfreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše bilješke prenose se u novu mapu na poslužitelju, pokraj onoga što je već ondje. Ništa se na poslužitelju ne mijenja niti prepisuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetei egy új mappába kerülnek fel a szerveren, a már meglévők mellé. A szerveren semmi sem módosul és semmi sem íródik felül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note vengono caricate in una nuova cartella sul server, accanto a ciò che c’è già. Nulla sul server viene modificato o sovrascritto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų pastabos įkeliamos į naują aplanką serveryje, šalia to, kas jau yra. Serveryje niekas nepakeičiama ir neperrašoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu piezīmes tiek augšupielādētas jaunā mapē serverī, blakus tam, kas tur jau ir. Serverī nekas netiek mainīts vai pārrakstīts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti tiegħek jittellgħu f’folder ġdid fuq is-server, ħdejn dak li diġà hemm. Xejn fuq is-server ma jinbidel jew jinkiteb fuqu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki zostaną przesłane do nowego folderu na serwerze, obok istniejącej zawartości. Nic na serwerze nie zostanie zmienione ani nadpisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas notas são enviadas para uma nova pasta no servidor, ao lado do que já lá está. Nada no servidor é alterado ou substituído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele sunt încărcate într-un dosar nou pe server, lângă ce există deja. Nimic de pe server nu este modificat sau suprascris."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poznámky sa nahrajú do nového priečinka na serveri vedľa existujúceho obsahu. Na serveri sa nič nezmení ani neprepíše."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše beležke se naložijo v novo mapo na strežniku, poleg obstoječe vsebine. Na strežniku se nič ne spremeni ali prepiše."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina anteckningar laddas upp till en ny mapp på servern, bredvid det som redan finns där. Inget på servern ändras eller skrivs över."
          }
        }
      }
    },
