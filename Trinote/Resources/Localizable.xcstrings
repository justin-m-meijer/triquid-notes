    "Offline — showing cached notes. Connect to refresh.": {
      "comment": "Banner when launch continues without server",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون اتصال — عرض الملاحظات المخبأة. اتصل للتحديث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – zobrazují se poznámky z mezipaměti. Pro obnovení se připojte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – zwischengespeicherte Notizen werden angezeigt. Verbinde dich zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — showing cached notes. Connect to refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: se muestran las notas en caché. Conéctate para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne — affichage des notes en cache. Connectez-vous pour actualiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन — कैश किए गए नोट दिख रहे हैं। ताज़ा करने के लिए कनेक्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – a gyorsítótárazott jegyzetek láthatók. A frissítéshez csatlakozzon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: vengono mostrate le note in cache. Connettiti per aggiornare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – bewaarde notities worden getoond. Maak verbinding om te vernieuwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — wyświetlane są notatki z pamięci podręcznej. Połącz się, aby odświeżyć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн — показаны кэшированные заметки. Подключитесь для обновления."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн – показват се кешираните бележки. Свържете се, за да обновите."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – viser noter i cache. Opret forbindelse for at opdatere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτός σύνδεσης — εμφανίζονται σημειώσεις από την κρυφή μνήμη. Συνδεθείτε για ανανέωση."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrguühenduseta – kuvatakse vahemälus olevad märkmed. Värskendamiseks loo ühendus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – näytetään välimuistin muistiinpanot. Päivitä muodostamalla yhteys."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "As líne — nótaí sa taisce á dtaispeáint. Ceangail chun athnuachan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvan mreže – prikazuju se predmemorirane bilješke. Povežite se za osvježavanje."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprisijungta – rodomos talpykloje esančios pastabos. Prisijunkite, kad atnaujintumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezsaistē — tiek rādītas kešotās piezīmes. Lai atsvaidzinātu, izveidojiet savienojumu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — qed jintwerew in-noti fil-cache. Qabbad biex taġġorna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — a mostrar notas em cache. Ligue-se para atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — se afișează notițele din cache. Conectați-vă pentru reîmprospătare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – zobrazujú sa poznámky z vyrovnávacej pamäte. Na obnovenie sa pripojte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez povezave – prikazane so predpomnjene beležke. Za osvežitev se povežite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – visar cachelagrade anteckningar. Anslut för att uppdatera."
          }
        }
      }
    },
