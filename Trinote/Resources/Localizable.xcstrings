          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a vászonjegyzetnek még nincs előnézete. Az előnézet létrehozásához nyissa meg a Trilium webes vagy asztali alkalmazásában."
          }
        },
        "it": {
