            "value": "Ez a szerver nem támogatja az OCR-t. Trilium 0.103 vagy újabb szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non supporta l’OCR. È richiesto Trilium 0.103 o successivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis serveris nepalaiko OCR. Reikia Trilium 0.103 arba naujesnės versijos."
          }
        },
        "lv": {
