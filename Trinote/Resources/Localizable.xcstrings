    "Switches to its dark version when Triquid Notes is in dark mode.": {
      "comment": "Geo map settings: light/dark style footer",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحول إلى نسخته الداكنة عندما يكون Triquid Notes في الوضع الداكن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepne se na tmavou verzi, když je Triquid Notes v tmavém režimu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zur dunklen Version, wenn Triquid Notes im dunklen Modus ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches to its dark version when Triquid Notes is in dark mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a su versión oscura cuando Triquid Notes está en modo oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à sa version sombre lorsque Triquid Notes est en mode sombre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Triquid Notes के डार्क मोड में होने पर इसका डार्क संस्करण दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötét változatra vált, amikor a Triquid Notes sötét módban van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa alla versione scura quando Triquid Notes è in modalità scura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt naar de donkere versie als Triquid Notes in donkere modus staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza się na wersję ciemną, gdy Triquid Notes jest w trybie ciemnym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключается на тёмный вариант, когда Triquid Notes в тёмном режиме."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превключва към тъмната си версия, когато Triquid Notes е в тъмен режим."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter til den mørke version, når Triquid Notes er i mørk tilstand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει στη σκούρα έκδοσή του όταν το Triquid Notes είναι σε σκούρα λειτουργία."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitub tumedale versioonile, kui Triquid Notes on tumedas režiimis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtuu tummaan versioon, kun Triquid Notes on tummassa tilassa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athraíonn sé go dtí a leagan dorcha nuair atá Triquid Notes i mód dorcha."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebacuje se na tamnu verziju kad je Triquid Notes u tamnom načinu rada."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Persijungia į tamsiąją versiją, kai Triquid Notes veikia tamsiuoju režimu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārslēdzas uz tumšo versiju, kad Triquid Notes ir tumšajā režīmā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaqleb għall-verżjoni skura tiegħu meta Triquid Notes ikun fil-modalità skura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda para a versão escura quando a Triquid Notes está no modo escuro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trece la varianta întunecată când Triquid Notes este în modul întunecat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepne sa na tmavú verziu, keď je Triquid Notes v tmavom režime."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je Triquid Notes v temnem načinu, preklopi na temno različico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter till den mörka versionen när Triquid Notes är i mörkt läge."
          }
        }
      }
