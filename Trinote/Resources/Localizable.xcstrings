    "Connect to the server to create today's journal note. Journals with week notes can't be added to offline.": {
      "comment": "Today's journal note offline under a journal with #enableWeekNote",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بالخادم لإنشاء ملاحظة يوميات اليوم. لا يمكن الإضافة دون اتصال إلى اليوميات التي تحتوي على ملاحظات أسبوعية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li vytvořit dnešní deníkovou poznámku, připojte se k serveru. Do deníků s týdenními poznámkami nelze přidávat offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Server, um die heutige Journalnotiz zu erstellen. Journale mit Wochennotizen können offline nicht ergänzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the server to create today's journal note. Journals with week notes can't be added to offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al servidor para crear la nota del diario de hoy. A los diarios con notas semanales no se les puede añadir nada sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au serveur pour créer la note de journal du jour. Les journaux avec notes de semaine ne peuvent pas être complétés hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का जर्नल नोट बनाने के लिए सर्वर से कनेक्ट करें। साप्ताहिक नोट्स वाले जर्नल में ऑफ़लाइन नहीं जोड़ा जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mai naplójegyzet létrehozásához csatlakozzon a szerverhez. Heti jegyzeteket használó naplókhoz offline nem lehet hozzáadni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti al server per creare la nota del diario di oggi. Ai diari con note settimanali non si possono aggiungere note offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met de server om de journaalnotitie van vandaag aan te maken. Journalen met weeknotities kunnen offline niet worden aangevuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z serwerem, aby utworzyć dzisiejszą notatkę dziennika. Do dzienników z notatkami tygodniowymi nie można dodawać w trybie offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу, чтобы создать сегодняшнюю заметку журнала. В журналы с недельными заметками нельзя добавлять офлайн."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете се със сървъра, за да създадете днешната бележка в дневника. Към дневници със седмични бележки не може да се добавя офлайн."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til serveren for at oprette dagens dagbogsnote. Dagbøger med ugenoter kan ikke udvides offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στον διακομιστή για να δημιουργήσετε τη σημερινή σημείωση ημερολογίου. Σε ημερολόγια με σημειώσεις εβδομάδας δεν γίνεται προσθήκη εκτός σύνδεσης."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänase päevikumärkme loomiseks loo ühendus serveriga. Nädalamärkmetega päevikutesse ei saa võrguühenduseta lisada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä palvelimeen luodaksesi tämän päivän päiväkirjamerkinnän. Viikkomuistiinpanoja käyttäviin päiväkirjoihin ei voi lisätä offline-tilassa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceangail leis an bhfreastalaí chun nóta dialainne an lae inniu a chruthú. Ní féidir dialanna le nótaí seachtaine a chur leo as líne."
          }
