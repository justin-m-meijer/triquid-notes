    "Each color has a light and a dark variant, so contrast holds in both themes.": {
      "comment": "Appearance: accent footer",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Farbe hat eine helle und eine dunkle Variante, damit der Kontrast in beiden Designs erhalten bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque couleur a une variante claire et une variante sombre pour garder le contraste dans les deux thèmes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke kleur heeft een lichte en een donkere variant, zodat het contrast in beide thema’s goed blijft."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки цвят има светъл и тъмен вариант, така че контрастът се запазва и в двете теми."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá barva má světlou a tmavou variantu, takže kontrast vydrží v obou motivech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver farve har en lys og en mørk variant, så kontrasten holder i begge temaer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε χρώμα έχει μια ανοιχτή και μια σκούρα παραλλαγή, ώστε η αντίθεση να διατηρείται και στα δύο θέματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada color tiene una variante clara y otra oscura, para que el contraste se mantenga en ambos temas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal värvil on hele ja tume variant, nii et kontrastsus säilib mõlemas teemas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella värillä on vaalea ja tumma versio, joten kontrasti säilyy molemmissa teemoissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá leagan geal agus leagan dorcha ag gach dath, ionas go seasann an chodarsnacht sa dá théama."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka boja ima svijetlu i tamnu varijantu pa kontrast ostaje dobar u obje teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden színnek van világos és sötét változata, így a kontraszt mindkét témában megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni colore ha una variante chiara e una scura, così il contrasto resta buono in entrambi i temi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena spalva turi šviesųjį ir tamsųjį variantą, todėl kontrastas išlieka abiejose temose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrai krāsai ir gaišais un tumšais variants, tāpēc kontrasts saglabājas abos motīvos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kull kulur għandu varjant ċar u wieħed skur, biex il-kuntrast jibqa’ tajjeb fiż-żewġ temi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy kolor ma wariant jasny i ciemny, więc kontrast jest zachowany w obu motywach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cor tem uma variante clara e uma escura, para manter o contraste em ambos os temas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare culoare are o variantă deschisă și una închisă, astfel încât contrastul se păstrează în ambele teme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá farba má svetlú a tmavú variantu, takže kontrast vydrží v oboch témach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka barva ima svetlo in temno različico, zato kontrast ostane v obeh temah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje färg har en ljus och en mörk variant, så kontrasten håller i båda teman."
          }
        }
      }
    },
