    "Empty slide — tap Edit to add content.": {
      "comment": "Presentation empty slide body",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Folie – tippe auf „Bearbeiten“, um Inhalte hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diapositive vide — touchez Modifier pour ajouter du contenu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege dia — tik op Wijzig om inhoud toe te voegen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Празен слайд – докоснете Редактирай, за да добавите съдържание."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdný snímek – obsah přidáte klepnutím na Upravit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomt dias – tryk på Rediger for at tilføje indhold."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κενή διαφάνεια — αγγίξτε «Επεξεργασία» για να προσθέσετε περιεχόμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diapositiva vacía: toca Editar para añadir contenido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühi slaid – sisu lisamiseks puuduta Muuda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjä dia – lisää sisältöä napauttamalla Muokkaa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleamhnán folamh — tapáil Cuir in eagar chun ábhar a chur leis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazan slajd – dodirnite Uredi za dodavanje sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üres dia – tartalom hozzáadásához koppintson a Szerkesztés gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide vuota: tocca Modifica per aggiungere contenuti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuščia skaidrė – bakstelėkite „Redaguoti“, kad pridėtumėte turinio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukšs slaids — pieskarieties Rediģēt, lai pievienotu saturu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slajd vojt — agħfas Editja biex iżżid kontenut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusty slajd — stuknij Edytuj, aby dodać zawartość."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diapositivo vazio — toque em Editar para adicionar conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diapozitiv gol — apăsați Editează pentru a adăuga conținut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdna snímka – obsah pridáte klepnutím na Upraviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazen diapozitiv – tapnite Uredi, da dodate vsebino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom bild – tryck på Redigera för att lägga till innehåll."
          }
        }
      }
