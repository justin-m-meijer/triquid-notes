          "stringUnit": {
            "state": "translated",
            "value": "Laadi alla ja salvesta vahemällu %lld märkmikku koos alammärkmetega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa ja tallenna välimuistiin %lld muistikirjaa alamuistiinpanoineen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Íoslódáil agus cuir i dtaisce %lld leabhar nótaí agus a bhfo-nótaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje i predmemoriranje bilježnica (%lld) i njihovih podbilješki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jegyzetfüzet és aljegyzeteik letöltése és gyorsítótárazása."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica e memorizza nella cache %lld taccuini e le loro sottonote."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsisiųsti ir įrašyti į talpyklą užrašų knygas (%lld) ir jų antrines pastabas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejupielādēt un kešot piezīmju grāmatas (%lld) un to apakšpiezīmes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niżżel u żomm fil-cache %lld notebook(s) u s-sottonoti tagħhom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz i zachowaj w pamięci podręcznej notesy (%lld) wraz z notatkami podrzędnymi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarregar e guardar em cache %lld caderno(s) e as respetivas subnotas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă și pune în cache %lld carnete și subnotițele lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahnuť a uložiť do vyrovnávacej pamäte zošity (%lld) a ich podradené poznámky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenesi in predpomni zvezke (%lld) ter njihove podbeležke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta och cachelagra %lld anteckningsbok/-böcker och deras underanteckningar."
          }
        }
      }
    },
