            "state": "translated",
            "value": "Lehel pole veel loetavat artiklit. Nõustu küpsiseteatega või oota, kuni leht on laaditud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivulla ei ole vielä luettavaa artikkelia. Hyväksy evästeilmoitus tai odota, että sivu latautuu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl alt inléite ar an leathanach fós. Glac leis an bhfógra fianán nó fan go mbeidh an leathanach lódáilte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranica još nema čitljiv članak. Prihvatite obavijest o kolačićima ili pričekajte da se stranica učita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldalon még nincs olvasható cikk. Fogadja el a sütikről szóló értesítést, vagy várjon, amíg az oldal betöltődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina non ha ancora un articolo leggibile. Accetta l’avviso sui cookie o attendi che la pagina sia caricata."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Puslapyje dar nėra įskaitomo straipsnio. Priimkite slapukų pranešimą arba palaukite, kol puslapis įsikels."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapā vēl nav salasāma raksta. Pieņemiet sīkfailu paziņojumu vai uzgaidiet, līdz lapa ir ielādēta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-paġna għad m’għandhiex artiklu li jinqara. Aċċetta l-avviż tal-cookies jew stenna sakemm il-paġna titgħabba."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona nie zawiera jeszcze czytelnego artykułu. Zaakceptuj powiadomienie o plikach cookie lub poczekaj, aż strona się wczyta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A página ainda não tem um artigo legível. Aceite o aviso de cookies ou aguarde até a página carregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina nu are încă un articol lizibil. Acceptați notificarea de cookie-uri sau așteptați să se încarce pagina."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stránka zatiaľ nemá čitateľný článok. Prijmite upozornenie na cookies alebo počkajte, kým sa stránka načíta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stran še nima berljivega članka. Sprejmite obvestilo o piškotkih ali počakajte, da se stran naloži."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidan har ingen läsbar artikel ännu. Godkänn cookiemeddelandet eller vänta tills sidan har lästs in."
          }
        }
      }
    },
