    "The order is kept in Trilium, so it’s the same on all your devices and in Trilium itself.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgorde staat in Trilium, dus die is op al je apparaten en in Trilium zelf hetzelfde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre est enregistré dans Trilium : il est le même sur tous vos appareils et dans Trilium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge liegt in Trilium und ist daher auf all deinen Geräten und in Trilium selbst gleich."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Редът се пази в Trilium, така че е еднакъв на всичките ви устройства и в самия Trilium."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořadí se ukládá v Trilium, takže je stejné na všech vašich zařízeních i v samotném Trilium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rækkefølgen gemmes i Trilium, så den er den samme på alle dine enheder og i selve Trilium."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σειρά αποθηκεύεται στο Trilium, οπότε είναι ίδια σε όλες τις συσκευές σας και στο ίδιο το Trilium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden se guarda en Trilium, así que es el mismo en todos tus dispositivos y en el propio Trilium."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestus säilitatakse Triliumis, nii et see on sama kõigis sinu seadmetes ja Triliumis endas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestys tallennetaan Triliumiin, joten se on sama kaikissa laitteissasi ja itse Triliumissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Coinnítear an t-ord in Trilium, mar sin tá sé mar an gcéanna ar do ghléasanna go léir agus in Trilium féin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redoslijed se čuva u Triliumu pa je jednak na svim vašim uređajima i u samom Triliumu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sorrendet a Trilium tárolja, így minden eszközén és magában a Triliumban is ugyanaz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordine è salvato in Trilium, quindi è lo stesso su tutti i tuoi dispositivi e in Trilium stesso."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvarka saugoma Trilium, todėl ji tokia pati visuose jūsų įrenginiuose ir pačiame Trilium."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Secība tiek saglabāta Trilium, tāpēc tā ir vienāda visās jūsu ierīcēs un pašā Trilium."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ordni jinżamm fi Trilium, għalhekk huwa l-istess fuq l-apparati kollha tiegħek u fi Trilium innifsu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność jest przechowywana w Trilium, więc jest taka sama na wszystkich Twoich urządzeniach i w samym Trilium."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem é guardada no Trilium, por isso é a mesma em todos os seus dispositivos e no próprio Trilium."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinea este păstrată în Trilium, deci este aceeași pe toate dispozitivele dvs. și în Trilium."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poradie sa ukladá v Trilium, takže je rovnaké vo všetkých vašich zariadeniach aj v samotnom Trilium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstni red se hrani v Triliumu, zato je enak v vseh vaših napravah in v samem Triliumu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordningen sparas i Trilium, så den är densamma på alla dina enheter och i Trilium."
          }
        }
      }
    },
