    "Place search isn't available right now. Check your connection and try again.": {
      "comment": "Geo map search failed",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن الأماكن غير متاح الآن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání míst teď není k dispozici. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ortssuche ist gerade nicht verfügbar. Überprüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place search isn't available right now. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda de lugares no está disponible ahora mismo. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de lieux n’est pas disponible pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान खोज अभी उपलब्ध नहीं है। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helykeresés jelenleg nem érhető el. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca di luoghi non è al momento disponibile. Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatsen zoeken is nu niet beschikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie miejsc jest teraz niedostępne. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск мест сейчас недоступен. Проверьте подключение и повторите попытку."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търсенето на места не е налично в момента. Проверете връзката и опитайте отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning efter steder er ikke tilgængelig lige nu. Tjek din forbindelse, og prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση τοποθεσιών δεν είναι διαθέσιμη αυτή τη στιγμή. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohtade otsing pole praegu saadaval. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikkahaku ei ole juuri nyt käytettävissä. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl cuardach áiteanna ar fáil faoi láthair. Seiceáil do cheangal agus bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretraživanje mjesta trenutačno nije dostupno. Provjerite vezu i pokušajte ponovno."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietų paieška šiuo metu negalima. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietu meklēšana pašlaik nav pieejama. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tiftix tal-postijiet mhux disponibbli bħalissa. Iċċekkja l-konnessjoni tiegħek u erġa’ pprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa de locais não está disponível neste momento. Verifique a ligação e tente novamente."
