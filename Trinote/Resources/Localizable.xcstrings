    "Reorder List Items shows drag handles on bullet, numbered, and checkbox list rows so you can reorder them without opening the editor.": {
      "comment": "Settings footer: Reorder List Items",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Listenelemente neu anordnen“ zeigt Ziehpunkte an Aufzählungs-, nummerierten und Checklisten, damit du sie ohne Editor neu anordnen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réorganiser les éléments de liste » affiche des poignées sur les listes à puces, numérotées et à cocher pour les réorganiser sans ouvrir l’éditeur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Orden lijstonderdelen' toont greepjes bij opsommings-, genummerde en aankruislijsten, zodat je ze kunt herschikken zonder de editor te openen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Пренареждане на елементите в списъци“ показва дръжки за плъзгане на редовете в списъци с водещи символи, номерирани списъци и списъци с отметки, за да ги пренареждате, без да отваряте редактора."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řazení položek seznamu zobrazí úchyty na řádcích odrážkových, číslovaných a zaškrtávacích seznamů, takže je můžete přeuspořádat bez otevření editoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omarranger listeelementer viser trækhåndtag på punktopstillinger, nummererede lister og tjeklister, så du kan ændre rækkefølgen uden at åbne editoren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Αναδιάταξη στοιχείων λίστας» εμφανίζει λαβές μεταφοράς στις γραμμές λιστών με κουκκίδες, αρίθμηση και πλαίσια ελέγχου, ώστε να τις αναδιατάσσετε χωρίς να ανοίξετε το πρόγραμμα επεξεργασίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reordenar elementos de listas» muestra tiradores en las filas de las listas con viñetas, numeradas y de casillas, para que puedas reordenarlas sin abrir el editor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjesta loendi üksused ümber kuvab täpp-, nummerdatud ja märkeruuduga loendi ridadel lohistamispidemed, et saaksid neid ümber järjestada ilma redaktorit avamata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä luettelon kohteet näyttää vetokahvat luettelomerkki-, numero- ja valintaruutuluetteloiden riveillä, jotta voit järjestää ne avaamatta editoria."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le “Athordaigh Míreanna Liosta”, taispeántar hanlaí tarraingthe ar shraitheanna liostaí urchar, uimhrithe agus ticbhosca ionas gur féidir leat iad a athordú gan an t-eagarthóir a oscailt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Promjena redoslijeda stavki popisa” prikazuje ručke za povlačenje na recima popisa s grafičkim oznakama, numeriranih popisa i popisa s potvrdnim okvirima kako biste ih mogli preslagivati bez otvaranja uređivača."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Listaelemek átrendezése” fogantyúkat jelenít meg a felsorolásos, számozott és jelölőnégyzetes listák sorainál, így a szerkesztő megnyitása nélkül átrendezheti őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Riordina elementi degli elenchi” mostra le maniglie di trascinamento sulle righe degli elenchi puntati, numerati e di controllo, così puoi riordinarle senza aprire l’editor."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši parinktis rodo vilkimo rankenėles ženklinamųjų, numeruotųjų ir žymimųjų langelių sąrašų eilutėse, kad galėtumėte jas pertvarkyti neatidarę redaktoriaus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī opcija rāda vilkšanas turus aizzīmju, numurētu un izvēles rūtiņu sarakstu rindās, lai varētu mainīt to secību, neatverot redaktoru."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Erġa’ Ordna l-Elementi tal-Lista” turi manki tal-kaxkir fuq ir-ringieli tal-listi b’bullets, bin-numri u b’kaxxi tal-immarkar biex tkun tista’ terġa’ tordnahom mingħajr ma tiftaħ l-editur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Zmiana kolejności elementów listy” pokazuje uchwyty przy wierszach list punktowanych, numerowanych i list kontrolnych, dzięki czemu można zmieniać ich kolejność bez otwierania edytora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reordenar itens de lista» mostra pegas de arrasto nas linhas de listas com marcas, numeradas e de verificação, para as reordenar sem abrir o editor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Reordonare elemente listă” afișează mânere de tragere pe rândurile listelor cu buline, numerotate și cu casete de bifat, ca să le puteți reordona fără a deschide editorul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoraďovanie položiek zoznamu zobrazí úchyty na riadkoch odrážkových, číslovaných a zaškrtávacích zoznamov, takže ich môžete preusporiadať bez otvorenia editora."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnost Razvrščanje elementov seznama prikaže ročice za vlečenje na vrsticah označenih, oštevilčenih in kontrolnih seznamov, da jih lahko razvrstite brez odpiranja urejevalnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra ordning på listobjekt visar draghandtag på punktlistor, numrerade listor och checklistor så att du kan ändra ordningen utan att öppna redigeraren."
          }
        }
      }
    },
