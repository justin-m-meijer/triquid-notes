        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR heeft geen leesbare tekst gevonden. De afbeelding heeft mogelijk weinig contrast of betrouwbaarheid."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR не извлече четим текст. Изображението може да е с нисък контраст или ниска увереност."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR nerozpoznalo čitelný text. Obrázek může mít nízký kontrast nebo spolehlivost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR fandt ingen læsbar tekst. Billedet har muligvis lav kontrast eller sikkerhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η OCR δεν εξήγαγε αναγνώσιμο κείμενο. Η εικόνα μπορεί να έχει χαμηλή αντίθεση ή αξιοπιστία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El OCR no ha extraído texto legible. Puede que la imagen tenga poco contraste o fiabilidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR ei eraldanud loetavat teksti. Pildi kontrastsus või tuvastuskindlus võib olla madal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstintunnistus ei löytänyt luettavaa tekstiä. Kuvan kontrasti tai tunnistusvarmuus voi olla heikko."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor asbhain OCR téacs inléite. D’fhéadfadh codarsnacht nó muinín íseal a bheith ag an íomhá."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR nije izdvojio čitljiv tekst. Slika možda ima nizak kontrast ili nisku pouzdanost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az OCR nem talált olvasható szöveget. Lehet, hogy a kép kontrasztja vagy a felismerés megbízhatósága alacsony."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’OCR non ha estratto testo leggibile. L’immagine potrebbe avere poco contrasto o affidabilità."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR neištraukė įskaitomo teksto. Vaizdo kontrastas ar patikimumas gali būti per maži."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR neizvilka salasāmu tekstu. Attēlam var būt zems kontrasts vai ticamība."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-OCR ma estratta l-ebda test li jinqara. L-immaġni jista’ jkollha kuntrast jew kunfidenza baxxa."
          }
        },
        "pl": {
          "stringUnit": {
