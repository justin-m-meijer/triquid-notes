    "Inbox is the note labeled #inbox, or a top-level note named Inbox. Without one, notes go to today's journal note.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صندوق الوارد هو الملاحظة ذات الوسم #inbox، أو ملاحظة من المستوى الأعلى باسم صندوق الوارد. بدونه تذهب الملاحظات إلى ملاحظة يومية اليوم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входящи е бележката с етикет #inbox или бележка от най-високо ниво с име Входящи. Без нея бележките отиват в днешната бележка от дневника."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené jsou poznámka se štítkem #inbox nebo poznámka nejvyšší úrovně s názvem Doručené. Bez nich poznámky putují do dnešní poznámky deníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indbakken er noten med etiketten #inbox eller en note på øverste niveau med navnet Indbakke. Uden en havner noter i dagens journalnote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eingang ist die Notiz mit dem Label #inbox oder eine Notiz der obersten Ebene namens Eingang. Ohne sie landen Notizen in der heutigen Journalnotiz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Εισερχόμενα είναι η σημείωση με ετικέτα #inbox ή μια σημείωση ανώτατου επιπέδου με όνομα Εισερχόμενα. Χωρίς αυτά, οι σημειώσεις πηγαίνουν στη σημερινή σημείωση ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox is the note labeled #inbox, or a top-level note named Inbox. Without one, notes go to today's journal note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja de entrada es la nota etiquetada como #inbox, o una nota de nivel superior llamada Bandeja de entrada. Sin ella, las notas van a la nota de diario de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisendkaust on märge sildiga #inbox või ülemise taseme märge nimega Sisendkaust. Ilma selleta lähevad märkmed tänasesse päevikumärkmesse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saapuneet on muistiinpano, jolla on tunniste #inbox, tai ylimmän tason muistiinpano nimeltä Saapuneet. Ilman sitä muistiinpanot menevät tämän päivän päiväkirjamuistiinpanoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boîte de réception est la note étiquetée #inbox, ou une note de premier niveau nommée Boîte de réception. Sans elle, les notes vont dans la note de journal du jour."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is é an Bosca Isteach an nóta a bhfuil an chlib #inbox air, nó nóta barrleibhéil darb ainm Bosca Isteach. Gan ceann, téann nótaí chuig nóta dialainne an lae inniu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनबॉक्स वह नोट है जिस पर #inbox लेबल है, या इनबॉक्स नाम का शीर्ष-स्तरीय नोट। इसके बिना नोट आज के जर्नल नोट में जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulazni pretinac je bilješka s oznakom #inbox ili bilješka najviše razine pod nazivom Ulazni pretinac. Bez njega bilješke idu u današnju bilješku dnevnika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beérkezők a #inbox címkéjű jegyzet, vagy egy Beérkezők nevű legfelső szintű jegyzet. Enélkül a jegyzetek a mai naplójegyzetbe kerülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox è la nota con l’etichetta #inbox, o una nota di primo livello chiamata Inbox. Senza, le note vanno nella nota del diario di oggi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gautieji yra užrašas su žyma #inbox arba aukščiausio lygio užrašas pavadinimu Gautieji. Be jų užrašai patenka į šiandienos dienoraščio užrašą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iesūtne ir piezīme ar etiķeti #inbox vai augstākā līmeņa piezīme ar nosaukumu Iesūtne. Bez tās piezīmes nonāk šodienas dienasgrāmatas piezīmē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-Inbox hija n-nota bit-tikketta #inbox, jew nota ta’ livell għoli bl-isem Inbox. Mingħajrha, in-noti jmorru fin-nota tal-ġurnal ta’ llum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inbox is de notitie met het label #inbox, of een notitie op het hoogste niveau met de naam Inbox. Zonder inbox komen notities in de journaalnotitie van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrzynka odbiorcza to notatka z etykietą #inbox lub notatka najwyższego poziomu o nazwie Skrzynka odbiorcza. Bez niej notatki trafiają do dzisiejszej notatki dziennika."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Caixa de entrada é a nota com a etiqueta #inbox, ou uma nota de nível superior chamada Caixa de entrada. Sem ela, as notas vão para a nota do diário de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox este nota etichetată #inbox sau o notă de nivel superior numită Inbox. Fără el, notele merg în nota de jurnal de azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Входящие» — это заметка с меткой #inbox или заметка верхнего уровня с названием «Входящие». Без неё заметки попадают в сегодняшнюю заметку журнала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené sú poznámka so štítkom #inbox alebo poznámka najvyššej úrovne s názvom Doručené. Bez nich poznámky idú do dnešnej poznámky denníka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejeto je beležka z oznako #inbox ali beležka najvišje ravni z imenom Prejeto. Brez nje beležke končajo v današnji beležki dnevnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkorgen är anteckningen med etiketten #inbox, eller en anteckning på toppnivå med namnet Inkorg. Utan den hamnar anteckningar i dagens journalanteckning."
          }
        }
      }
    },
