    "Sub-notes appear here. Long-press the map to add a location.": {
      "comment": "Geo map: empty sub-note list hint below map",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unternotizen erscheinen hier. Drücke lange auf die Karte, um einen Ort hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-notes apparaissent ici. Touchez longuement la carte pour ajouter un lieu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subnotities verschijnen hier. Houd de kaart ingedrukt om een locatie toe te voegen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбележките се появяват тук. Задръжте върху картата, за да добавите местоположение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí podpoznámky. Místo přidáte podržením prstu na mapě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undernoter vises her. Hold fingeren på kortet for at tilføje en lokalitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υποσημειώσεις εμφανίζονται εδώ. Πατήστε παρατεταμένα στον χάρτη για να προσθέσετε τοποθεσία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subnotas aparecen aquí. Mantén pulsado el mapa para añadir una ubicación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alammärkmed kuvatakse siin. Asukoha lisamiseks vajuta pikalt kaardile."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamuistiinpanot näkyvät tässä. Lisää sijainti painamalla karttaa pitkään."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeántar fo-nótaí anseo. Brúigh go fada ar an léarscáil chun suíomh a chur leis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podbilješke se pojavljuju ovdje. Dugo pritisnite kartu da biste dodali lokaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aljegyzetek itt jelennek meg. Hely hozzáadásához nyomja meg hosszan a térképet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sottonote appaiono qui. Tieni premuto sulla mappa per aggiungere una posizione."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia rodomos antrinės pastabos. Norėdami pridėti vietą, palaikykite paspaudę žemėlapį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit parādās apakšpiezīmes. Lai pievienotu atrašanās vietu, turiet nospiestu karti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-sottonoti jidhru hawn. Agħfas fit-tul fuq il-mappa biex iżżid post."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się notatki podrzędne. Przytrzymaj mapę, aby dodać miejsce."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As subnotas aparecem aqui. Mantenha o mapa premido para adicionar uma localização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subnotițele apar aici. Apăsați lung pe hartă pentru a adăuga o locație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia podpoznámky. Miesto pridáte podržaním prsta na mape."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukaj so prikazane podbeležke. Za dodajanje lokacije pridržite zemljevid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Underanteckningar visas här. Håll ned på kartan för att lägga till en plats."
          }
        }
      }
    },
