    "This signs out and removes this server's cached notes and saved session from this device. Data on the server is not deleted.": {
      "comment": "Settings: disconnect message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wirst du abgemeldet und die zwischengespeicherten Notizen sowie die gesicherte Sitzung dieses Servers werden von diesem Gerät entfernt. Daten auf dem Server werden nicht gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action vous déconnecte et supprime de cet appareil les notes en cache et la session enregistrée de ce serveur. Les données du serveur ne sont pas supprimées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee log je uit en worden de bewaarde notities en de opgeslagen sessie van deze server van dit apparaat verwijderd. Gegevens op de server worden niet verwijderd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ви отписва и премахва кешираните бележки и запазената сесия на този сървър от това устройство. Данните на сървъра не се изтриват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se odhlásíte a z tohoto zařízení se odstraní poznámky tohoto serveru v mezipaměti a uložená relace. Data na serveru se nesmažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger ud og fjerner serverens cachelagrede noter og gemte session fra denne enhed. Data på serveren slettes ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό σας αποσυνδέει και αφαιρεί τις σημειώσεις της κρυφής μνήμης και την αποθηκευμένη συνεδρία αυτού του διακομιστή από αυτή τη συσκευή. Τα δεδομένα στον διακομιστή δεν διαγράφονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión y se eliminarán de este dispositivo las notas en caché y la sesión guardada de este servidor. Los datos del servidor no se eliminan."
          }
