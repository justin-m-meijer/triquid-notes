        }
      }
    },
    "Autosave has already saved some of your edits. Discarding puts the note back the way it was when you started editing.": {
      "comment": "Alert message: Cancel Editing after Autosave already saved some edits",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ الحفظ التلقائي بعض تعديلاتك بالفعل. عند التجاهل تعود الملاحظة كما كانت عندما بدأت تحريرها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické ukládání již některé vaše úpravy uložilo. Zahozením vrátíte poznámku do stavu, v jakém byla na začátku úprav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch sichern hat bereits einige deiner Änderungen gesichert. Beim Verwerfen wird die Notiz auf den Stand zurückgesetzt, den sie zu Beginn der Bearbeitung hatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autosave has already saved some of your edits. Discarding puts the note back the way it was when you started editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado automático ya ha guardado algunos de tus cambios. Si los descartas, la nota volverá a estar como cuando empezaste a editarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement automatique a déjà enregistré certaines de vos modifications. Les annuler rétablit la note telle qu’elle était au début de la modification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोसेव आपके कुछ बदलाव पहले ही सहेज चुका है। छोड़ने पर नोट वैसा ही हो जाएगा जैसा संपादन शुरू करते समय था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus mentés már elmentette néhány módosítását. Az elvetéssel a jegyzet visszaáll arra az állapotra, amelyben a szerkesztés megkezdésekor volt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio automatico ha già salvato alcune modifiche. Se le annulli, la nota torna com’era quando hai iniziato a modificarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch bewaren heeft al een deel van je wijzigingen bewaard. Als je ze weggooit, wordt de notitie teruggezet naar hoe die was toen je begon met bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autozapis zachował już część Twoich zmian. Odrzucenie przywróci notatkę do stanu sprzed rozpoczęcia edycji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автосохранение уже сохранило часть ваших изменений. Если их отменить, заметка вернётся к состоянию на момент начала редактирования."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичното запазване вече е запазило част от промените ви. Отхвърлянето връща бележката в състоянието ѝ преди началото на редактирането."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem automatisk har allerede gemt nogle af dine ændringer. Hvis du kasserer dem, sættes noten tilbage til, som den var, da du begyndte at redigere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Αυτόματη αποθήκευση έχει ήδη αποθηκεύσει μερικές από τις αλλαγές σας. Η απόρριψη επαναφέρει τη σημείωση όπως ήταν όταν ξεκινήσατε την επεξεργασία."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatne salvestamine on osa muudatustest juba salvestanud. Loobumine taastab märkme sellisena, nagu see oli muutmise alguses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen tallennus on jo tallentanut osan muutoksistasi. Hylkääminen palauttaa muistiinpanon siihen tilaan, jossa se oli muokkauksen alkaessa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá cuid de d’eagarthóireacht sábháilte ag an Uathshábháil cheana. Má chuirtear i leataobh iad, cuirfear an nóta ar ais mar a bhí sé nuair a thosaigh tú ag eagarthóireacht."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko spremanje već je spremilo dio vaših izmjena. Odbacivanjem se bilješka vraća u stanje u kojem je bila kad ste počeli uređivati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatinis įrašymas jau išsaugojo dalį jūsų pakeitimų. Atmetus pastaba grąžinama į būseną, kokia buvo pradėjus redaguoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automātiskā saglabāšana jau ir saglabājusi daļu jūsu labojumu. Atmetot piezīme tiek atjaunota tādā stāvoklī, kāda tā bija, kad sākāt rediģēt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-salvataġġ awtomatiku diġà salva xi wħud mill-bidliet tiegħek. Jekk twarrabhom, in-nota terġa’ lura kif kienet meta bdejt teditja."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação automática já guardou algumas das suas alterações. Descartar repõe a nota tal como estava quando começou a editar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea automată a salvat deja o parte din modificări. Renunțarea readuce notița la starea în care era când ați început editarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické ukladanie už niektoré vaše úpravy uložilo. Zahodením vrátite poznámku do stavu, v akom bola na začiatku úprav."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno shranjevanje je nekatere spremembe že shranilo. Če zavržete, se beležka povrne v stanje, kot je bilo ob začetku urejanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara automatiskt har redan sparat några av dina ändringar. Om du slänger dem återställs anteckningen till hur den var när du började redigera."
          }
        }
      }
    },
    "Autosave saves your changes a few seconds after you stop typing, and when you leave the note, without closing the editor.": {
      "comment": "Settings footer: Autosave",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الحفظ التلقائي تغييراتك بعد بضع ثوانٍ من توقفك عن الكتابة وعند مغادرة الملاحظة، دون إغلاق المحرر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické ukládání uloží změny několik sekund poté, co přestanete psát, a při opuštění poznámky, aniž by se zavřel editor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch sichern sichert deine Änderungen einige Sekunden, nachdem du aufhörst zu tippen, und wenn du die Notiz verlässt, ohne den Editor zu schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autosave saves your changes a few seconds after you stop typing, and when you leave the note, without closing the editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado automático guarda tus cambios unos segundos después de que dejes de escribir y al salir de la nota, sin cerrar el editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement automatique enregistre vos modifications quelques secondes après que vous arrêtez de taper, ainsi que lorsque vous quittez la note, sans fermer l’éditeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोसेव आपके टाइप करना बंद करने के कुछ सेकंड बाद और नोट छोड़ते समय आपके बदलाव सहेजता है, संपादक बंद किए बिना।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus mentés néhány másodperccel a gépelés abbahagyása után, illetve a jegyzet elhagyásakor menti a módosításokat, a szerkesztő bezárása nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio automatico salva le modifiche alcuni secondi dopo che smetti di scrivere e quando esci dalla nota, senza chiudere l’editor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch bewaren bewaart je wijzigingen een paar seconden nadat je stopt met typen, en wanneer je de notitie verlaat, zonder de editor te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autozapis zachowuje zmiany kilka sekund po zakończeniu pisania oraz po opuszczeniu notatki, bez zamykania edytora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автосохранение сохраняет изменения через несколько секунд после того, как вы перестали печатать, и при выходе из заметки, не закрывая редактор."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичното запазване записва промените няколко секунди след като спрете да пишете и когато напуснете бележката, без да затваря редактора."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem automatisk gemmer dine ændringer et par sekunder efter, du holder op med at skrive, og når du forlader noten, uden at lukke editoren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Αυτόματη αποθήκευση αποθηκεύει τις αλλαγές σας λίγα δευτερόλεπτα αφού σταματήσετε να πληκτρολογείτε και όταν φεύγετε από τη σημείωση, χωρίς να κλείνει το πρόγραμμα επεξεργασίας."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatne salvestamine salvestab muudatused mõni sekund pärast trükkimise lõpetamist ning märkmest lahkumisel, ilma redaktorit sulgemata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen tallennus tallentaa muutoksesi muutama sekunti kirjoittamisen lopettamisen jälkeen sekä muistiinpanosta poistuttaessa, sulkematta editoria."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sábhálann an Uathshábháil d’athruithe cúpla soicind tar éis duit stopadh ag clóscríobh, agus nuair a fhágann tú an nóta, gan an t-eagarthóir a dhúnadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko spremanje sprema vaše izmjene nekoliko sekundi nakon što prestanete tipkati i kad napustite bilješku, bez zatvaranja uređivača."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatinis įrašymas išsaugo pakeitimus praėjus kelioms sekundėms po to, kai nustojate rašyti, ir išeinant iš pastabos, neuždarant redaktoriaus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automātiskā saglabāšana saglabā izmaiņas dažas sekundes pēc tam, kad pārtraucat rakstīt, un kad aizverat piezīmi, neaizverot redaktoru."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-salvataġġ awtomatiku jsalva l-bidliet tiegħek ftit sekondi wara li tieqaf tittajpja, u meta toħroġ min-nota, mingħajr ma jagħlaq l-editur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação automática guarda as alterações alguns segundos depois de parar de escrever e quando sai da nota, sem fechar o editor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea automată salvează modificările la câteva secunde după ce încetați să tastați și când părăsiți notița, fără a închide editorul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické ukladanie uloží zmeny niekoľko sekúnd potom, čo prestanete písať, a pri opustení poznámky bez zatvorenia editora."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno shranjevanje shrani spremembe nekaj sekund po tem, ko nehate tipkati, in ko zapustite beležko, ne da bi zaprlo urejevalnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara automatiskt sparar dina ändringar några sekunder efter att du slutat skriva och när du lämnar anteckningen, utan att stänga redigeraren."
          }
        }
      }
    },
