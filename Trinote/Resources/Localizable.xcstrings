    "Inbox and Today need a connection to the server.": {
      "comment": "Favorites: fixed entry while offline",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingang und Heute benötigen eine Verbindung zum Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boîte de réception et Aujourd’hui nécessitent une connexion au serveur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox en Vandaag vereisen een verbinding met de server."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входящи и Днес изискват връзка със сървъра."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené a Dnes vyžadují připojení k serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indbakke og I dag kræver en forbindelse til serveren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Εισερχόμενα και το Σήμερα απαιτούν σύνδεση στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandeja de entrada y Hoy requieren conexión con el servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisendkaust ja Täna vajavad ühendust serveriga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saapuneet ja Tänään vaativat yhteyden palvelimeen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn ceangal leis an bhfreastalaí don Bhosca Isteach agus don Lá Inniu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za Ulazni pretinac i Danas potrebna je veza s poslužiteljem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beérkezőkhöz és a Mához kapcsolat szükséges a szerverrel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox e Oggi richiedono una connessione al server."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gautiesiems ir Šiandienai reikia ryšio su serveriu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iesūtnei un Šodienai nepieciešams savienojums ar serveri."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox u Illum jeħtieġu konnessjoni mas-server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrzynka odbiorcza i Dzisiaj wymagają połączenia z serwerem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Caixa de entrada e Hoje requerem ligação ao servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox și Azi necesită o conexiune la server."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doručené a Dnes vyžadujú pripojenie k serveru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za Prejeto in Danes potrebujete povezavo s strežnikom."
          }
        },
