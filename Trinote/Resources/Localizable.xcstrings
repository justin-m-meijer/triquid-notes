    "Unlock the note to preview matches in the body.": {
      "comment": "Search expansion when protected session is locked",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح قفل الملاحظة لمعاينة التطابقات في المحتوى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zobrazit shody v textu, odemkněte poznámku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre die Notiz, um Treffer im Text anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the note to preview matches in the body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la nota para previsualizar las coincidencias en el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez la note pour prévisualiser les correspondances dans le corps du texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलान का पूर्वावलोकन करने के लिए नोट अनलॉक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A találatok előnézetéhez a jegyzet törzsében oldja fel a jegyzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca la nota per vedere le corrispondenze nel testo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de notitie om overeenkomsten in de tekst te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj notatkę, aby zobaczyć podgląd dopasowań w treści."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте заметку, чтобы просматривать совпадения в тексте."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключете бележката, за да видите съвпаденията в текста."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås noten op for at se resultater i teksten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε τη σημείωση για προεπισκόπηση αντιστοιχιών στο κείμενο."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisu vastete eelvaate nägemiseks ava märkme lukk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa muistiinpanon lukitus nähdäksesi osumien esikatselun."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Díghlasáil an nóta chun meaitseálacha sa chorp a réamhamharc."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključajte bilješku da biste vidjeli podudaranja u tekstu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrakinkite pastabą, kad peržiūrėtumėte atitikmenis jos turinyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbloķējiet piezīmi, lai priekšskatītu atbilstības tās saturā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iżblokka n-nota biex tara r-riżultati fil-kontenut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a nota para pré-visualizar as correspondências no conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocați notița pentru a previzualiza potrivirile din conținut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete zobraziť zhody v texte, odomknite poznámku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odklenite beležko, da vidite predogled zadetkov v vsebini."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp anteckningen för att förhandsvisa träffar i texten."
          }
        }
      }
    },
