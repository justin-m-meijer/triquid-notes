    "With %@ on, the app unlocks when you open it. Without an app PIN, your device passcode is the fallback.": {
      "comment": "Settings footer: %@ is Face ID, Touch ID, or Optic ID",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn %@ aktiviert ist, wird die App beim Öffnen entsperrt. Ohne App-PIN dient dein Gerätecode als Alternative."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque %@ est activé, l’app se déverrouille à son ouverture. Sans code PIN d’app, le code de votre appareil sert de solution de secours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met %@ aan wordt de app ontgrendeld als je hem opent. Zonder app-pincode wordt de toegangscode van je apparaat gebruikt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При включен %@ приложението се отключва, когато го отворите. Без PIN за приложението резервният вариант е кодът на устройството ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se zapnutým %@ se aplikace odemkne při otevření. Bez PIN aplikace slouží jako záloha kód zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når %@ er slået til, låses appen op, når du åbner den. Uden en app-PIN-kode bruges din enheds adgangskode som reserve."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργό το %@, η εφαρμογή ξεκλειδώνει όταν την ανοίγετε. Χωρίς PIN εφαρμογής, χρησιμοποιείται ως εναλλακτική ο κωδικός της συσκευής σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %@ activado, la app se desbloquea al abrirla. Sin un PIN de la app, se usa el código del dispositivo como alternativa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui %@ on sees, avatakse rakenduse lukk selle avamisel. Ilma rakenduse PIN-ita on varuvõimaluseks seadme pääsukood."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %@ on päällä, sovelluksen lukitus avautuu, kun avaat sen. Jos sovelluksella ei ole PIN-koodia, varakeinona on laitteen pääsykoodi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %@ air, díghlasálann an aip nuair a osclaíonn tú í. Gan PIN aipe, is é paschód do ghléis an rogha chúltaca."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključen %@, aplikacija se otključava kad je otvorite. Bez PIN-a aplikacije rezervna je opcija šifra vašeg uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a(z) %@ be van kapcsolva, az alkalmazás megnyitáskor feloldódik. Alkalmazás-PIN nélkül az eszköz jelkódja a tartalék."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %@ attivo, l’app si sblocca quando la apri. Senza un PIN dell’app, viene usato il codice del dispositivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus %@, programa atrakinama ją atidarius. Jei programos PIN nenustatytas, atsarginis būdas – įrenginio slaptakodis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja ieslēgts %@, lietotne tiek atbloķēta, kad to atverat. Ja nav lietotnes PIN, kā rezerve tiek izmantots ierīces piekļuves kods."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "B’%@ mixgħul, l-app tiżblokka meta tiftaħha. Mingħajr PIN tal-app, il-passcode tal-apparat tiegħek huwa l-alternattiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy %@ jest włączony, aplikacja odblokowuje się po otwarciu. Bez PIN-u aplikacji zapasowo używany jest kod urządzenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com %@ ativado, a app é desbloqueada quando a abre. Sem um PIN da app, o código do dispositivo é a alternativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu %@ activat, aplicația se deblochează când o deschideți. Fără un PIN de aplicație, se folosește codul dispozitivului ca alternativă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "So zapnutým %@ sa aplikácia odomkne pri otvorení. Bez PIN aplikácie slúži ako záloha kód zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je %@ vklopljen, se aplikacija ob odpiranju odklene. Brez kode PIN aplikacije se kot nadomestilo uporabi koda naprave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När %@ är på låses appen upp när du öppnar den. Utan en app-PIN-kod används enhetens lösenkod som reserv."
          }
        }
      }
    },
