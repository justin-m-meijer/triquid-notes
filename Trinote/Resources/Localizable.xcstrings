    "When off, only this note is copied. When on, the full subtree is recreated on the destination.": {
      "comment": "Copy to instance subtree footer",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, wird nur diese Notiz kopiert. Wenn aktiviert, wird der gesamte Unterbaum am Ziel neu erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’option est désactivée, seule cette note est copiée. Si elle est activée, toute la sous-arborescence est recréée sur la destination."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit uit staat, wordt alleen deze notitie gekopieerd. Als dit aan staat, wordt de volledige substructuur op de bestemming opnieuw aangemaakt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато е изключено, се копира само тази бележка. Когато е включено, цялото поддърво се пресъздава в местоназначението."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je-li vypnuto, zkopíruje se pouze tato poznámka. Je-li zapnuto, v cíli se znovu vytvoří celý podstrom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er slået fra, kopieres kun denne note. Når det er slået til, genskabes hele undertræet på destinationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ανενεργό, αντιγράφεται μόνο αυτή η σημείωση. Όταν είναι ενεργό, ολόκληρο το υποδέντρο αναδημιουργείται στον προορισμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, solo se copia esta nota. Si está activado, se recrea el subárbol completo en el destino."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljas olekus kopeeritakse ainult see märge. Sees olekus luuakse sihtkohas uuesti kogu alampuu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun asetus on pois päältä, vain tämä muistiinpano kopioidaan. Kun se on päällä, koko alipuu luodaan uudelleen kohteeseen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuair atá sé as, ní chóipeáiltear ach an nóta seo. Nuair atá sé air, athchruthaítear an fochrann iomlán ag an gceann scríbe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je isključeno, kopira se samo ova bilješka. Kad je uključeno, cijelo podstablo ponovno se stvara na odredištu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva csak ez a jegyzet másolódik. Bekapcsolva a teljes részfa újra létrejön a célhelyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, viene copiata solo questa nota. Se attivato, l’intero sottoalbero viene ricreato nella destinazione."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išjungus kopijuojama tik ši pastaba. Įjungus paskirties egzemplioriuje atkuriamas visas pomedis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja izslēgts, tiek kopēta tikai šī piezīme. Ja ieslēgts, mērķa instancē tiek atveidots viss apakškoks."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta jkun mitfi, tiġi kkupjata din in-nota biss. Meta jkun mixgħul, is-sottosiġra kollha terġa’ tinħoloq fid-destinazzjoni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, kopiowana jest tylko ta notatka. Gdy włączone, całe poddrzewo zostanie odtworzone w miejscu docelowym."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, apenas esta nota é copiada. Quando ativado, toda a subárvore é recriada no destino."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este dezactivat, se copiază doar această notiță. Când este activat, întregul subarbore este recreat la destinație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je vypnuté, skopíruje sa len táto poznámka. Ak je zapnuté, v cieli sa znova vytvorí celý podstrom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je izklopljeno, se kopira le ta beležka. Ko je vklopljeno, se na cilju poustvari celotno poddrevo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När detta är av kopieras endast den här anteckningen. När det är på återskapas hela underträdet på målet."
          }
        }
      }
    },
