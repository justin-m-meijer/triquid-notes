    "It appears under Saved Searches in the menu.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر ضمن عمليات البحث المحفوظة في القائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Появява се в менюто под Запазени търсения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se v nabídce v části Uložená hledání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vises under Gemte søgninger i menuen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erscheint im Menü unter „Gesicherte Suchen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται στο μενού στις Αποθηκευμένες αναζητήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It appears under Saved Searches in the menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en Búsquedas guardadas en el menú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ilmub menüüs jaotises Salvestatud otsingud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se näkyy valikossa kohdassa Tallennetut haut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle apparaît sous Recherches enregistrées dans le menu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeántar é faoi Cuardaigh Shábháilte sa roghchlár."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मेनू में सहेजी गई खोजें के अंतर्गत दिखती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojavljuje se u izborniku pod Spremljena pretraživanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A menüben a Mentett keresések alatt jelenik meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare in Ricerche salvate nel menu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma meniu skiltyje Įrašytos paieškos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas parādās izvēlnē sadaļā Saglabātie meklējumi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidher taħt Tiftix Maħżun fil-menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vindt hem in het menu onder Bewaarde zoekopdrachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się w menu w sekcji Zachowane wyszukiwania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece em Pesquisas Guardadas no menu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare în meniu la Căutări salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он появится в меню в разделе «Сохранённые поиски»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí sa v ponuke v časti Uložené hľadania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V meniju se prikaže pod Shranjena iskanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den visas under Sparade sökningar i menyn."
          }
        }
      }
    },
