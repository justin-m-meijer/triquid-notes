    "The notebooks are sorted by title in Trilium. Choose Trilium order to arrange them by hand.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitieboeken worden in Trilium op titel gesorteerd. Kies Trilium-volgorde om ze zelf te ordenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carnets sont triés par titre dans Trilium. Choisissez l’ordre Trilium pour les organiser vous-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notizbücher sind in Trilium nach Titel sortiert. Wähle die Trilium-Reihenfolge, um sie selbst anzuordnen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележниците са сортирани по заглавие в Trilium. Изберете „Ред в Trilium“, за да ги подреждате ръчно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sešity jsou v Trilium řazeny podle názvu. Chcete-li je uspořádat ručně, zvolte Pořadí v Trilium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notesbøgerne sorteres efter titel i Trilium. Vælg Triliums rækkefølge for at arrangere dem manuelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σημειωματάρια ταξινομούνται κατά τίτλο στο Trilium. Επιλέξτε «Σειρά Trilium» για να τα τακτοποιήσετε χειροκίνητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Trilium, los cuadernos están ordenados por título. Elige Orden de Trilium para ordenarlos a mano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkmikud on Triliumis sorditud pealkirja järgi. Nende käsitsi korraldamiseks vali Triliumi järjekord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistikirjat on järjestetty Triliumissa otsikon mukaan. Valitse Triliumin järjestys järjestääksesi ne käsin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sórtáiltear na leabhair nótaí de réir teidil in Trilium. Roghnaigh Ord Trilium chun iad a shocrú de láimh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilježnice su u Triliumu sortirane prema naslovu. Odaberite „Redoslijed u Triliumu” da biste ih slagali ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetfüzetek cím szerint vannak rendezve a Triliumban. Kézi elrendezésükhöz válassza a Trilium szerinti sorrendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Trilium i taccuini sono ordinati per titolo. Scegli Ordine di Trilium per disporli a mano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užrašų knygos Trilium rikiuojamos pagal pavadinimą. Pasirinkite „Trilium tvarka“, kad jas tvarkytumėte rankiniu būdu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmju grāmatas Trilium ir kārtotas pēc virsraksta. Izvēlieties Trilium secību, lai tās kārtotu manuāli."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-notebooks huma ssortjati skont it-titlu fi Trilium. Agħżel Ordni ta’ Trilium biex tirranġahom manwalment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notesy są sortowane według tytułu w Trilium. Wybierz kolejność Trilium, aby ułożyć je ręcznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cadernos estão ordenados por título no Trilium. Escolha «Ordem do Trilium» para os organizar manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnetele sunt sortate după titlu în Trilium. Alegeți Ordinea din Trilium pentru a le aranja manual."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zošity sú v Trilium zoradené podľa názvu. Ak ich chcete usporiadať ručne, zvoľte Poradie v Trilium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvezki so v Triliumu razvrščeni po naslovu. Za ročno urejanje izberite Vrstni red Triliuma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningsböckerna sorteras efter titel i Trilium. Välj Triliums ordning för att ordna dem manuellt."
          }
        }
      }
    },
