    "OCR did not extract readable text. The image may have low contrast or confidence.": {
      "comment": "OCR processed but empty",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR hat keinen lesbaren Text extrahiert. Das Bild hat möglicherweise zu wenig Kontrast oder Zuverlässigkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
