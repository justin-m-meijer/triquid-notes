          "stringUnit": {
            "state": "translated",
            "value": "„%@“ unter „%@“ bewegen? Die Notiz erscheint am neuen Ort im Baum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move “%@” under “%@”? The note will appear in the new location in the tree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover «%@» dentro de «%@»? La nota aparecerá en la nueva ubicación del árbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer « %@ » sous « %@ » ? La note apparaîtra au nouvel emplacement dans l’arborescence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» को «%@» के अंतर्गत ले जाएँ? नोट ट्री में नए स्थान पर दिखेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Áthelyezi: „%@” ide: „%@”? A jegyzet az új helyén jelenik meg a fában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare “%@” sotto “%@”? La nota apparirà nella nuova posizione dell’albero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ naar ‘%@’ verplaatsen? De notitie verschijnt op de nieuwe plek in de boom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieść „%@” do „%@”? Notatka pojawi się w nowym miejscu w drzewie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить «%@» под «%@»? Заметка появится в дереве в новом месте."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се премести ли „%@“ под „%@“? Бележката ще се появи на новото място в дървото."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du flytte “%@” under “%@”? Noten vises på den nye placering i træet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση του «%@» κάτω από το «%@»; Η σημείωση θα εμφανιστεί στη νέα θέση στο δέντρο."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas teisaldada „%@“ märkme „%@“ alla? Märge kuvatakse puus uues asukohas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirretäänkö ”%@” kohteen ”%@” alle? Muistiinpano näkyy puussa uudessa sijainnissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bog “%@” faoi “%@”? Taispeánfar an nóta san áit nua sa chrann."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premjestiti „%@” ispod „%@”? Bilješka će se pojaviti na novom mjestu u stablu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkelti „%@“ po „%@“? Pastaba atsiras naujoje medžio vietoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvietot „%@” zem „%@”? Piezīme parādīsies jaunajā vietā kokā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tmexxi “%@” taħt “%@”? In-nota tidher fil-post il-ġdid fis-siġra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover «%@» para dentro de «%@»? A nota aparecerá na nova localização na árvore."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutați „%@” sub „%@”? Notița va apărea în noua locație din arbore."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunúť „%@“ pod „%@“? Poznámka sa zobrazí v novom umiestnení v strome."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite premakniti „%@“ pod „%@“? Beležka se bo prikazala na novem mestu v drevesu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du flytta ”%@” under ”%@”? Anteckningen visas på den nya platsen i trädet."
          }
        }
      }
    },
