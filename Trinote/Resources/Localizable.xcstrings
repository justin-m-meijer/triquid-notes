    "Tap a diagram type to insert a sample you can edit. The preview will replace this panel once there's content.": {
      "comment": "Mermaid starter chooser subtitle",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Diagrammtyp, um ein bearbeitbares Beispiel einzufügen. Die Vorschau ersetzt dieses Feld, sobald Inhalt vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un type de diagramme pour insérer un exemple modifiable. L’aperçu remplacera ce panneau dès qu’il y aura du contenu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een diagramtype om een voorbeeld in te voegen dat je kunt wijzigen. De voorvertoning vervangt dit paneel zodra er inhoud is."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете тип диаграма, за да вмъкнете пример, който можете да редактирате. Прегледът ще замени този панел, щом има съдържание."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na typ diagramu vložíte ukázku, kterou můžete upravit. Jakmile bude obsah k dispozici, nahradí tento panel náhled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en diagramtype for at indsætte et eksempel, du kan redigere. Forhåndsvisningen erstatter dette panel, når der er indhold."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε έναν τύπο διαγράμματος για να εισαγάγετε ένα δείγμα που μπορείτε να επεξεργαστείτε. Η προεπισκόπηση θα αντικαταστήσει αυτό το πλαίσιο μόλις υπάρξει περιεχόμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un tipo de diagrama para insertar un ejemplo que puedes editar. La previsualización sustituirá a este panel en cuanto haya contenido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta diagrammi tüüpi, et lisada muudetav näidis. Kui sisu on olemas, asendab eelvaade selle paneeli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää muokattava esimerkki napauttamalla kaaviotyyppiä. Esikatselu korvaa tämän paneelin, kun sisältöä on."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil cineál léaráide chun sampla in-eagarthóireachta a ionsá. Tiocfaidh an réamhamharc in ionad an phainéil seo nuair a bheidh ábhar ann."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite vrstu dijagrama da biste umetnuli primjer koji možete uređivati. Pregled će zamijeniti ovu ploču kad bude sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson egy diagramtípusra egy szerkeszthető minta beszúrásához. Amint van tartalom, az előnézet váltja fel ezt a panelt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tipo di diagramma per inserire un esempio modificabile. L’anteprima sostituirà questo pannello non appena ci sarà del contenuto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite diagramos tipą, kad įterptumėte redaguojamą pavyzdį. Kai atsiras turinio, šį skydelį pakeis peržiūra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties diagrammas tipam, lai ievietotu rediģējamu paraugu. Kad būs saturs, šo paneli aizstās priekšskatījums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas tip ta’ dijagramma biex iddaħħal kampjun li tista’ teditja. Il-previżjoni tieħu post dan il-pannell meta jkun hemm kontenut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij typ diagramu, aby wstawić przykład do edycji. Gdy pojawi się zawartość, ten panel zastąpi podgląd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num tipo de diagrama para inserir um exemplo editável. A pré-visualização substituirá este painel quando houver conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați un tip de diagramă pentru a insera un exemplu editabil. Previzualizarea va înlocui acest panou când există conținut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na typ diagramu vložíte ukážku, ktorú môžete upraviť. Keď bude k dispozícii obsah, nahradí tento panel náhľad."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite vrsto diagrama, da vstavite vzorec, ki ga lahko urejate. Ko bo vsebina dodana, bo predogled nadomestil to podokno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en diagramtyp för att infoga ett exempel som du kan redigera. Förhandsvisningen ersätter den här panelen när det finns innehåll."
          }
        }
      }
    },
    "Tap Edit to open the full Univer Sheets editor with formulas, formatting, and rich text.": {
      "comment": "Spreadsheet note preview explanation",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Bearbeiten“, um den vollständigen Univer Sheets-Editor mit Formeln, Formatierung und formatiertem Text zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Modifier pour ouvrir l’éditeur Univer Sheets complet avec formules, mise en forme et texte enrichi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op “Wijzig” om de volledige Univer Sheets-editor te openen met formules, opmaak en opgemaakte tekst."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете Редактирай, за да отворите пълния редактор Univer Sheets с формули, форматиране и форматиран текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na Upravit otevřete plný editor Univer Sheets se vzorci, formátováním a formátovaným textem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Rediger for at åbne den fulde Univer Sheets-editor med formler, formatering og formateret tekst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε «Επεξεργασία» για να ανοίξετε το πλήρες πρόγραμμα επεξεργασίας Univer Sheets με τύπους, μορφοποίηση και εμπλουτισμένο κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Editar para abrir el editor completo de Univer Sheets con fórmulas, formato y texto enriquecido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Muuda, et avada täielik Univer Sheetsi redaktor koos valemite, vorminduse ja vormindatud tekstiga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Muokkaa avataksesi täyden Univer Sheets ‑editorin kaavoineen, muotoiluineen ja muotoiltuine teksteineen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil Cuir in eagar chun eagarthóir iomlán Univer Sheets a oscailt le foirmlí, formáidiú agus téacs saibhir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite Uredi da biste otvorili puni uređivač Univer Sheets s formulama, formatiranjem i obogaćenim tekstom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szerkesztés gombra koppintva megnyílik a teljes Univer Sheets szerkesztő képletekkel, formázással és formázott szöveggel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Modifica per aprire l’editor completo di Univer Sheets con formule, formattazione e testo formattato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite „Redaguoti“, kad atidarytumėte visą Univer Sheets redaktorių su formulėmis, formatavimu ir raiškiuoju tekstu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties Rediģēt, lai atvērtu pilno Univer Sheets redaktoru ar formulām, formatējumu un bagātinātu tekstu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas Editja biex tiftaħ l-editur sħiħ ta’ Univer Sheets b’formuli, formattjar u test rikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Edytuj, aby otworzyć pełny edytor Univer Sheets z formułami, formatowaniem i tekstem sformatowanym."
