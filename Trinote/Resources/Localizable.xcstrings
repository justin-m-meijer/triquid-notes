    "Both Cloudflare Access Client ID and Client Secret are required when using Cloudflare Access.": {
      "comment": "Validation error when only one Cloudflare field is filled",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Verwendung von Cloudflare Access sind sowohl die Client-ID als auch das Client-Secret erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant client et le secret client Cloudflare Access sont tous deux requis pour utiliser Cloudflare Access."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zowel de Cloudflare Access-client-ID als het clientgeheim zijn vereist bij gebruik van Cloudflare Access."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато използвате Cloudflare Access, са нужни и Client ID, и Client Secret."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při použití Cloudflare Access je vyžadováno ID klienta i tajný klíč klienta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Både klient-id og klienthemmelighed til Cloudflare Access er påkrævet, når du bruger Cloudflare Access."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χρησιμοποιείτε το Cloudflare Access, απαιτούνται τόσο το αναγνωριστικό πελάτη όσο και το μυστικό πελάτη του Cloudflare Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar Cloudflare Access se necesitan tanto el ID de cliente como el secreto de cliente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Accessi kasutamisel on nõutud nii Cloudflare Accessi kliendi ID kui ka kliendi salasõna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Accessin käyttö vaatii sekä Cloudflare Access ‑asiakastunnuksen että asiakassalaisuuden."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá Aitheantas Cliaint agus Rún Cliaint Cloudflare Access araon ag teastáil nuair a úsáidtear Cloudflare Access."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri upotrebi usluge Cloudflare Access potrebni su i Client ID i Client Secret."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare Access használatához a kliensazonosító és a klienstitok is szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando usi Cloudflare Access sono necessari sia il Client ID sia il Client Secret."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudojant Cloudflare Access, būtini ir Cloudflare Access kliento ID, ir kliento slaptasis raktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojot Cloudflare Access, ir nepieciešams gan Cloudflare Access klienta ID, gan klienta noslēpums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemm l-ID tal-Klijent kif ukoll is-Sigriet tal-Klijent ta’ Cloudflare Access huma meħtieġa meta tuża Cloudflare Access."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access wymaga podania zarówno identyfikatora klienta, jak i klucza tajnego klienta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID e o segredo do cliente do Cloudflare Access são ambos obrigatórios ao usar o Cloudflare Access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când folosiți Cloudflare Access, sunt necesare atât ID-ul de client, cât și secretul de client Cloudflare Access."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri použití Cloudflare Access sa vyžaduje ID klienta aj tajný kľúč klienta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri uporabi Cloudflare Access sta obvezna tako ID odjemalca kot skrivnost odjemalca za Cloudflare Access."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Både klient-ID och klienthemlighet för Cloudflare Access krävs när du använder Cloudflare Access."
          }
        }
      }
    },
