          }
        }
      }
    },
    "Trilium keeps them in alphabetical order on every device and in its own apps. Switching back to Trilium order keeps the alphabetical order; the current order does not come back.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium houdt ze dan alfabetisch, op elk apparaat en in Trilium zelf. Ga je terug naar Trilium-volgorde, dan blijft de alfabetische volgorde staan; je huidige volgorde komt niet terug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium les garde alors par ordre alphabétique, sur chaque appareil et dans ses propres apps. Revenir à l’ordre Trilium conserve l’ordre alphabétique ; l’ordre actuel ne revient pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium hält sie dann alphabetisch, auf jedem Gerät und in Trilium selbst. Zurück zur Trilium-Reihenfolge behält die alphabetische Reihenfolge; die aktuelle kommt nicht zurück."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium ги пази в азбучен ред на всяко устройство и в собствените си приложения. Връщането към „Ред в Trilium“ запазва азбучния ред; текущият ред не се възстановява."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium je udržuje v abecedním pořadí na všech zařízeních i ve vlastních aplikacích. Přepnutím zpět na Pořadí v Trilium zůstane abecední pořadí zachováno; současné pořadí se neobnoví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium holder dem i alfabetisk rækkefølge på alle enheder og i sine egne apps. Hvis du skifter tilbage til Triliums rækkefølge, bevares den alfabetiske rækkefølge; den nuværende rækkefølge kommer ikke tilbage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Trilium τα διατηρεί σε αλφαβητική σειρά σε κάθε συσκευή και στις δικές του εφαρμογές. Η επιστροφή στη «Σειρά Trilium» διατηρεί την αλφαβητική σειρά· η τρέχουσα σειρά δεν επανέρχεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium los mantiene en orden alfabético en todos los dispositivos y en sus propias apps. Al volver a Orden de Trilium se conserva el orden alfabético; el orden actual no vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium hoiab neid tähestikulises järjekorras igas seadmes ja oma rakendustes. Triliumi järjekorrale tagasi lülitumisel säilib tähestikuline järjekord; praegune järjekord tagasi ei tule."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium pitää ne aakkosjärjestyksessä jokaisella laitteella ja omissa sovelluksissaan. Kun vaihdat takaisin Triliumin järjestykseen, aakkosjärjestys säilyy; nykyinen järjestys ei palaa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Coinníonn Trilium in ord aibítre iad ar gach gléas agus ina aipeanna féin. Má athraíonn tú ar ais go hOrd Trilium, coinnítear an t-ord aibítre; ní thagann an t-ord reatha ar ais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium ih čuva abecednim redom na svakom uređaju i u svojim aplikacijama. Povratak na „Redoslijed u Triliumu” zadržava abecedni redoslijed; trenutačni se redoslijed ne vraća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Trilium minden eszközön és a saját alkalmazásaiban is betűrendben tartja őket. A Trilium szerinti sorrendre visszaváltva a betűrend megmarad; a jelenlegi sorrend nem áll vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium li mantiene in ordine alfabetico su ogni dispositivo e nelle sue app. Tornando a Ordine di Trilium resta l’ordine alfabetico; l’ordine attuale non viene ripristinato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium jas laiko abėcėlės tvarka kiekviename įrenginyje ir savo programose. Grįžus prie „Trilium tvarkos“, abėcėlės tvarka išlieka; dabartinė tvarka nebegrąžinama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium tās glabā alfabētiskā secībā katrā ierīcē un savās lietotnēs. Atgriežoties pie Trilium secības, alfabētiskā secība saglabājas; pašreizējā secība netiek atjaunota."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium iżommhom f’ordni alfabetiku fuq kull apparat u fl-apps tiegħu stess. Jekk terġa’ taqleb għall-Ordni ta’ Trilium, l-ordni alfabetiku jinżamm; l-ordni attwali ma jerġax lura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium utrzymuje je w kolejności alfabetycznej na każdym urządzeniu i we własnych aplikacjach. Powrót do kolejności Trilium zachowuje kolejność alfabetyczną; obecna kolejność nie wróci."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Trilium mantém-nos por ordem alfabética em todos os dispositivos e nas suas próprias apps. Voltar à ordem do Trilium mantém a ordem alfabética; a ordem atual não regressa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium le păstrează în ordine alfabetică pe fiecare dispozitiv și în propriile aplicații. Revenirea la Ordinea din Trilium păstrează ordinea alfabetică; ordinea actuală nu revine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium ich udržiava v abecednom poradí vo všetkých zariadeniach aj vo vlastných aplikáciách. Prepnutím späť na Poradie v Trilium zostane abecedné poradie zachované; súčasné poradie sa neobnoví."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium jih ohranja v abecednem vrstnem redu v vseh napravah in v svojih aplikacijah. Če preklopite nazaj na vrstni red Triliuma, abecedni vrstni red ostane; trenutni vrstni red se ne povrne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trilium håller dem i alfabetisk ordning på alla enheter och i sina egna appar. Om du byter tillbaka till Triliums ordning behålls den alfabetiska ordningen; den nuvarande ordningen kommer inte tillbaka."
          }
        }
      }
    },
