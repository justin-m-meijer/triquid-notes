        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī piezīme automātiski kārto savas apakšpiezīmes (#sorted), tāpēc to secību nevar mainīt manuāli."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Din in-nota tissortja s-sottonoti tagħha awtomatikament (#sorted), għalhekk ma jistgħux jerġgħu jiġu ordnati manwalment."
          }
        },
        "pt-PT": {
          "stringUnit": {
