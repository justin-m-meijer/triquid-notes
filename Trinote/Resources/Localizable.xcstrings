    "Accept the site's cookie notice if it shows one, then tap Clip.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiere den Cookie-Hinweis der Seite, falls er erscheint, und tippe dann auf „Erfassen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptez l’avis de cookies du site s’il s’affiche, puis touchez Capturer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer de cookiemelding van de site als die er is, en tik dan op Knip."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приемете известието за бисквитки на сайта, ако се покаже, след това докоснете Изрежи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud web zobrazí upozornění na cookies, přijměte ho a pak klepněte na Vystřihnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter webstedets cookiemeddelelse, hvis det vises, og tryk derefter på Klip."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδεχτείτε την ειδοποίηση cookie του ιστότοπου, αν εμφανιστεί, και μετά αγγίξτε «Αποκοπή»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta el aviso de cookies del sitio si aparece y luego toca Recortar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nõustu saidi küpsiseteatega, kui see kuvatakse, ja seejärel puuduta Lõika."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksy sivuston evästeilmoitus, jos se näytetään, ja napauta sitten Leikkaa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Glac le fógra fianán an tsuímh má thaispeántar ceann, ansin tapáil Gearr."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihvatite obavijest o kolačićima na stranici ako se prikaže, zatim dodirnite Izreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a webhely sütikről szóló értesítést jelenít meg, fogadja el, majd koppintson a Kivágás gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta l’avviso sui cookie del sito, se presente, poi tocca Ritaglia."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei svetainė rodo slapukų pranešimą, priimkite jį, tada bakstelėkite „Iškirpti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vietnē tiek parādīts sīkfailu paziņojums, pieņemiet to un pēc tam pieskarieties Izgriezt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aċċetta l-avviż tal-cookies tas-sit jekk jidher, imbagħad agħfas Aqta’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaakceptuj powiadomienie o plikach cookie, jeśli się pojawi, a następnie stuknij Wytnij."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceite o aviso de cookies do site, se aparecer, e depois toque em Recortar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptați notificarea de cookie-uri a site-ului dacă apare, apoi apăsați Decupează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak web zobrazí upozornenie na cookies, prijmite ho a potom klepnite na Vystrihnúť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprejmite obvestilo o piškotkih, če se prikaže, nato tapnite Izreži."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkänn webbplatsens cookiemeddelande om ett sådant visas och tryck sedan på Klipp."
          }
        }
      }
    },
