            "state": "translated",
            "value": "नोट को बोर्ड में जोड़ा नहीं जा सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetet nem sikerült hozzáadni a táblához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiungere la nota alla bacheca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie kan niet aan het bord worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można dodać notatki do tablicy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить заметку на доску."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележката не може да бъде добавена към таблото."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noten kunne ikke føjes til tavlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η προσθήκη της σημείωσης στον πίνακα."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märget ei õnnestunud tahvlile lisada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoa ei voitu lisätä taululle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an nóta a chur leis an gclár."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješku nije moguće dodati na ploču."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastabos nepavyko pridėti į lentą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmi nevarēja pievienot tāfelei."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-nota ma setgħetx tiżdied mal-bord."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar a nota ao quadro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița nu a putut fi adăugată pe panou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku sa nepodarilo pridať na tabuľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležke ni bilo mogoče dodati na tablo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningen kunde inte läggas till på tavlan."
          }
        }
      }
    },
