    "Writing Tools, summaries, to-dos and titles, even from PDFs and photos. Made on your device.": {
      "comment": "Onboarding highlight",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibtools, Zusammenfassungen, Aufgaben und Titel, auch aus PDFs und Fotos. Auf deinem Gerät erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils d’écriture, résumés, tâches et titres, même à partir de PDF et de photos. Créés sur votre appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijfhulp, samenvattingen, taken en titels, ook uit pdf's en foto's. Gemaakt op je toestel."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменти за писане, обобщения, задачи и заглавия, дори от PDF файлове и снимки. На вашето устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje pro psaní, shrnutí, úkoly a názvy, i z PDF a fotek. Přímo ve vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveværktøjer, resuméer, opgaver og titler, også fra PDF'er og fotos. Lavet på din enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εργαλεία γραφής, συνόψεις, εκκρεμότητες και τίτλοι, ακόμα και από PDF και φωτογραφίες. Στη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herramientas de escritura, resúmenes, tareas y títulos, incluso a partir de PDF y fotos. Generados en tu dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjutustööriistad, kokkuvõtted, ülesanded ja pealkirjad, isegi PDF-idest ja fotodest. Tehtud sinu seadmes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitustyökalut, tiivistelmät, tehtävät ja otsikot, jopa PDF:istä ja kuvista. Tehty laitteessasi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Uirlisí Scríbhneoireachta, achoimrí, tascanna agus teidil, fiú ó PDFanna agus grianghraif. Déanta ar do ghléas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alati za pisanje, sažeci, zadaci i naslovi, čak i iz PDF-ova i fotografija. Na vašem uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Íróeszközök, összefoglalók, teendők és címek, akár PDF-ekből és fotókból is. Mindez az eszközén."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumenti di scrittura, riassunti, cose da fare e titoli, anche da PDF e foto. Creati sul tuo dispositivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rašymo įrankiai, santraukos, užduotys ir pavadinimai, net iš PDF ir nuotraukų. Sukuriama jūsų įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakstīšanas rīki, kopsavilkumi, uzdevumi un virsraksti, pat no PDF un fotoattēliem. Tiek veidoti jūsu ierīcē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għodod tal-Kitba, sommarji, affarijiet x’tagħmel u titli, anke minn PDFs u ritratti. Magħmula fuq l-apparat tiegħek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia pisania, podsumowania, zadania i tytuły — nawet z plików PDF i zdjęć. Wszystko na Twoim urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramentas de escrita, resumos, tarefas e títulos, até a partir de PDF e fotografias. Feito no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumente de scriere, rezumate, sarcini și titluri, chiar și din PDF-uri și poze. Create pe dispozitivul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje na písanie, zhrnutia, úlohy a názvy, aj z PDF a fotiek. Priamo vo vašom zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orodja za pisanje, povzetki, opravila in naslovi, tudi iz PDF-jev in fotografij. Ustvarjeno v vaši napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivverktyg, sammanfattningar, uppgifter och titlar, även från PDF:er och bilder. Skapat på din enhet."
          }
        }
      }
    },
    "Shows Summarize, Find To-dos and Suggest Title": {
