    "You have an unsaved draft for this note. Would you like to restore it?": {
      "comment": "Draft dialog message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد مسودة غير محفوظة. هل تريد استعادتها?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto poznámku máte neuložený koncept. Chcete ho obnovit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen nicht gesicherten Entwurf für diese Notiz. Möchtest du ihn wiederherstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an unsaved draft for this note. Would you like to restore it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un borrador sin guardar de esta nota. ¿Quieres restaurarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un brouillon non enregistré pour cette note. Voulez-vous le restaurer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नोट का असहेजा ड्राफ़्ट है। पुनर्स्थापित करें?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a jegyzethez van egy nem mentett piszkozata. Szeretné visszaállítani?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai una bozza non salvata per questa nota. Vuoi ripristinarla?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een niet-bewaard concept voor deze notitie. Wil je het herstellen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz niezachowaną wersję roboczą tej notatki. Czy chcesz ją przywrócić?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть несохранённый черновик. Восстановить?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имате незапазена чернова за тази бележка. Искате ли да я възстановите?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har en ikke-gemt kladde til denne note. Vil du gendanne den?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε ένα μη αποθηκευμένο πρόχειρο για αυτή τη σημείωση. Θέλετε να το επαναφέρετε;"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle märkme jaoks on salvestamata mustand. Kas soovid selle taastada?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle muistiinpanolle on tallentamaton luonnos. Haluatko palauttaa sen?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá dréacht gan sábháil agat don nóta seo. Ar mhaith leat é a athchóiriú?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imate nespremljenu skicu ove bilješke. Želite li je vratiti?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiai pastabai yra neišsaugotas juodraštis. Ar norite jį atkurti?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šai piezīmei ir nesaglabāts melnraksts. Vai vēlaties to atjaunot?"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għandek abbozz mhux salvat għal din in-nota. Trid tirrestawrah?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem um rascunho não guardado desta nota. Pretende restaurá-lo?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aveți o ciornă nesalvată pentru această notiță. Doriți să o restaurați?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre túto poznámku máte neuložený koncept. Chcete ho obnoviť?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to beležko imate neshranjen osnutek. Ga želite obnoviti?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ett osparat utkast för den här anteckningen. Vill du återställa det?"
          }
        }
      }
    },
    "You've given Triquid Notes access to a select number of photos.": {
