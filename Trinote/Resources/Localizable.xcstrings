    "Notes you take there stay on this device, apart from your server. You can move them to a Trilium server later; switch back under Instances.": {
      "comment": "Settings: local notebook footer",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, die du dort erstellst, bleiben auf diesem Gerät, getrennt von deinem Server. Du kannst sie später auf einen Trilium-Server bewegen; wechsle unter „Instanzen“ zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes que vous y prenez restent sur cet appareil, séparées de votre serveur. Vous pourrez les déplacer plus tard vers un serveur Trilium ; revenez en arrière dans Instances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities die je daar maakt, blijven op dit apparaat, los van je server. Je kunt ze later naar een Trilium-server verplaatsen; schakel terug via Instanties."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките, които водите там, остават на това устройство, отделно от сървъра ви. По-късно можете да ги преместите на сървър на Trilium; върнете се обратно от Инстанции."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky, které si tam zapíšete, zůstanou na tomto zařízení, odděleně od vašeho serveru. Později je můžete přesunout na server Trilium; zpět se přepnete v sekci Instance."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter, du skriver der, forbliver på denne enhed, adskilt fra din server. Du kan flytte dem til en Trilium-server senere; skift tilbage under Instanser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις που κρατάτε εκεί μένουν σε αυτή τη συσκευή, χωριστά από τον διακομιστή σας. Μπορείτε να τις μεταφέρετε αργότερα σε διακομιστή Trilium· επιστρέψτε από τα Στιγμιότυπα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas que crees ahí se quedan en este dispositivo, separadas de tu servidor. Puedes moverlas a un servidor Trilium más adelante; vuelve desde Instancias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seal tehtud märkmed jäävad sellesse seadmesse, serverist eraldi. Saad need hiljem Triliumi serverisse teisaldada; tagasi lülitu jaotises Instantsid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siellä tekemäsi muistiinpanot pysyvät tässä laitteessa, erillään palvelimestasi. Voit siirtää ne Trilium-palvelimelle myöhemmin; vaihda takaisin kohdassa Instanssit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanann na nótaí a scríobhann tú ansin ar an ngléas seo, ar leith ó do fhreastalaí. Is féidir leat iad a bhogadh go freastalaí Trilium níos déanaí; athraigh ar ais faoi Chásanna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke koje tamo vodite ostaju na ovom uređaju, odvojeno od vašeg poslužitelja. Kasnije ih možete premjestiti na poslužitelj Trilium; natrag se prebacite u Instancama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ott írt jegyzetek ezen az eszközön maradnak, a szerverétől elkülönítve. Később áthelyezheti őket egy Trilium-szerverre; visszaváltani a Példányok alatt lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note che crei lì restano su questo dispositivo, separate dal tuo server. Potrai spostarle su un server Trilium in seguito; per tornare indietro, vai in Istanze."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kuriamos pastabos lieka šiame įrenginyje, atskirai nuo jūsų serverio. Vėliau galite jas perkelti į Trilium serverį; grįžti galite skiltyje „Egzemplioriai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur veidotās piezīmes paliek šajā ierīcē, atsevišķi no jūsu servera. Vēlāk varat tās pārvietot uz Trilium serveri; atgriezieties sadaļā Instances."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "In-noti li tikteb hemm jibqgħu fuq dan l-apparat, separati mis-server tiegħek. Tista’ tmexxihom għal server ta’ Trilium aktar tard; erġa’ aqleb taħt Istanzi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki tworzone tam pozostają na tym urządzeniu, oddzielnie od serwera. Możesz je później przenieść na serwer Trilium; wrócić możesz w sekcji Instancje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas que criar aí ficam neste dispositivo, separadas do seu servidor. Pode movê-las para um servidor Trilium mais tarde; volte atrás em Instâncias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele pe care le luați acolo rămân pe acest dispozitiv, separat de server. Le puteți muta mai târziu pe un server Trilium; reveniți din Instanțe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky, ktoré si tam zapíšete, zostanú v tomto zariadení, oddelene od vášho servera. Neskôr ich môžete presunúť na server Trilium; späť sa prepnete v sekcii Inštancie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležke, ki jih tam ustvarite, ostanejo v tej napravi, ločeno od strežnika. Pozneje jih lahko premaknete na strežnik Trilium; nazaj preklopite v razdelku Instance."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar du skriver där stannar på den här enheten, åtskilda från din server. Du kan flytta dem till en Trilium-server senare; byt tillbaka under Instanser."
          }
        }
      }
    },
