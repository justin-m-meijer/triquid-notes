    "Read and write anywhere; changes sync when you are back.": {
      "comment": "Onboarding highlight detail",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies und schreibe überall; Änderungen werden synchronisiert, wenn du zurück bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez et écrivez partout ; les modifications se synchronisent à votre retour."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en schrijf overal; wijzigingen worden gesynchroniseerd zodra je terug bent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Четете и пишете навсякъде; промените се синхронизират, когато се върнете онлайн."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtěte a pište kdekoli; změny se synchronizují, až budete zpět online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs og skriv overalt; ændringer synkroniseres, når du er tilbage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε και γράψτε οπουδήποτε· οι αλλαγές συγχρονίζονται όταν επιστρέψετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y escribe en cualquier lugar; los cambios se sincronizan cuando vuelves a tener conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe ja kirjuta kõikjal; muudatused sünkroonitakse, kui oled tagasi võrgus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue ja kirjoita missä tahansa; muutokset synkronoidaan, kun palaat verkkoon."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léigh agus scríobh áit ar bith; sioncrónaítear athruithe nuair a fhilleann tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitajte i pišite bilo gdje; promjene se sinkroniziraju kad se vratite na mrežu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasson és írjon bárhol; a módosítások szinkronizálódnak, amikor újra online lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi e scrivi ovunque; le modifiche si sincronizzano quando torni online."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaitykite ir rašykite bet kur; pakeitimai sinchronizuojami grįžus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasiet un rakstiet jebkur; izmaiņas tiek sinhronizētas, kad atgriežaties tiešsaistē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqra u ikteb kullimkien; il-bidliet jiġu sinkronizzati meta terġa’ lura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytaj i pisz wszędzie; zmiany zsynchronizują się po powrocie do sieci."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia e escreva em qualquer lugar; as alterações são sincronizadas quando voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citiți și scrieți oriunde; modificările se sincronizează când reveniți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítajte a píšte kdekoľvek; zmeny sa synchronizujú, keď budete späť online."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berite in pišite kjer koli; spremembe se sinhronizirajo, ko ste spet povezani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs och skriv var som helst; ändringar synkroniseras när du är tillbaka."
          }
        }
      }
    },
