    "A calm place for everything you think, keep and plan.": {
      "comment": "Onboarding subtitle",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Ort für alles, was du denkst, aufbewahrst und planst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieu paisible pour tout ce que vous pensez, gardez et planifiez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige plek voor alles wat je denkt, bewaart en plant."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойно място за всичко, което мислите, пазите и планирате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidné místo pro vše, co myslíte, uchováváte a plánujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et roligt sted til alt, du tænker, gemmer og planlægger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ήρεμο μέρος για όλα όσα σκέφτεστε, κρατάτε και σχεδιάζετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lugar tranquilo para todo lo que piensas, guardas y planificas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahulik koht kõigele, mida mõtled, hoiad ja kavandad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauhallinen paikka kaikelle, mitä ajattelet, säilytät ja suunnittelet."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Áit shocair do gach rud a smaoiníonn tú, a choinníonn tú agus a phleanálann tú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirno mjesto za sve što mislite, čuvate i planirate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodt hely mindenhez, amit gondol, megőriz és tervez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un posto tranquillo per tutto ciò che pensi, conservi e pianifichi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rami vieta viskam, ką galvojate, saugote ir planuojate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierīga vieta visam, ko domājat, glabājat un plānojat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Post kalm għal kull ma taħseb, iżżomm u tippjana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojne miejsce na wszystko, co myślisz, zachowujesz i planujesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar tranquilo para tudo o que pensa, guarda e planeia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un loc liniștit pentru tot ce gândiți, păstrați și planificați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokojné miesto pre všetko, čo si myslíte, uchovávate a plánujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miren prostor za vse, kar mislite, hranite in načrtujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugn plats för allt du tänker, sparar och planerar."
          }
        }
      }
    },
    "A client secret is saved. Enter a new secret only to change it, or clear both fields to remove Cloudflare Access headers.": {
      "comment": "Cloudflare Access secret hint",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Client-Secret ist gesichert. Gib nur ein neues Secret ein, um es zu ändern, oder leere beide Felder, um die Cloudflare Access-Header zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secret client est enregistré. Saisissez un nouveau secret uniquement pour le modifier, ou videz les deux champs pour supprimer les en-têtes Cloudflare Access."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een clientgeheim bewaard. Voer alleen een nieuw geheim in om het te wijzigen, of wis beide velden om de Cloudflare Access-headers te verwijderen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Има запазена клиентска тайна. Въведете нова тайна само за да я смените или изчистете двете полета, за да премахнете заглавките на Cloudflare Access."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajný klíč klienta je uložen. Nový zadejte jen pro jeho změnu, nebo obě pole vymažte pro odebrání hlaviček Cloudflare Access."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er gemt en klienthemmelighed. Indtast kun en ny hemmelighed for at ændre den, eller ryd begge felter for at fjerne Cloudflare Access-headere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει αποθηκευτεί ένα μυστικό πελάτη. Εισαγάγετε νέο μυστικό μόνο για να το αλλάξετε ή αδειάστε και τα δύο πεδία για να αφαιρέσετε τις κεφαλίδες Cloudflare Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un secreto de cliente guardado. Introduce uno nuevo solo para cambiarlo, o vacía ambos campos para eliminar las cabeceras de Cloudflare Access."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliendi salasõna on salvestatud. Sisesta uus salasõna ainult selle muutmiseks või tühjenda mõlemad väljad, et eemaldada Cloudflare Accessi päised."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakassalaisuus on tallennettu. Syötä uusi salaisuus vain, jos haluat vaihtaa sen, tai tyhjennä molemmat kentät poistaaksesi Cloudflare Access ‑otsakkeet."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá rún cliaint sábháilte. Ná cuir isteach rún nua ach chun é a athrú, nó glan an dá réimse chun ceanntásca Cloudflare Access a bhaint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajna klijenta je spremljena. Unesite novu tajnu samo ako je želite promijeniti ili ispraznite oba polja da biste uklonili zaglavlja za Cloudflare Access."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy klienstitok már el van mentve. Csak akkor adjon meg új titkot, ha módosítani szeretné, vagy törölje mindkét mezőt a Cloudflare Access-fejlécek eltávolításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È salvato un client secret. Inserisci un nuovo secret solo per cambiarlo, oppure svuota entrambi i campi per rimuovere le intestazioni di Cloudflare Access."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliento slaptasis raktas išsaugotas. Naują įveskite tik norėdami jį pakeisti arba išvalykite abu laukus, kad pašalintumėte Cloudflare Access antraštes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klienta noslēpums ir saglabāts. Ievadiet jaunu noslēpumu tikai tad, ja vēlaties to mainīt, vai notīriet abus laukus, lai noņemtu Cloudflare Access galvenes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigriet tal-klijent huwa salvat. Daħħal sigriet ġdid biss biex tibdlu, jew battal iż-żewġ oqsma biex tneħħi l-headers ta’ Cloudflare Access."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz tajny klienta jest już zachowany. Wprowadź nowy tylko, aby go zmienić, lub wyczyść oba pola, aby usunąć nagłówki Cloudflare Access."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um segredo do cliente guardado. Introduza um novo segredo apenas para o alterar ou limpe ambos os campos para remover os cabeçalhos do Cloudflare Access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secret de client este salvat. Introduceți un secret nou doar pentru a-l schimba sau goliți ambele câmpuri pentru a elimina antetele Cloudflare Access."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajný kľúč klienta je uložený. Nový zadajte len na jeho zmenu alebo obe polia vymažte na odstránenie hlavičiek Cloudflare Access."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivnost odjemalca je shranjena. Novo vnesite le, če jo želite spremeniti, ali počistite obe polji, da odstranite glave Cloudflare Access."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En klienthemlighet är sparad. Ange en ny hemlighet endast för att ändra den, eller töm båda fälten för att ta bort Cloudflare Access-headers."
          }
        }
      }
    },
    "A native iPhone, iPad and Mac app for Trilium Notes, the open-source knowledge base you host yourself. Your notes stay on your own server; the app keeps a copy on the device so you can read and write offline, and syncs when you are back online.": {
      "comment": "About page introduction",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine native iPhone-, iPad- und Mac-App für Trilium Notes, die Open-Source-Wissensdatenbank, die du selbst hostest. Deine Notizen bleiben auf deinem eigenen Server; die App behält eine Kopie auf dem Gerät, damit du offline lesen und schreiben kannst, und synchronisiert, sobald du wieder online bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app native pour iPhone, iPad et Mac destinée à Trilium Notes, la base de connaissances open source que vous hébergez vous-même. Vos notes restent sur votre propre serveur ; l’app en conserve une copie sur l’appareil pour que vous puissiez lire et écrire hors ligne, et synchronise dès que vous êtes de nouveau en ligne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een native iPhone-, iPad- en Mac-app voor Trilium Notes, de opensource-kennisbank die je zelf host. Je notities blijven op je eigen server; de app bewaart een kopie op het apparaat zodat je offline kunt lezen en schrijven, en synchroniseert zodra je weer online bent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативно приложение за iPhone, iPad и Mac за Trilium Notes – базата знания с отворен код, която хоствате сами. Бележките ви остават на вашия собствен сървър; приложението пази копие на устройството, за да можете да четете и пишете офлайн, и синхронизира, когато отново сте онлайн."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativní aplikace pro iPhone, iPad a Mac pro Trilium Notes, open-source znalostní bázi, kterou si hostujete sami. Vaše poznámky zůstávají na vašem vlastním serveru; aplikace uchovává kopii v zařízení, takže můžete číst a psát offline, a synchronizuje se, jakmile jste opět online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En indbygget iPhone-, iPad- og Mac-app til Trilium Notes, den open source-vidensbase, du selv hoster. Dine noter forbliver på din egen server; appen gemmer en kopi på enheden, så du kan læse og skrive offline, og synkroniserer, når du er online igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια εγγενής εφαρμογή για iPhone, iPad και Mac για το Trilium Notes, τη βάση γνώσεων ανοιχτού κώδικα που φιλοξενείτε μόνοι σας. Οι σημειώσεις σας μένουν στον δικό σας διακομιστή· η εφαρμογή κρατά ένα αντίγραφο στη συσκευή ώστε να διαβάζετε και να γράφετε εκτός σύνδεσης, και συγχρονίζει όταν συνδεθείτε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app nativa para iPhone, iPad y Mac para Trilium Notes, la base de conocimiento de código abierto que alojas tú mismo. Tus notas se quedan en tu propio servidor; la app guarda una copia en el dispositivo para que puedas leer y escribir sin conexión, y sincroniza cuando vuelves a estar en línea."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Natiivne iPhone’i, iPadi ja Maci rakendus Trilium Notesi jaoks – avatud lähtekoodiga teadmusbaasi jaoks, mida majutad ise. Sinu märkmed jäävad sinu enda serverisse; rakendus hoiab seadmes koopiat, et saaksid lugeda ja kirjutada võrguühenduseta, ning sünkroonib, kui oled taas võrgus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Natiivi iPhone-, iPad- ja Mac-sovellus Trilium Notesille, avoimen lähdekoodin tietokannalle, jota ylläpidät itse. Muistiinpanosi pysyvät omalla palvelimellasi; sovellus säilyttää kopion laitteessa, joten voit lukea ja kirjoittaa offline-tilassa, ja synkronoi, kun olet taas verkossa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Aip dhúchasach iPhone, iPad agus Mac do Trilium Notes, an bonn eolais foinse oscailte a óstálann tú féin. Fanann do nótaí ar do fhreastalaí féin; coinníonn an aip cóip ar an ngléas ionas gur féidir leat léamh agus scríobh as líne, agus sioncrónaíonn sí nuair a bhíonn tú ar líne arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorna aplikacija za iPhone, iPad i Mac za Trilium Notes, bazu znanja otvorenog koda koju sami hostate. Vaše bilješke ostaju na vašem poslužitelju; aplikacija čuva kopiju na uređaju kako biste mogli čitati i pisati izvan mreže te sinkronizira kad ste ponovno na mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Natív iPhone-, iPad- és Mac-alkalmazás a Trilium Notes nevű, saját üzemeltetésű, nyílt forráskódú tudásbázishoz. Jegyzetei a saját szerverén maradnak; az alkalmazás másolatot tárol róluk az eszközön, így offline is olvashat és írhat, és szinkronizál, amikor újra online lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app nativa per iPhone, iPad e Mac per Trilium Notes, la knowledge base open source che ospiti tu stesso. Le note restano sul tuo server; l’app ne conserva una copia sul dispositivo, così puoi leggere e scrivere offline, e sincronizza quando torni online."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietinė iPhone, iPad ir Mac programa, skirta Trilium Notes – atvirojo kodo žinių bazei, kurią talpinate patys. Jūsų pastabos lieka jūsų serveryje; programa saugo kopiją įrenginyje, kad galėtumėte skaityti ir rašyti neprisijungę, ir sinchronizuoja, kai vėl prisijungiate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietējā iPhone, iPad un Mac lietotne Trilium Notes — atvērtā koda zināšanu bāzei, ko mitināt pats. Jūsu piezīmes paliek jūsu serverī; lietotne glabā kopiju ierīcē, lai varētu lasīt un rakstīt bezsaistē, un sinhronizē, kad atkal esat tiešsaistē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "App nattiva għal iPhone, iPad u Mac għal Trilium Notes, il-bażi tal-għarfien open-source li tospita int stess. In-noti tiegħek jibqgħu fuq is-server tiegħek; l-app iżżomm kopja fuq l-apparat biex tkun tista’ taqra u tikteb offline, u tissinkronizza meta terġa’ tkun online."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natywna aplikacja na iPhone’a, iPada i Maca dla Trilium Notes – bazy wiedzy open source, którą hostujesz samodzielnie. Twoje notatki pozostają na Twoim serwerze; aplikacja przechowuje ich kopię na urządzeniu, więc możesz czytać i pisać offline, a po powrocie do sieci wszystko się synchronizuje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma app nativa para iPhone, iPad e Mac para o Trilium Notes, a base de conhecimento open source que aloja por si. As suas notas ficam no seu próprio servidor; a app guarda uma cópia no dispositivo para que possa ler e escrever offline e sincroniza quando voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicație nativă pentru iPhone, iPad și Mac pentru Trilium Notes, baza de cunoștințe open-source pe care o găzduiți singur. Notițele rămân pe propriul server; aplicația păstrează o copie pe dispozitiv, ca să puteți citi și scrie offline, și sincronizează când reveniți online."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natívna aplikácia pre iPhone, iPad a Mac pre Trilium Notes, open-source znalostnú bázu, ktorú si hostujete sami. Vaše poznámky zostávajú na vašom vlastnom serveri; aplikácia uchováva kópiu v zariadení, takže môžete čítať a písať offline, a synchronizuje sa, keď ste opäť online."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorna aplikacija za iPhone, iPad in Mac za Trilium Notes, odprtokodno zbirko znanja, ki jo gostite sami. Vaše beležke ostanejo na vašem strežniku; aplikacija hrani kopijo v napravi, da lahko berete in pišete brez povezave, ko ste spet povezani, pa jih sinhronizira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En inbyggd iPhone-, iPad- och Mac-app för Trilium Notes, kunskapsbasen med öppen källkod som du själv driftar. Dina anteckningar stannar på din egen server; appen sparar en kopia på enheten så att du kan läsa och skriva offline, och synkroniserar när du är online igen."
          }
        }
      }
    },
    "A note cannot be moved under itself.": {
      "comment": "Move validation",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نقل الملاحظة لتصبح تحت نفسها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku nelze přesunout pod sebe samu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz kann nicht unter sich selbst verschoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note cannot be moved under itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota no se puede mover dentro de sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note ne peut pas être déplacée sous elle-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नोट को स्वयं के अंतर्गत नहीं ले जा सकते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy jegyzet nem helyezhető át saját maga alá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota non può essere spostata sotto se stessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een notitie kan niet onder zichzelf worden geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki nie można przenieść pod nią samą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметку нельзя переместить под саму себя."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележка не може да бъде преместена под самата себе си."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En note kan ikke flyttes ind under sig selv."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια σημείωση δεν μπορεί να μετακινηθεί κάτω από τον εαυτό της."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märget ei saa teisaldada iseenda alla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoa ei voi siirtää itsensä alle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir nóta a bhogadh faoi féin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješka se ne može premjestiti ispod same sebe."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastabos negalima perkelti po ja pačia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezīmi nevar pārvietot zem tās pašas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota ma tistax titmexxa taħt lilha nnifisha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nota não pode ser movida para dentro de si própria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notiță nu poate fi mutată sub ea însăși."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku nie je možné presunúť pod seba samu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beležke ni mogoče premakniti podse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En anteckning kan inte flyttas under sig själv."
          }
        }
      }
    },
