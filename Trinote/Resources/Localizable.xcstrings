    "Move or delete cards in this column before deleting it.": {
      "comment": "Kanban delete non-empty column",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege oder lösche die Karten in dieser Spalte, bevor du sie löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ou supprimez les cartes de cette colonne avant de la supprimer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats of verwijder de kaarten in deze kolom voordat je de kolom verwijdert."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преместете или изтрийте картите в тази колона, преди да я изтриете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před smazáním tohoto sloupce v něm karty přesuňte nebo smažte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt eller slet kortene i denne kolonne, før du sletter den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήστε ή διαγράψτε τις κάρτες αυτής της στήλης πριν τη διαγράψετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve o elimina las tarjetas de esta columna antes de eliminarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enne selle veeru kustutamist teisalda või kustuta selle kaardid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä tai poista tämän sarakkeen kortit ennen sen poistamista."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bog nó scrios na cártaí sa cholún seo sula scriosann tú é."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premjestite ili obrišite kartice u ovom stupcu prije nego što ga obrišete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oszlop törlése előtt helyezze át vagy törölje a benne lévő kártyákat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta o elimina le schede di questa colonna prima di eliminarla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš ištrindami stulpelį, perkelkite arba ištrinkite jame esančias korteles."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms kolonnas dzēšanas pārvietojiet vai izdzēsiet tajā esošās kārtis."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexxi jew ħassar il-kards f’din il-kolonna qabel tħassarha."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś lub usuń karty w tej kolumnie, zanim ją usuniesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova ou apague os cartões desta coluna antes de a apagar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutați sau ștergeți cardurile din această coloană înainte de a o șterge."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred vymazaním tohto stĺpca v ňom karty presuňte alebo vymažte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred brisanjem stolpca premaknite ali izbrišite kartice v njem."
          }
        },
        "sv": {
