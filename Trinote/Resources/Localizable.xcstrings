            "value": "Anteckningar sparas endast på den här enheten."
          }
        }
      }
    },
    "Notes edited on any device appear here after a sync.": {
      "comment": "Recents: edited segment empty hint",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem beliebigen Gerät bearbeitete Notizen erscheinen hier nach einer Synchronisierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes modifiées sur n’importe quel appareil apparaissent ici après une synchronisation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities die op een apparaat zijn gewijzigd, verschijnen hier na een synchronisatie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележките, редактирани на което и да е устройство, се появяват тук след синхронизация."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky upravené na kterémkoli zařízení se zde zobrazí po synchronizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter, der er redigeret på en hvilken som helst enhed, vises her efter en synkronisering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις που επεξεργάζεστε σε οποιαδήποτε συσκευή εμφανίζονται εδώ μετά από συγχρονισμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas editadas en cualquier dispositivo aparecen aquí tras sincronizar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis tahes seadmes muudetud märkmed kuvatakse siin pärast sünkroonimist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
