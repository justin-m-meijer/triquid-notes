    "The page beside the menu on iPad, Mac and an unfolded iPhone Duo, while no note is open. Drag to change the order.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite neben dem Menü auf iPad, Mac und einem aufgeklappten iPhone Duo, solange keine Notiz geöffnet ist. Ziehe, um die Reihenfolge zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page à côté du menu sur iPad, Mac et un iPhone Duo déplié, tant qu’aucune note n’est ouverte. Faites glisser pour changer l’ordre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pagina naast het menu op iPad, Mac en een opengevouwen iPhone Duo, zolang er geen notitie open is. Sleep om de volgorde te wijzigen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницата до менюто на iPad, Mac и разгънат iPhone Duo, когато няма отворена бележка. Плъзнете, за да промените реда."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stránka vedle nabídky na iPadu, Macu a rozloženém iPhonu Duo, když není otevřena žádná poznámka. Pořadí změníte přetažením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden ved siden af menuen på iPad, Mac og en udfoldet iPhone Duo, mens der ikke er nogen note åben. Træk for at ændre rækkefølgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σελίδα δίπλα στο μενού σε iPad, Mac και ξεδιπλωμένο iPhone Duo, όταν δεν είναι ανοιχτή καμία σημείωση. Σύρετε για να αλλάξετε τη σειρά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página junto al menú en iPad, Mac y un iPhone Duo desplegado, cuando no hay ninguna nota abierta. Arrastra para cambiar el orden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leht menüü kõrval iPadis, Macis ja lahtivolditud iPhone Duos, kui ükski märge pole avatud. Järjekorra muutmiseks lohista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivu valikon vieressä iPadissa, Macissa ja avatussa iPhone Duossa, kun mitään muistiinpanoa ei ole auki. Muuta järjestystä vetämällä."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An leathanach in aice leis an roghchlár ar iPad, Mac agus iPhone Duo oscailte, nuair nach bhfuil aon nóta oscailte. Tarraing chun an t-ord a athrú."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranica pokraj izbornika na iPadu, Macu i rasklopljenom iPhoneu Duo kad nijedna bilješka nije otvorena. Povucite za promjenu redoslijeda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A menü melletti oldal iPaden, Macen és kihajtott iPhone Duón, amikor nincs megnyitva jegyzet. A sorrend húzással módosítható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina accanto al menu su iPad, Mac e iPhone Duo aperto, quando non è aperta nessuna nota. Trascina per cambiare l’ordine."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Puslapis šalia meniu iPad, Mac ir atlenktame iPhone Duo, kai neatidaryta jokia pastaba. Vilkite, kad pakeistumėte tvarką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapa blakus izvēlnei iPad, Mac un atlocītā iPhone Duo ierīcē, kamēr nav atvērta neviena piezīme. Velciet, lai mainītu secību."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-paġna ħdejn il-menu fuq iPad, Mac u iPhone Duo miftuħ, meta l-ebda nota ma tkun miftuħa. Kaxkar biex tibdel l-ordni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona obok menu na iPadzie, Macu i rozłożonym iPhonie Duo, gdy nie jest otwarta żadna notatka. Przeciągnij, aby zmienić kolejność."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A página ao lado do menu no iPad, no Mac e num iPhone Duo aberto, quando nenhuma nota está aberta. Arraste para alterar a ordem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina de lângă meniu pe iPad, Mac și iPhone Duo desfăcut, când nu este deschisă nicio notiță. Trageți pentru a schimba ordinea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stránka vedľa ponuky na iPade, Macu a rozloženom iPhone Duo, keď nie je otvorená žiadna poznámka. Poradie zmeníte presunutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stran ob meniju v iPadu, Macu in razprtem iPhonu Duo, ko ni odprta nobena beležka. Povlecite, da spremenite vrstni red."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidan bredvid menyn på iPad, Mac och en utvikt iPhone Duo när ingen anteckning är öppen. Dra för att ändra ordningen."
          }
        }
      }
    },
    "The page has no readable article yet. Accept the cookie notice or wait until the page has loaded.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite hat noch keinen lesbaren Artikel. Akzeptiere den Cookie-Hinweis oder warte, bis die Seite geladen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page n’a pas encore d’article lisible. Acceptez l’avis de cookies ou attendez que la page soit chargée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pagina heeft nog geen leesbaar artikel. Accepteer de cookiemelding of wacht tot de pagina geladen is."
