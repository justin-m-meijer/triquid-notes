    "Hide Save Button removes the floating save button. To close the editor, use Save in the ⋯ menu or tap Back.": {
      "comment": "Settings footer: Hide Save Button",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل خيار إخفاء زر الحفظ زر الحفظ العائم. لإغلاق المحرر، استخدم «حفظ» في القائمة ⋯ أو اضغط على رجوع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt tlačítko Uložit odstraní plovoucí tlačítko pro uložení. Editor zavřete volbou Uložit v nabídce ⋯ nebo klepnutím na Zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sichern-Taste ausblenden“ entfernt die schwebende Sichern-Taste. Um den Editor zu schließen, verwende „Sichern“ im Menü ⋯ oder tippe auf „Zurück“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Save Button removes the floating save button. To close the editor, use Save in the ⋯ menu or tap Back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ocultar botón Guardar» quita el botón flotante de guardar. Para cerrar el editor, usa Guardar en el menú ⋯ o toca Atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Masquer le bouton Enregistrer » supprime le bouton Enregistrer flottant. Pour fermer l’éditeur, utilisez Enregistrer dans le menu ⋯ ou touchez Retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजें बटन छिपाएँ तैरते हुए सहेजें बटन को हटा देता है। संपादक बंद करने के लिए ⋯ मेनू में सहेजें का उपयोग करें या वापस पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Mentés gomb elrejtése” eltávolítja a lebegő mentés gombot. A szerkesztő bezárásához használja a ⋯ menü Mentés parancsát, vagy koppintson a Vissza gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nascondi pulsante Salva” rimuove il pulsante Salva mobile. Per chiudere l’editor, usa Salva nel menu ⋯ o tocca Indietro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg bewaarknop verwijdert de zwevende bewaarknop. Gebruik Bewaar in het ⋯-menu of tik op Terug om de editor te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Ukryj przycisk Zachowaj” usuwa pływający przycisk zachowywania. Aby zamknąć edytor, użyj polecenia Zachowaj w menu ⋯ lub stuknij Wstecz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скрыть кнопку „Сохранить“» убирает плавающую кнопку сохранения. Чтобы закрыть редактор, выберите «Сохранить» в меню ⋯ или нажмите «Назад»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Скрий бутона Запази“ премахва плаващия бутон за запазване. За да затворите редактора, използвайте Запази в менюто ⋯ или докоснете Назад."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul knappen Gem fjerner den flydende knap Gem. Brug Gem i menuen ⋯, eller tryk på Tilbage for at lukke editoren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Απόκρυψη κουμπιού αποθήκευσης» αφαιρεί το αιωρούμενο κουμπί αποθήκευσης. Για να κλείσετε το πρόγραμμα επεξεργασίας, χρησιμοποιήστε «Αποθήκευση» στο μενού ⋯ ή αγγίξτε «Πίσω»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peida salvestusnupp eemaldab hõljuva salvestusnupu. Redaktori sulgemiseks kasuta menüüs ⋯ käsku Salvesta või puuduta Tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota tallennuspainike poistaa kelluvan tallennuspainikkeen. Sulje editori valitsemalla ⋯-valikosta Tallenna tai napauttamalla Takaisin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Baineann “Folaigh an Cnaipe Sábhála” an cnaipe sábhála snámhach. Chun an t-eagarthóir a dhúnadh, úsáid Sábháil sa roghchlár ⋯ nó tapáil Siar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sakrij tipku Spremi” uklanja plutajuću tipku za spremanje. Da biste zatvorili uređivač, upotrijebite Spremi u izborniku ⋯ ili dodirnite Natrag."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus parinktį „Slėpti išsaugojimo mygtuką“, slankusis išsaugojimo mygtukas pašalinamas. Norėdami uždaryti redaktorių, meniu ⋯ pasirinkite „Išsaugoti“ arba bakstelėkite „Atgal“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcija Paslēpt pogu Saglabāt noņem peldošo saglabāšanas pogu. Lai aizvērtu redaktoru, izmantojiet Saglabāt izvēlnē ⋯ vai pieskarieties Atpakaļ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Aħbi l-Buttuna Salva” tneħħi l-buttuna salva li tinsab f’wiċċ l-iskrin. Biex tagħlaq l-editur, uża Salva fil-menu ⋯ jew agħfas Lura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ocultar botão Guardar» remove o botão flutuante para guardar. Para fechar o editor, use Guardar no menu ⋯ ou toque em Voltar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ascunde butonul Salvează” elimină butonul flotant de salvare. Pentru a închide editorul, folosiți Salvează din meniul ⋯ sau apăsați Înapoi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryť tlačidlo Uložiť odstráni plávajúce tlačidlo na uloženie. Editor zatvoríte voľbou Uložiť v ponuke ⋯ alebo klepnutím na Späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnost Skrij gumb Shrani odstrani plavajoči gumb za shranjevanje. Urejevalnik zaprete z ukazom Shrani v meniju ⋯ ali tako, da tapnete Nazaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Göm Spara-knappen tar bort den flytande Spara-knappen. Stäng redigeraren med Spara i menyn ⋯ eller genom att trycka på Tillbaka."
          }
        }
      }
    },
