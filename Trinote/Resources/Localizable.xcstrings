          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa ulos ja poistaa tämän palvelimen välimuistin muistiinpanot ja tallennetun istunnon tästä laitteesta. Palvelimella olevia tietoja ei poisteta."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Síníonn sé seo amach agus baineann sé nótaí sa taisce agus seisiún sábháilte an fhreastalaí seo den ghléas seo. Ní scriostar sonraí ar an bhfreastalaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se odjavljujete i s ovog se uređaja uklanjaju predmemorirane bilješke i spremljena sesija ovog poslužitelja. Podaci na poslužitelju ne brišu se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel kijelentkezik, és a szerver gyorsítótárazott jegyzetei és mentett munkamenete törlődik erről az eszközről. A szerveren lévő adatok nem törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà effettuata l’uscita e verranno rimosse da questo dispositivo le note in cache e la sessione salvata di questo server. I dati sul server non vengono eliminati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Būsite atjungti, o iš šio įrenginio bus pašalintos šio serverio talpykloje esančios pastabos ir išsaugotas seansas. Serveryje esantys duomenys neištrinami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs tiekat izrakstīts, un no šīs ierīces tiek noņemtas šī servera kešotās piezīmes un saglabātā sesija. Dati serverī netiek dzēsti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan joħroġ u jneħħi n-noti fil-cache u s-sessjoni salvata ta’ dan is-server minn dan l-apparat. Id-data fuq is-server ma titħassarx."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wylogowanie i usunięcie notatek tego serwera z pamięci podręcznej oraz zachowanej sesji z tego urządzenia. Dane na serwerze nie zostaną usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto termina a sessão e remove deste dispositivo as notas em cache e a sessão guardada deste servidor. Os dados no servidor não são apagados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune vă deconectează și elimină de pe acest dispozitiv notițele din cache și sesiunea salvată ale acestui server. Datele de pe server nu sunt șterse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa odhlásite a z tohto zariadenia sa odstránia poznámky tohto servera vo vyrovnávacej pamäti a uložená relácia. Dáta na serveri sa nevymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem se odjavite ter iz te naprave odstranite predpomnjene beležke in shranjeno sejo tega strežnika. Podatki na strežniku ne bodo izbrisani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta loggar ut och tar bort serverns cachelagrade anteckningar och sparade session från den här enheten. Data på servern raderas inte."
          }
        }
      }
    },
